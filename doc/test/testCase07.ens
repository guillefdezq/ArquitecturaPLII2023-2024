; Quadruple - [MV T_14, dia, null]
MOVE #-6[.IX], #-21[.IX]
; Quadruple - [INL L_11, null, null]
L_11: NOP

; Quadruple - [CMP T_14, 2, null]
CMP #-21[.IX], #2

; Quadruple - [BNZ L_12, null, null]
