; Quadruple - [VARLOCAL a, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [VARLOCAL b, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [VARLOCAL dia, 0, null]
MOVE #0, #-6[.IX]
; Quadruple - [MV T_0, 2, null]
MOVE #2, #-7[.IX]
; Quadruple - [MV a, T_0, null]
MOVE #-7[.IX], #-4[.IX]
; Quadruple - [MV T_1, 2, null]
MOVE #2, #-8[.IX]
; Quadruple - [MV b, T_1, null]
MOVE #-8[.IX], #-5[.IX]
; Quadruple - [MV T_2, a, null]
MOVE #-4[.IX], #-9[.IX]
; Quadruple - [MV T_3, b, null]
MOVE #-5[.IX], #-10[.IX]
; Quadruple - [EQ T_4, T_2, T_3]
CMP #-9[.IX], #-10[.IX]
BZ /L_13
BNZ /L_14
L_13: MOVE #1, #-11[.IX]
BR /L_15
L_14: MOVE #0, #-11[.IX]
L_15: NOP

; Quadruple - [BRF T_4, L_3, null]
CMP #-11[.IX], #0
BZ /L_3

; Quadruple - [WRSTR T_0, L_0, null]
WRSTR /L_0 

; Quadruple - [BR L_2, null, null]
BR /L_2

; Quadruple - [INL L_3, null, null]
L_3: NOP

; Quadruple - [WRSTR T_0, L_1, null]
WRSTR /L_1 

; Quadruple - [INL L_2, null, null]
L_2: NOP

; Quadruple - [WRSTR T_5, L_4, null]
WRSTR /L_4 

; Quadruple - [DVLP Mientras, Inicio, null]
; sin declarar?

; Quadruple - [INL L_5, null, null]
L_5: NOP

; Quadruple - [MV T_6, a, null]
MOVE #-4[.IX], #-13[.IX]
; Quadruple - [MV T_7, 5, null]
MOVE #5, #-14[.IX]
; Quadruple - [LS T_8, T_6, T_7]
CMP #-13[.IX], #-14[.IX]
BNZ /L_16
BN /L_16
BZ /L_17
BP /L_17
L_16: MOVE #1, #-15[.IX]
BR /L_18
L_17: MOVE #0, #-15[.IX]
L_18: NOP

; Quadruple - [BRF T_8, L_6, null]
CMP #-15[.IX], #0
BZ /L_6

; Quadruple - [MV T_9, a, null]
MOVE #-4[.IX], #-16[.IX]
; Quadruple - [MV T_10, 1, null]
MOVE #1, #-17[.IX]
; Quadruple - [ADD T_11, T_9, T_10]
ADD #-16[.IX], #-17[.IX]
MOVE .A , #-18[.IX]

; Quadruple - [MV a, T_11, null]
MOVE #-18[.IX], #-4[.IX]
; Quadruple - [BR L_5, null, null]
BR /L_5

; Quadruple - [INL L_6, null, null]
L_6: NOP

; Quadruple - [DVLP Mientras, Final, null]
; sin declarar?

; Quadruple - [WRSTR T_12, L_7, null]
WRSTR /L_7 

; Quadruple - [MV T_13, 2, null]
MOVE #2, #-20[.IX]
