; Quadruple - [WRSTR T_0, L_9, null]
WRSTR /L_9 

; Quadruple - [BR L_10, null, null]
BR /L_10

; Quadruple - [INL L_12, null, null]
L_12: NOP

; Quadruple - [CMP T_14, 1, null]
CMP #-21[.IX], #1

; Quadruple - [BNZ L_10, null, null]
