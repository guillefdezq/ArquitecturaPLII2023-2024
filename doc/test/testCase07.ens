; Quadruple - [MV T_6, a, null]
MOVE #-7[.IX], #-16[.IX]
; Quadruple - [MV T_7, 5, null]
MOVE #5, #-17[.IX]
; Quadruple - [LS T_8, T_6, T_7]
CMP #-16[.IX], #-17[.IX]
BZ /L_19
BP /L_19
L_18: MOVE #1, #-18[.IX]
BR /L_20
L_19: MOVE #0, #-18[.IX]
L_20: NOP

; Quadruple - [BRF T_8, L_6, null]
