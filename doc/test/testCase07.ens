; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_13, 20, null]
SUB .IX, #20
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [VARLOCAL b, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [VARLOCAL dia, 0, null]
MOVE #0, #-6[.IX]
; Quadruple - [MV T_0, 2, null]
MOVE #2, #-7[.IX]
; Quadruple - [MV a, T_0, null]
MOVE #-7[.IX], #-4[.IX]
; Quadruple - [MV T_1, 2, null]
MOVE #2, #-8[.IX]
; Quadruple - [MV b, T_1, null]
MOVE #-8[.IX], #-5[.IX]
; Quadruple - [MV T_2, a, null]
MOVE #-4[.IX], #-9[.IX]
; Quadruple - [MV T_3, b, null]
MOVE #-5[.IX], #-10[.IX]
; Quadruple - [EQ T_4, T_2, T_3]
CMP #-9[.IX], #-10[.IX]
BZ /L_15
BNZ /L_16
L_15: MOVE #1, #-11[.IX]
BR /L_17
L_16: MOVE #0, #-11[.IX]
L_17: NOP

; Quadruple - [BZ T_4, L_3, null]
CMP #-11[.IX], #0
BZ /L_3

; Quadruple - [WRSTR L_0, null, null]
WRSTR /L_0 

; Quadruple - [BR L_2, null, null]
BR /L_2

; Quadruple - [INL L_3, null, null]
L_3: NOP

; Quadruple - [WRSTR L_1, null, null]
WRSTR /L_1 

; Quadruple - [INL L_2, null, null]
L_2: NOP

; Quadruple - [WRSTR L_4, null, null]
WRSTR /L_4 

; Quadruple - [INL L_5, null, null]
L_5: NOP

; Quadruple - [MV T_5, a, null]
MOVE #-4[.IX], #-12[.IX]
; Quadruple - [MV T_6, 5, null]
MOVE #5, #-13[.IX]
; Quadruple - [LS T_7, T_5, T_6]
CMP #-12[.IX], #-13[.IX]
BZ /L_19
BP /L_19
L_18: MOVE #1, #-14[.IX]
BR /L_20
L_19: MOVE #0, #-14[.IX]
L_20: NOP

; Quadruple - [BZ T_7, L_6, null]
CMP #-14[.IX], #0
BZ /L_6

; Quadruple - [MV T_8, a, null]
MOVE #-4[.IX], #-15[.IX]
; Quadruple - [MV T_9, 1, null]
MOVE #1, #-16[.IX]
; Quadruple - [ADD T_10, T_8, T_9]
ADD #-15[.IX], #-16[.IX]
MOVE .A , #-17[.IX]

; Quadruple - [MV a, T_10, null]
MOVE #-17[.IX], #-4[.IX]
; Quadruple - [BR L_5, null, null]
BR /L_5

; Quadruple - [INL L_6, null, null]
L_6: NOP

; Quadruple - [WRSTR L_7, null, null]
WRSTR /L_7 

; Quadruple - [MV T_11, 2, null]
MOVE #2, #-18[.IX]
; Quadruple - [MV dia, T_11, null]
MOVE #-18[.IX], #-6[.IX]
; Quadruple - [MV T_12, dia, null]
MOVE #-6[.IX], #-19[.IX]
; Quadruple - [INL L_11, null, null]
L_11: NOP

; Quadruple - [CMP T_12, 2, null]
CMP #-19[.IX], #2

; Quadruple - [BNZ L_12, null, null]
BNZ /L_12

; Quadruple - [WRSTR L_9, null, null]
WRSTR /L_9 

; Quadruple - [BR L_10, null, null]
BR /L_10

; Quadruple - [INL L_12, null, null]
L_12: NOP

; Quadruple - [CMP T_12, 1, null]
CMP #-19[.IX], #1

; Quadruple - [BNZ L_10, null, null]
BNZ /L_10

; Quadruple - [WRSTR L_8, null, null]
WRSTR /L_8 

; Quadruple - [BR L_10, null, null]
BR /L_10

; Quadruple - [INL L_10, null, null]
L_10: NOP

; Quadruple - [DEVUELTO L_FIN_FUN_1, null, null]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_FUN_1, null, null]
L_FIN_FUN_1: HALT

; Quadruple - [CADENA si bien\n, L_0, null]
L_0: DATA "si bien\n"
; Quadruple - [CADENA si mal\n, L_1, null]
L_1: DATA "si mal\n"
; Quadruple - [CADENA  mientras\n, L_4, null]
L_4: DATA " mientras\n"
; Quadruple - [CADENA  alternativas\n, L_7, null]
L_7: DATA " alternativas\n"
; Quadruple - [CADENA lunes\n, L_8, null]
L_8: DATA "lunes\n"
; Quadruple - [CADENA martes\n, L_9, null]
L_9: DATA "martes\n"
