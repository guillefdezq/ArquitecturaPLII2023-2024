; Quadruple - [MV T_10, 1, null]
MOVE #1, #-20[.IX]
; Quadruple - [ADD T_11, T_9, T_10]
ADD #-19[.IX], #-20[.IX]
MOVE .A , #-21[.IX]

; Quadruple - [MV a, T_11, null]
MOVE #-21[.IX], #-7[.IX]
; Quadruple - [BR L_5, null, null]
