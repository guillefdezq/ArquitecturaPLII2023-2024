MOVE #-11[.IX], #-8[.IX]
; Quadruple - [MV T_2, a, null]
MOVE #-7[.IX], #-12[.IX]
; Quadruple - [MV T_3, b, null]
MOVE #-8[.IX], #-13[.IX]
; Quadruple - [EQ T_4, T_2, T_3]
CMP #-12[.IX], #-13[.IX]
BZ /L_15
BNZ /L_16
L_15: MOVE #1, #-14[.IX]
BR /L_17
L_16: MOVE #0, #-14[.IX]
L_17: NOP

; Quadruple - [BRF T_4, L_3, null]
CMP #-14[.IX], #0
BZ /L_3

; Quadruple - [WRSTR T_0, L_0, null]
