; Quadruple - [AXIOM null, null, null]
AXIOM: NOP
BR /PRINCIPAL

; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en R0
PUSH #-1       ;valor de retorno
PUSH .IX       ;enlace de control
PUSH .SR       ;estado mÃ¡quina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_16, 24, null]
SUB .IX, #24
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 0, null]
MOVE #0, #-7[.IX]
; Quadruple - [VARLOCAL b, 0, null]
MOVE #0, #-8[.IX]
; Quadruple - [VARLOCAL c, 0, null]
MOVE #0, #-9[.IX]
; Quadruple - [MV T_0, 6, null]
MOVE #6, #-10[.IX]
; Quadruple - [MV a, T_0, null]
MOVE #-10[.IX], #-7[.IX]
; Quadruple - [MV T_1, 3, null]
MOVE #3, #-11[.IX]
; Quadruple - [MV b, T_1, null]
MOVE #-11[.IX], #-8[.IX]
; Quadruple - [MV T_2, a, null]
MOVE #-7[.IX], #-12[.IX]
; Quadruple - [MV T_3, b, null]
MOVE #-8[.IX], #-13[.IX]
; Quadruple - [ADD T_4, T_2, T_3]
ADD #-12[.IX], #-13[.IX]
MOVE .A , #-14[.IX]

; Quadruple - [MV c, T_4, null]
MOVE #-14[.IX], #-9[.IX]
; Quadruple - [WRSTR T_5, L_0, null]
WRSTR /L_0 

; Quadruple - [MV T_6, c, null]
MOVE #-9[.IX], #-16[.IX]
; Quadruple - [WRINT T_6, null, null]
WRINT #-16[.IX] 
WRCHAR #10 

; Quadruple - [ADD c, c, 1]
ADD #-9[.IX], #1
MOVE .A , #-9[.IX]

; Quadruple - [WRSTR T_9, L_2, null]
WRSTR /L_2 

; Quadruple - [MV T_10, c, null]
MOVE #-9[.IX], #-20[.IX]
; Quadruple - [WRINT T_10, null, null]
WRINT #-20[.IX] 
WRCHAR #10 

; Quadruple - [MV T_12, 1, null]
MOVE #1, #-22[.IX]
; Quadruple - [ADD c, c, T_12]
ADD #-9[.IX], #-22[.IX]
MOVE .A , #-9[.IX]

; Quadruple - [WRSTR T_13, L_4, null]
WRSTR /L_4 

; Quadruple - [MV T_14, c, null]
MOVE #-9[.IX], #-24[.IX]
; Quadruple - [WRINT T_14, null, null]
WRINT #-24[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO L_FIN_FUN_1, null, null]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_FUN_1, null, null]
L_FIN_FUN_1: HALT

; Quadruple - [CADENA c es 9\n, L_0, null]
L_0: DATA "c es 9\n"
; Quadruple - [CADENA c es 10\n, L_2, null]
L_2: DATA "c es 10\n"
; Quadruple - [CADENA c es 11\n, L_4, null]
L_4: DATA "c es 11\n"
