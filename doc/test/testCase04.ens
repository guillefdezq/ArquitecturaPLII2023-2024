; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL 16, null, null]
SUB .IX, #16
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [VARLOCAL b, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [VARLOCAL c, 0, null]
MOVE #0, #-6[.IX]
; Quadruple - [MV T_0, 6, null]
MOVE #6, #-7[.IX]
; Quadruple - [MV a, T_0, null]
MOVE #-7[.IX], #-4[.IX]
; Quadruple - [MV T_1, 3, null]
MOVE #3, #-8[.IX]
; Quadruple - [MV b, T_1, null]
MOVE #-8[.IX], #-5[.IX]
; Quadruple - [MV T_2, a, null]
MOVE #-4[.IX], #-9[.IX]
; Quadruple - [MV T_3, b, null]
MOVE #-5[.IX], #-10[.IX]
; Quadruple - [ADD T_4, T_2, T_3]
ADD #-9[.IX], #-10[.IX]
MOVE .A , #-11[.IX]

; Quadruple - [MV c, T_4, null]
MOVE #-11[.IX], #-6[.IX]
; Quadruple - [WRSTR L_0, null, null]
WRSTR /L_0 

; Quadruple - [MV T_5, c, null]
MOVE #-6[.IX], #-12[.IX]
; Quadruple - [WRINT T_5, null, null]
WRINT #-12[.IX] 
WRCHAR #10 

; Quadruple - [ADD c, c, 1]
ADD #-6[.IX], #1
MOVE .A , #-6[.IX]

; Quadruple - [WRSTR L_2, null, null]
WRSTR /L_2 

; Quadruple - [MV T_6, c, null]
MOVE #-6[.IX], #-13[.IX]
; Quadruple - [WRINT T_6, null, null]
WRINT #-13[.IX] 
WRCHAR #10 

; Quadruple - [MV T_7, 1, null]
MOVE #1, #-14[.IX]
; Quadruple - [ADD c, c, T_7]
ADD #-6[.IX], #-14[.IX]
MOVE .A , #-6[.IX]

; Quadruple - [WRSTR L_4, null, null]
WRSTR /L_4 

; Quadruple - [MV T_8, c, null]
MOVE #-6[.IX], #-15[.IX]
; Quadruple - [WRINT T_8, null, null]
WRINT #-15[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO L_FIN_principal, null, null]
BR /L_FIN_principal    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_principal, null, null]
L_FIN_principal: HALT

; Quadruple - [CADENA c es 9\n, L_0, null]
L_0: DATA "c es 9\n"
; Quadruple - [CADENA c es 10\n, L_2, null]
L_2: DATA "c es 10\n"
; Quadruple - [CADENA c es 11\n, L_4, null]
L_4: DATA "c es 11\n"
