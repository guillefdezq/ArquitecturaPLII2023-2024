; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_11, 18, null]
SUB .IX, #18
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [VARLOCAL b, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [VARLOCAL c, 0, null]
MOVE #0, #-6[.IX]
; Quadruple - [MV T_0, 5, null]
MOVE #5, #-7[.IX]
; Quadruple - [MV a, T_0, null]
MOVE #-7[.IX], #-4[.IX]
; Quadruple - [MV T_1, 3, null]
MOVE #3, #-8[.IX]
; Quadruple - [MV b, T_1, null]
MOVE #-8[.IX], #-5[.IX]
; Quadruple - [MV T_2, a, null]
MOVE #-4[.IX], #-9[.IX]
; Quadruple - [MV T_3, b, null]
MOVE #-5[.IX], #-10[.IX]
; Quadruple - [LS T_4, T_2, T_3]
CMP #-9[.IX], #-10[.IX]
BZ /L_7
BP /L_7
L_6: MOVE #1, #-11[.IX]
BR /L_8
L_7: MOVE #0, #-11[.IX]
L_8: NOP

; Quadruple - [MV c, T_4, null]
MOVE #-11[.IX], #-6[.IX]
; Quadruple - [WRSTR L_0, null, null]
WRSTR /L_0 

; Quadruple - [MV T_5, c, null]
MOVE #-6[.IX], #-12[.IX]
; Quadruple - [WRINT T_5, null, null]
WRINT #-12[.IX] 
WRCHAR #10 

; Quadruple - [MV T_6, a, null]
MOVE #-4[.IX], #-13[.IX]
; Quadruple - [MV T_7, a, null]
MOVE #-4[.IX], #-14[.IX]
; Quadruple - [EQ T_8, T_6, T_7]
CMP #-13[.IX], #-14[.IX]
BZ /L_9
BNZ /L_10
L_9: MOVE #1, #-15[.IX]
BR /L_11
L_10: MOVE #0, #-15[.IX]
L_11: NOP

; Quadruple - [NEG T_9, T_8, null]
CMP #-15[.IX], #0
BZ /L_12
BNZ /L_13
L_12: MOVE #1, #-16[.IX]
BR /L_14
L_13: MOVE #0, #-16[.IX]
L_14: NOP

; Quadruple - [MV c, T_9, null]
MOVE #-16[.IX], #-6[.IX]
; Quadruple - [WRSTR L_2, null, null]
WRSTR /L_2 

; Quadruple - [MV T_10, c, null]
MOVE #-6[.IX], #-17[.IX]
; Quadruple - [WRINT T_10, null, null]
WRINT #-17[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO L_FIN_FUN_1, null, null]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_FUN_1, null, null]
L_FIN_FUN_1: HALT

; Quadruple - [CADENA c es 0\n, L_0, null]
L_0: DATA "c es 0\n"
; Quadruple - [CADENA c es 0\n, L_2, null]
L_2: DATA "c es 0\n"
