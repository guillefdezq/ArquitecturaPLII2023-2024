; Quadruple - [MV b, T_8, null]
MOVE #-25[.IX], #-8[.IX]
; Quadruple - [ADD a, a, 1]
ADD #-7[.IX], #1
MOVE .A , #-7[.IX]

; Quadruple - [BR L_9, null, null]
BR /L_9

