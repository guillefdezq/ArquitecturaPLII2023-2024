MOVE #-8[.IX], #-4[.IX]
; Quadruple - [MV T_1, 5, null]
MOVE #5, #-9[.IX]
; Quadruple - [MV b, T_1, null]
MOVE #-9[.IX], #-5[.IX]
; Quadruple - [MV T_2, 1, null]
MOVE #1, #-10[.IX]
; Quadruple - [MV uno, T_2, null]
MOVE #-10[.IX], #-6[.IX]
; Quadruple - [DVLP Mientras, Inicio, null]
; sin declarar?

; Quadruple - [INL L_9, null, null]
L_9: NOP

; Quadruple - [MV T_3, a, null]
MOVE #-4[.IX], #-11[.IX]
; Quadruple - [MV T_4, 5, null]
MOVE #5, #-12[.IX]
; Quadruple - [LS T_5, T_3, T_4]
CMP #-11[.IX], #-12[.IX]
BZ /L_16
BP /L_16
L_15: MOVE #1, #-13[.IX]
BR /L_17
L_16: MOVE #0, #-13[.IX]
L_17: NOP

; Quadruple - [BRF T_5, L_10, null]
CMP #-13[.IX], #0
BZ /L_10

; Quadruple - [MV T_0, b, null]
MOVE #-5[.IX], #-14[.IX]
; Quadruple - [MV T_1, 7, null]
MOVE #7, #-15[.IX]
; Quadruple - [LS T_2, T_0, T_1]
CMP #-14[.IX], #-15[.IX]
BZ /L_19
BP /L_19
L_18: MOVE #1, #-16[.IX]
BR /L_20
L_19: MOVE #0, #-16[.IX]
L_20: NOP

; Quadruple - [BRF T_2, L_5, null]
CMP #-16[.IX], #0
BZ /L_5

; Quadruple - [WRSTR L_3, null, null]
WRSTR /L_3 

; Quadruple - [MV T_0, b, null]
MOVE #-5[.IX], #-22[.IX]
; Quadruple - [WRINT T_0, null, null]
WRINT #-22[.IX] 
WRCHAR #10 

; Quadruple - [INL L_5, null, null]
L_5: NOP

; Quadruple - [WRSTR L_6, null, null]
WRSTR /L_6 

; Quadruple - [MV T_3, a, null]
MOVE #-4[.IX], #-17[.IX]
; Quadruple - [WRINT T_3, null, null]
WRINT #-17[.IX] 
WRCHAR #10 

; Quadruple - [DVLP STARTSUBPROGRAMA, null, null]
; sin declarar?

; Quadruple - [INICIO_FUNCION null, null, null]
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aquÃ­ IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [MV T_4, b, null]
MOVE #-5[.IX], #-18[.IX]
; Quadruple - [PARAM T_4, null, null]
PUSH #-18[.IX]

; Quadruple - [MV T_5, uno, null]
MOVE #-6[.IX], #-19[.IX]
; Quadruple - [PARAM T_5, null, null]
PUSH #-19[.IX]

; Quadruple - [CALL L_suma, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX
CALL /L_suma            ; Guarda PC y salta
MOVE #0[.IX], .R9     ; Guarda retorno
MOVE #-1[.IX], .SP    ; Restaura enlace de control
MOVE #-3[.IX], .IX    ; Restaura enlace de acceso
; Puede que algo este mal configurado...
; Necesario: Recuperacion de la pila a su sitio original

; Quadruple - [VALOR_RETORNO T_6, null, null]
MOVE .R9, #-20[.IX]

; Quadruple - [MV b, T_6, null]
MOVE #-20[.IX], #-5[.IX]
; Quadruple - [ADD a, a, 1]
ADD #-4[.IX], #1
MOVE .A , #-4[.IX]

; Quadruple - [BR L_9, null, null]
BR /L_9

; Quadruple - [INL L_10, null, null]
L_10: NOP

; Quadruple - [DVLP Mientras, Final, null]
; sin declarar?

; Quadruple - [MV T_0, 1, null]
MOVE #1, #-23[.IX]
