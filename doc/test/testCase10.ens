; Quadruple - [AXIOM null, null, null]

; Quadruple - [FUNCION null, null, null]
null: NOP

; Quadruple - [FIN_FUNCION L_FIN_suma, 7, null]
SUB .IX, #7;posiciona el puntero de pila SP para recuperar el contador del programa
MOVE .A, .SP
RET ;rescata de la pila el contenido del contador de programa




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
;MOVE .SP, .IX  ;guarda el valor de SP en IX
