; Quadruple - [MV T_3, a, null]
MOVE #-7[.IX], #-14[.IX]
; Quadruple - [MV T_4, 5, null]
MOVE #5, #-15[.IX]
; Quadruple - [LS T_5, T_3, T_4]
CMP #-14[.IX], #-15[.IX]
BZ /L_16
BP /L_16
L_15: MOVE #1, #-16[.IX]
BR /L_17
L_16: MOVE #0, #-16[.IX]
L_17: NOP

; Quadruple - [BRF T_5, L_10, null]
CMP #-16[.IX], #0
BZ /L_10

; Quadruple - [MV T_0, b, null]
MOVE #-8[.IX], #-17[.IX]
; Quadruple - [MV T_1, 7, null]
MOVE #7, #-18[.IX]
; Quadruple - [LS T_2, T_0, T_1]
CMP #-17[.IX], #-18[.IX]
BZ /L_19
BP /L_19
L_18: MOVE #1, #-19[.IX]
BR /L_20
L_19: MOVE #0, #-19[.IX]
L_20: NOP

; Quadruple - [BRF T_2, L_5, null]
CMP #-19[.IX], #0
BZ /L_5

; Quadruple - [WRSTR T_0, L_3, null]
WRSTR /L_3 

; Quadruple - [MV T_1, b, null]
MOVE #-8[.IX], #-28[.IX]
