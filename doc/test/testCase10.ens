;PUSH .IX       ;enlace de control
;PUSH .SR       ;estado máquina
;PUSH .IX       ;enlace de acceso

; Quadruple - [VARLOCAL x, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [VARLOCAL y, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [VARLOCAL a, 0, null]
MOVE #0, #-6[.IX]
; Quadruple - [VARLOCAL b, 0, null]
MOVE #0, #-7[.IX]
; Quadruple - [VARLOCAL uno, 0, null]
MOVE #0, #-8[.IX]
; Quadruple - [VARLOCAL c, 0, null]
MOVE #0, #-9[.IX]
; Quadruple - [MV T_0, 0, null]
MOVE #0, #-13[.IX]
; Quadruple - [MV a, T_0, null]
MOVE #-13[.IX], #-6[.IX]
; Quadruple - [MV T_1, 5, null]
MOVE #5, #-14[.IX]
; Quadruple - [MV b, T_1, null]
MOVE #-14[.IX], #-7[.IX]
; Quadruple - [MV T_2, 1, null]
MOVE #1, #-15[.IX]
; Quadruple - [MV uno, T_2, null]
MOVE #-15[.IX], #-8[.IX]
; Quadruple - [DVLP Mientras, Inicio, null]
; sin declarar?

; Quadruple - [INL L_7, null, null]
L_7: NOP

; Quadruple - [MV T_3, a, null]
MOVE #-6[.IX], #-16[.IX]
; Quadruple - [MV T_4, 5, null]
MOVE #5, #-17[.IX]
; Quadruple - [LS T_5, T_3, T_4]
CMP #-16[.IX], #-17[.IX]
BZ /L_12
BP /L_12
L_11: MOVE #1, #-18[.IX]
BR /L_13
L_12: MOVE #0, #-18[.IX]
L_13: NOP

; Quadruple - [BRF T_5, L_8, null]
CMP #-18[.IX], #0
BZ /L_8

; Quadruple - [MV T_0, b, null]
MOVE #-7[.IX], #-19[.IX]
; Quadruple - [MV T_1, 7, null]
MOVE #7, #-20[.IX]
; Quadruple - [LS T_2, T_0, T_1]
CMP #-19[.IX], #-20[.IX]
BZ /L_15
BP /L_15
L_14: MOVE #1, #-21[.IX]
BR /L_16
L_15: MOVE #0, #-21[.IX]
L_16: NOP

; Quadruple - [BRF T_2, L_4, null]
CMP #-21[.IX], #0
BZ /L_4

; Quadruple - [WRSTR T_0, L_2, null]
WRSTR /L_2 

; Quadruple - [MV T_1, b, null]
MOVE #-7[.IX], #-30[.IX]
; Quadruple - [WRINT T_1, null, null]
WRINT #-30[.IX] 
WRCHAR #10 

; Quadruple - [INL L_4, null, null]
L_4: NOP

; Quadruple - [WRSTR T_3, L_5, null]
WRSTR /L_5 

; Quadruple - [MV T_4, a, null]
MOVE #-6[.IX], #-23[.IX]
; Quadruple - [WRINT T_4, null, null]
WRINT #-23[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO T_8, null, null]
MOVE #-27[.IX], #-0[.IX]
HALT

; Quadruple - [MV b, T_8, null]
MOVE #-27[.IX], #-7[.IX]
; Quadruple - [ADD a, a, 1]
ADD #-6[.IX], #1
MOVE .A , #-6[.IX]

; Quadruple - [BR L_7, null, null]
BR /L_7

; Quadruple - [INL L_8, null, null]
L_8: NOP

; Quadruple - [DVLP Mientras, Final, null]
; sin declarar?

; Quadruple - [MV T_0, 1, null]
MOVE #1, #-32[.IX]
; Quadruple - [MV c, T_0, null]
MOVE #-32[.IX], #-9[.IX]
; Quadruple - [WRSTR T_1, L_9, null]
WRSTR /L_9 

; Quadruple - [MV T_2, c, null]
MOVE #-9[.IX], #-34[.IX]
; Quadruple - [WRINT T_2, null, null]
WRINT #-34[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO null, null, null]
HALT

; Quadruple - [CADENA b\n, L_2, null]
L_2: DATA "b\n"
; Quadruple - [CADENA a\n, L_5, null]
L_5: DATA "a\n"
; Quadruple - [CADENA c\n, L_9, null]
L_9: DATA "c\n"
