; Quadruple - [INL L_5, null, null]
L_5: NOP

; Quadruple - [WRSTR T_3, L_6, null]
WRSTR /L_6 

; Quadruple - [MV T_4, a, null]
MOVE #-7[.IX], #-21[.IX]
