; Quadruple - [AXIOM null, null, null]
AXIOM: NOP
BR /PRINCIPAL

; Quadruple - [INL L_suma, null, null]
L_suma: NOP

; Quadruple - [VARSUBPROGRAMA x, -4, null]
MOVE #-4[.IX], #-7[.IX]
; Quadruple - [VARSUBPROGRAMA y, -5, null]
MOVE #-5[.IX], #-8[.IX]
; Quadruple - [PUNTERO_FUNCION T_3, 12, null]
SUB .IX, #12
MOVE .A, .SP

; Quadruple - [MV T_0, x, null]
MOVE #-7[.IX], #-9[.IX]
; Quadruple - [MV T_1, y, null]
MOVE #-8[.IX], #-10[.IX]
; Quadruple - [ADD T_2, T_0, T_1]
ADD #-9[.IX], #-10[.IX]
MOVE .A , #-11[.IX]

; Quadruple - [DEVUELTO L_FIN_FUN_1, T_2, null]
MOVE #-11[.IX], #-0[.IX]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_FUNCION L_FIN_FUN_1, 7, null]
L_FIN_FUN_1: NOP
SUB .IX, #7
MOVE .A, .SP
RET




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IY
PUSH #-1       ;valor de retorno
PUSH .IX       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_6, 25, null]
SUB .IX, #25
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [VARLOCAL b, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [VARLOCAL uno, 0, null]
MOVE #0, #-6[.IX]
; Quadruple - [VARLOCAL c, 0, null]
MOVE #0, #-7[.IX]
; Quadruple - [MV T_0, 0, null]
MOVE #0, #-8[.IX]
