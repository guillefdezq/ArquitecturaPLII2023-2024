; Quadruple - [AXIOM null, null, null]
AXIOM: NOP
BR /PRINCIPAL

; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_6, 11, null]
SUB .IX, #11
MOVE .A, .SP

; Quadruple - [VARLOCAL resultado, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [MV T_0, 10, null]
MOVE #10, #-5[.IX]
; Quadruple - [MV variable1, T_0, null]
MOVE #-5[.IX], /10000
; Quadruple - [MV T_1, 20, null]
MOVE #20, #-6[.IX]
; Quadruple - [MV Variable2, T_1, null]
MOVE #-6[.IX], /10001
; Quadruple - [MV T_2, variable1, null]
MOVE /10000, #-7[.IX]
; Quadruple - [MV T_3, Variable2, null]
MOVE /10001, #-8[.IX]
; Quadruple - [ADD T_4, T_2, T_3]
ADD #-7[.IX], #-8[.IX]
MOVE .A , #-9[.IX]

; Quadruple - [MV resultado, T_4, null]
MOVE #-9[.IX], #-4[.IX]
; Quadruple - [MV T_5, resultado, null]
MOVE #-4[.IX], #-10[.IX]
; Quadruple - [WRINT T_5, null, null]
WRINT #-10[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO L_FIN_FUN_1, null, null]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_FUN_1, null, null]
L_FIN_FUN_1: HALT

