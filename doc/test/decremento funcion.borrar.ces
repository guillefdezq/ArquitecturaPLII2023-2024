/* Falla con instrucción no declarada */

entero z;

entero decrementa (entero x) {
	devuelve x++;
}

vacio principal () { /* Función principal */
	/* variables locales*/
	entero w;
	escribe("*** INVOCACION DE SUBPROGRAMAS***");
	w = decrementa( decrementa(3) ); /* expresión de invocación de un subprograma */
	escribe("w (2) = 5? ");
	escribeEnt(w);
	escribe("FIN");
}