; Quadruple - [VARLOCAL suma, 0, null]
MOVE #0, /10000
; Quadruple - [VARLOCAL mayorDiez, 69, null]
MOVE #69, /10001
; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [INL L_funSuma, null, null]
L_funSuma: NOP

; Quadruple - [VARSUBPROGRAMA x, -4, null]
MOVE #-4[.IX], #-8[.IX]
; Quadruple - [VARSUBPROGRAMA y, -5, null]
MOVE #-5[.IX], #-9[.IX]
; Quadruple - [PUNTERO_FUNCION T_4, 14, null]
SUB .IX, #14
MOVE .A, .SP

; Quadruple - [VARLOCAL suma, 0, null]
MOVE #0, #-7[.IX]
; Quadruple - [MV T_0, x, null]
MOVE #-8[.IX], #-10[.IX]
; Quadruple - [MV T_1, y, null]
MOVE #-9[.IX], #-11[.IX]
; Quadruple - [ADD T_2, T_0, T_1]
ADD #-10[.IX], #-11[.IX]
MOVE .A , #-12[.IX]

; Quadruple - [MV suma, T_2, null]
MOVE #-12[.IX], #-7[.IX]
; Quadruple - [MV T_3, suma, null]
MOVE #-7[.IX], #-13[.IX]
; Quadruple - [DEVUELTO L_FIN_FUN_1, T_3, null]
MOVE #-13[.IX], #-0[.IX]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_FUNCION L_FIN_FUN_1, 7, null]
L_FIN_FUN_1: NOP
SUB .IX, #7
MOVE .A, .SP
RET




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_10, 16, null]
SUB .IX, #16
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 3, null]
MOVE #3, #-4[.IX]
; Quadruple - [VARLOCAL b, 4, null]
MOVE #4, #-5[.IX]
; Quadruple - [INICIO_FUNCION null, null, null]
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aquÃ­ IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [MV T_0, a, null]
MOVE #-4[.IX], #-6[.IX]
; Quadruple - [PARAM T_0, null, null]
PUSH #-6[.IX]

; Quadruple - [MV T_1, b, null]
MOVE #-5[.IX], #-7[.IX]
; Quadruple - [PARAM T_1, null, null]
PUSH #-7[.IX]

; Quadruple - [CALL L_funSuma, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX
CALL /L_funSuma            ; Guarda PC y salta
MOVE #0[.IX], .R9     ; Guarda retorno
MOVE #-1[.IX], .SP    ; Restaura enlace de control
MOVE #-3[.IX], .IX    ; Restaura enlace de acceso
; Puede que algo este mal configurado...
; Necesario: Recuperacion de la pila a su sitio original

; Quadruple - [VALOR_RETORNO T_2, null, null]
MOVE .R9, #-8[.IX]

; Quadruple - [MV suma, T_2, null]
MOVE #-8[.IX], /10000
; Quadruple - [MV T_3, suma, null]
MOVE /10000, #-9[.IX]
; Quadruple - [MV T_4, 10, null]
MOVE #10, #-10[.IX]
; Quadruple - [LS T_5, T_3, T_4]
CMP #-9[.IX], #-10[.IX]
BZ /L_11
BP /L_11
L_10: MOVE #1, #-11[.IX]
BR /L_12
L_11: MOVE #0, #-11[.IX]
L_12: NOP

; Quadruple - [NEG T_6, T_5, null]
CMP #-11[.IX], #0
BZ /L_13
BNZ /L_14
L_13: MOVE #1, #-12[.IX]
BR /L_15
L_14: MOVE #0, #-12[.IX]
L_15: NOP

; Quadruple - [MV mayorDiez, T_6, null]
MOVE #-12[.IX], /10001
; Quadruple - [MV T_7, mayorDiez, null]
MOVE /10001, #-13[.IX]
; Quadruple - [MV T_8, 1, null]
MOVE #1, #-14[.IX]
; Quadruple - [EQ T_9, T_7, T_8]
CMP #-13[.IX], #-14[.IX]
BZ /L_16
BNZ /L_17
L_16: MOVE #1, #-15[.IX]
BR /L_18
L_17: MOVE #0, #-15[.IX]
L_18: NOP

; Quadruple - [BZ T_9, L_7, null]
CMP #-15[.IX], #0
BZ /L_7

; Quadruple - [WRSTR L_4, null, null]
WRSTR /L_4 

; Quadruple - [BR L_6, null, null]
BR /L_6

; Quadruple - [INL L_7, null, null]
L_7: NOP

; Quadruple - [WRSTR L_5, null, null]
WRSTR /L_5 

; Quadruple - [INL L_6, null, null]
L_6: NOP

; Quadruple - [DEVUELTO L_FIN_FUN_2, null, null]
BR /L_FIN_FUN_2    ;rescata de la pila el contenido del contador de programa

