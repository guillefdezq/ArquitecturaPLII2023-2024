; Quadruple - [AXIOM null, null, null]
AXIOM: NOP
CALL /PRINCIPAL
HALT

; Quadruple - [INL L_test, null, null]
L_test: NOP

; Quadruple - [PUNTEROSUBPROGRAMA T_0, 7, null]
; sin declarar?

; Quadruple - [DEVUELTO T_0, null, null]
MOVE #-8[.IX], #-0[.IX]
RET;rescata de la pila el contenido del contador de programa




; Quadruple - [FIN_FUNCION L_FIN_test, 6, null]
SUB .IX, #6;posiciona el puntero de pila SP para recuperar el contador del programa
MOVE .A, .SP
RET ;rescata de la pila el contenido del contador de programa




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en R0
PUSH #-1       ;valor de retorno
PUSH .IX       ;enlace de control
PUSH .SR       ;estado mÃ¡quina
PUSH .IX       ;enlace de acceso

; Quadruple - [VARLOCAL uno, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [VARLOCAL hola, 5, null]
MOVE #5, #-5[.IX]
; Quadruple - [DVLP STARTSUBPROGRAMA, null, null]
; sin declarar?

; Quadruple - [INICIO_FUNCION 3, null, null]
SUB .SP, #3
MOVE .A, .SP   ;cambia de posicion SP para evitar borrado
MOVE .SP, .R0  ;guarda el valor de SP en R0
PUSH #-1       ;valor de retorno
PUSH .R0       ;enlace de control
PUSH .SR       ;estado mÃ¡quina
PUSH .IX       ;enlace de acceso
MOVE .R0, .IX ;inicio registro activaciÃ³n llamada

; Quadruple - [MV T_0, 1, null]
MOVE #1, #-9[.IX]
; Quadruple - [PARAM T_0, null, null]
PUSH #-9[.IX]

; Quadruple - [CALL L_test, null, null]
CALL /L_test ;guarda el contador de programa en la pila
MOVE .IX, .SP ;recuperar el SP
MOVE #0[.IX], .R1 ;guardar retorno en R1
MOVE #-3[.IX], .R0 ;recuperar direcciÃ³n enlace acceso
MOVE .R0, .IX ; restaurar enlace acceso

; Quadruple - [MV hola, T_2, null]
MOVE #-11[.IX], #-5[.IX]
; Quadruple - [DEVUELTO null, null, null]
RET;rescata de la pila el contenido del contador de programa




