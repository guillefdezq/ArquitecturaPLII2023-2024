; Quadruple - [AXIOM null, null, null]
AXIOM: NOP
BR /PRINCIPAL

; Quadruple - [VARGLOBAL otra, 0, null]
; sin declarar?

; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en R0
PUSH #-1       ;valor de retorno
PUSH .IX       ;enlace de control
PUSH .SR       ;estado mÃ¡quina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_4, 11, null]
SUB .IX, #11
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [VARLOCAL b, 0, null]
MOVE #0, #-6[.IX]
; Quadruple - [MV T_0, 3, null]
MOVE #3, #-7[.IX]
; Quadruple - [MV a, T_0, null]
MOVE #-7[.IX], #-5[.IX]
; Quadruple - [DVLP Mientras, Inicio, null]
; sin declarar?

; Quadruple - [INL L_4, null, null]
L_4: NOP

; Quadruple - [MV T_1, a, null]
MOVE #-5[.IX], #-8[.IX]
; Quadruple - [MV T_2, 5, null]
MOVE #5, #-9[.IX]
; Quadruple - [LS T_3, T_1, T_2]
CMP #-8[.IX], #-9[.IX]
BZ /L_9
BP /L_9
L_8: MOVE #1, #-10[.IX]
BR /L_10
L_9: MOVE #0, #-10[.IX]
L_10: NOP

; Quadruple - [BRF T_3, L_5, null]
CMP #-10[.IX], #0
BZ /L_5

; Quadruple - [MV T_0, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [MV b, T_0, null]
MOVE #-5[.IX], #-6[.IX]
; Quadruple - [DVLP Mientras, Inicio, null]
; sin declarar?

; Quadruple - [INL L_1, null, null]
L_1: NOP

; Quadruple - [MV T_1, b, null]
MOVE #-6[.IX], #-6[.IX]
; Quadruple - [MV T_2, 3, null]
MOVE #3, #-7[.IX]
; Quadruple - [LS T_3, T_1, T_2]
CMP #-6[.IX], #-7[.IX]
BZ /L_12
BP /L_12
L_11: MOVE #1, #-8[.IX]
BR /L_13
L_12: MOVE #0, #-8[.IX]
L_13: NOP

; Quadruple - [BRF T_3, L_2, null]
CMP #-8[.IX], #0
BZ /L_2

; Quadruple - [MV T_0, b, null]
MOVE #-6[.IX], #-5[.IX]
; Quadruple - [WRINT T_0, null, null]
WRINT #-5[.IX] 
WRCHAR #10 

; Quadruple - [ADD b, b, 1]
ADD #-6[.IX], #1
MOVE .A , #-6[.IX]

; Quadruple - [BR L_1, null, null]
BR /L_1

; Quadruple - [INL L_2, null, null]
L_2: NOP

; Quadruple - [DVLP Mientras, Final, null]
; sin declarar?

; Quadruple - [MV T_4, a, null]
MOVE #-5[.IX], #-9[.IX]
; Quadruple - [WRINT T_4, null, null]
WRINT #-9[.IX] 
WRCHAR #10 

; Quadruple - [ADD a, a, 1]
ADD #-5[.IX], #1
MOVE .A , #-5[.IX]

; Quadruple - [BR L_4, null, null]
BR /L_4

; Quadruple - [INL L_5, null, null]
L_5: NOP

; Quadruple - [DVLP Mientras, Final, null]
; sin declarar?

; Quadruple - [DEVUELTO L_FIN_FUN_1, null, null]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_FUN_1, null, null]
L_FIN_FUN_1: HALT

