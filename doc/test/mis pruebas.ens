; Quadruple - [MV T_0, 0, null]
MOVE #0, #-7[.IX]
; Quadruple - [MVP T_1, v1, 0]
MOVE #-4[.IX], #-8[.IX]

; Quadruple - [MV T_2, 69, null]
MOVE #69, #-9[.IX]
; Quadruple - [STP v1, T_2, 0]
MOVE #-9[.IX], #-4[.IX]

; Quadruple - [MV T_3, 1, null]
MOVE #1, #-10[.IX]
; Quadruple - [MVP T_4, v1, 1]
MOVE #-5[.IX], #-11[.IX]

; Quadruple - [MV T_5, 420, null]
MOVE #420, #-12[.IX]
; Quadruple - [STP v1, T_5, 1]
MOVE #-12[.IX], #-5[.IX]

; Quadruple - [MV T_6, 1, null]
MOVE #1, #-13[.IX]
; Quadruple - [MVP T_7, v1, 1]
MOVE #-5[.IX], #-14[.IX]

; Quadruple - [MV T_8, 666, null]
MOVE #666, #-15[.IX]
; Quadruple - [STP v1, T_8, 1]
MOVE #-15[.IX], #-5[.IX]

; Quadruple - [WRSTR T_9, L_0, null]
WRSTR /L_0 

; Quadruple - [MV T_10, 1, null]
MOVE #1, #-17[.IX]
; Quadruple - [MVP T_11, v1, 1]
MOVE #-5[.IX], #-18[.IX]

; Quadruple - [WRINT T_11, null, null]
WRINT #-18[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO null, null, null]
HALT

; Quadruple - [CADENA v1\n, L_0, null]
L_0: DATA "v1\n"
