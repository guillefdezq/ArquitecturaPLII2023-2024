; Quadruple - [AXIOM null, null, null]

; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
;MOVE .SP, .IX  ;guarda el valor de SP en IX
;PUSH #-1       ;valor de retorno
;PUSH .IX       ;enlace de control
;PUSH .SR       ;estado mÃ¡quina
;PUSH .IX       ;enlace de acceso

; Quadruple - [VARLOCAL a, 2, null]
MOVE #2, #-4[.IX]
; Quadruple - [VARLOCAL b, 2, null]
MOVE #2, #-5[.IX]
; Quadruple - [VARLOCAL c, 0, null]
MOVE #0, #-6[.IX]
; Quadruple - [WRSTR T_0, L_0, null]
WRSTR /L_0 

; Quadruple - [MV T_1, 1, null]
MOVE #1, #-8[.IX]
; Quadruple - [MV T_2, 2, null]
MOVE #2, #-9[.IX]
; Quadruple - [LS T_3, T_1, T_2]
CMP #-8[.IX], #-9[.IX]
BZ /L_10
BP /L_10
L_9: MOVE #1, #-10[.IX]
BR /L_11
L_10: MOVE #0, #-10[.IX]
L_11: NOP

; Quadruple - [WRINT T_3, null, null]
WRINT #-10[.IX] 
WRCHAR #10 

; Quadruple - [WRSTR T_5, L_2, null]
WRSTR /L_2 

; Quadruple - [MV T_6, 2, null]
MOVE #2, #-13[.IX]
; Quadruple - [MV T_7, 1, null]
MOVE #1, #-14[.IX]
; Quadruple - [LS T_8, T_6, T_7]
CMP #-13[.IX], #-14[.IX]
BZ /L_14
BP /L_14
L_13: MOVE #1, #-15[.IX]
BR /L_15
L_14: MOVE #0, #-15[.IX]
L_15: NOP

; Quadruple - [WRINT T_8, null, null]
WRINT #-15[.IX] 
WRCHAR #10 

; Quadruple - [WRSTR T_10, L_4, null]
WRSTR /L_4 

; Quadruple - [MV T_11, 0, null]
MOVE #0, #-18[.IX]
; Quadruple - [MV T_12, 1, null]
MOVE #1, #-19[.IX]
; Quadruple - [LS T_13, T_11, T_12]
CMP #-18[.IX], #-19[.IX]
BZ /L_18
BP /L_18
L_17: MOVE #1, #-20[.IX]
BR /L_19
L_18: MOVE #0, #-20[.IX]
L_19: NOP

; Quadruple - [WRINT T_13, null, null]
WRINT #-20[.IX] 
WRCHAR #10 

; Quadruple - [WRSTR T_15, L_6, null]
WRSTR /L_6 

; Quadruple - [MV T_16, 1, null]
MOVE #1, #-23[.IX]
; Quadruple - [MV T_17, 0, null]
MOVE #0, #-24[.IX]
; Quadruple - [LS T_18, T_16, T_17]
CMP #-23[.IX], #-24[.IX]
BZ /L_22
BP /L_22
L_21: MOVE #1, #-25[.IX]
BR /L_23
L_22: MOVE #0, #-25[.IX]
