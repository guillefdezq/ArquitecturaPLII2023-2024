
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas;MOVE .SP, .IX  ;guarda el valor de SP en IX
;PUSH #-1       ;valor de retorno
;PUSH .IX       ;enlace de control
;PUSH .SR       ;estado mÃ¡quina
;PUSH .IX       ;enlace de acceso

MOVE #1, #-4[.IX]
CMP #-4[.IX], #0
BZ /L_3

WRSTR /L_0 

BR /L_2

L_3: NOP

WRSTR /L_1 

L_2: NOP

MOVE #0, #-5[.IX]
CMP #-5[.IX], #0
BZ /L_7

WRSTR /L_4 

BR /L_6

L_7: NOP

WRSTR /L_5 

L_6: NOP

HALT 
L_0: DATA "verdad\n"
L_1: DATA "falso\n"
L_4: DATA "verdad\n"
L_5: DATA "falso\n"
