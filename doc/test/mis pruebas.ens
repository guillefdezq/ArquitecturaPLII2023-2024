; Quadruple - [AXIOM null, null, null]

; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
;MOVE .SP, .IX  ;guarda el valor de SP en IX
;PUSH #-1       ;valor de retorno
;PUSH .IX       ;enlace de control
;PUSH .SR       ;estado mÃ¡quina
;PUSH .IX       ;enlace de acceso

; Quadruple - [VARLOCAL test, 1, null]
MOVE #1, #-4[.IX]
; Quadruple - [INL L_1, null, null]
L_1: NOP

; Quadruple - [MV T_0, test, null]
MOVE #-4[.IX], #-5[.IX]
; Quadruple - [MV T_1, 5, null]
MOVE #5, #-6[.IX]
; Quadruple - [LS T_2, T_0, T_1]
CMP #-5[.IX], #-6[.IX]
BNZ /L_3
BN /L_3
BZ /L_4
BP /L_4
L_3: MOVE #1, #-7[.IX]
BR /L_5
L_4: MOVE #0, #-7[.IX]
L_5: NOP

; Quadruple - [BRF T_2, L_2, null]
CMP #-7[.IX], #0
BZ /L_2

; Quadruple - [MV T_0, test, null]
MOVE #-4[.IX], #-8[.IX]
; Quadruple - [WRINT T_0, null, null]
WRINT #-8[.IX] 
WRCHAR #10 

; Quadruple - [ADD test, test, 1]
ADD #-4[.IX], #1
MOVE .A , #-4[.IX]

; Quadruple - [BR L_1, null, null]
BR /L_1

; Quadruple - [INL L_2, null, null]
L_2: NOP

; Quadruple - [DEVUELTO null, null, null]
HALT

