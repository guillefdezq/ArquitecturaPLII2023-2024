; Quadruple - [AXIOM null, null, null]
AXIOM: NOP
BR /PRINCIPAL

; Quadruple - [VARGLOBAL otra, 0, null]
; sin declarar?

; Quadruple - [INL L_test, null, null]
L_test: NOP

; Quadruple - [VARSUBPROGRAMA T_1, -4, null]
PUSH #-4[.IX]

; Quadruple - [PUNTERO_FUNCION T_1, 8, null]
SUB .IX, #8
MOVE .A, .SP

; Quadruple - [MV T_0, uno, null]
MOVE #-6[.IX], #-7[.IX]
; Quadruple - [DEVUELTO L_FIN_FUN_1, T_0, null]
MOVE #-7[.IX], #-0[.IX]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_FUNCION L_FIN_FUN_1, 6, null]
L_FIN_FUN_1: NOP
SUB .IX, #6
MOVE .A, .SP
RET




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en R0
PUSH #-1       ;valor de retorno
PUSH .IX       ;enlace de control
PUSH .SR       ;estado mÃ¡quina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_3, 8, null]
SUB .IX, #8
MOVE .A, .SP

; Quadruple - [VARLOCAL uno, 0, null]
PUSH #0

; Quadruple - [DVLP STARTSUBPROGRAMA, null, null]
; sin declarar?

; Quadruple - [INICIO_FUNCION null, null, null]
MOVE .SP, .R0  ;guarda el valor de SP en R0
PUSH #-1       ;valor de retorno
PUSH .R0       ;enlace de control
PUSH .SR       ;estado mÃ¡quina
PUSH .IX       ;enlace de acceso

; Quadruple - [MV T_0, 420, null]
MOVE #420, #-5[.IX]
; Quadruple - [PARAM T_0, null, null]
PUSH #-5[.IX]

; Quadruple - [CALL L_test, null, null]
MOVE .R0, .IX         ; Guarda el valor de R0 en IX
CALL /L_test            ; Guarda PC y salta
MOVE .IX, .R0         ; Restaura puntero pila
MOVE #0[.IX], .R9     ; Guarda retorno
MOVE #-3[.IX], .R0    ; Restaura puntero de acceso
MOVE .R0, .IX         ; ActualizaciÃ³n IX a principal

; Quadruple - [VALOR_RETORNO T_1, null, null]
MOVE .R9, #-6[.IX]

; Quadruple - [WRINT T_1, null, null]
WRINT #-6[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO L_FIN_FUN_2, null, null]
BR /L_FIN_FUN_2    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_FUN_2, null, null]
L_FIN_FUN_2: HALT

