; Quadruple - [AXIOM null, null, null]

; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
;MOVE .SP, .IX  ;guarda el valor de SP en IX
;PUSH #-1       ;valor de retorno
;PUSH .IX       ;enlace de control
;PUSH .SR       ;estado mÃ¡quina
;PUSH .IX       ;enlace de acceso

; Quadruple - [VARLOCAL test, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [VARLOCAL prueba, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [DVLP Mientras, Inicio, null]
; sin declarar?

; Quadruple - [INL L_2, null, null]
L_2: NOP

; Quadruple - [MV T_0, test, null]
MOVE #-4[.IX], #-6[.IX]
; Quadruple - [MV T_1, 3, null]
MOVE #3, #-7[.IX]
; Quadruple - [LS T_2, T_0, T_1]
CMP #-6[.IX], #-7[.IX]
BNZ /L_4
BN /L_4
BZ /L_5
BP /L_5
L_4: MOVE #1, #-8[.IX]
BR /L_6
L_5: MOVE #0, #-8[.IX]
L_6: NOP

; Quadruple - [BRF T_2, L_3, null]
CMP #-8[.IX], #0
BZ /L_3

; Quadruple - [DVLP Alternativas, Inicio, null]
; sin declarar?

; Quadruple - [MV T_0, test, null]
MOVE #-4[.IX], #-9[.IX]
; Quadruple - [INL L_1, null, null]
L_1: NOP

; Quadruple - [CMP T_0, 0, null]
CMP #-9[.IX], #0

; Quadruple - [BNZ L_0, null, null]
BZ /L_0

; Quadruple - [MV T_0, 0, null]
MOVE #0, #-11[.IX]
; Quadruple - [MV prueba, T_0, null]
MOVE #-11[.IX], #-5[.IX]
; Quadruple - [BR L_0, null, null]
BR /L_0

; Quadruple - [INL L_0, null, null]
L_0: NOP

; Quadruple - [DVLP Alternativas, Final, null]
; sin declarar?

; Quadruple - [ADD test, test, 1]
ADD #-4[.IX], #1
MOVE .A , #-4[.IX]

; Quadruple - [BR L_2, null, null]
BR /L_2

; Quadruple - [INL L_3, null, null]
L_3: NOP

; Quadruple - [DVLP Mientras, Final, null]
; sin declarar?

; Quadruple - [DEVUELTO null, null, null]
HALT

