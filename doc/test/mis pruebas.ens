; Quadruple - [AXIOM null, null, null]

; Quadruple - [VARGLOBAL verano, 0, null]
; sin declarar?

; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
;MOVE .SP, .IX  ;guarda el valor de SP en IX
;PUSH #-1       ;valor de retorno
;PUSH .IX       ;enlace de control
;PUSH .SR       ;estado mÃ¡quina
;PUSH .IX       ;enlace de acceso

; Quadruple - [VARLOCAL estacion, 0, null]
; sin declarar

; Quadruple - [MV T_0, 1, null]
MOVE #1, #-5[.IX]
; Quadruple - [MV estacion, T_0, null]
MOVE #-5[.IX], #-4[.IX]
; Quadruple - [WRSTR T_1, L_0, null]
WRSTR /L_0 

; Quadruple - [MV T_2, 1, null]
MOVE #1, #-7[.IX]
; Quadruple - [ADD estacion, estacion, T_2]
ADD #-4[.IX], #-7[.IX]
MOVE .A , #-4[.IX]

; Quadruple - [WRSTR T_3, L_1, null]
WRSTR /L_1 

; Quadruple - [MV T_4, 1, null]
MOVE #1, #-9[.IX]
; Quadruple - [ADD estacion, estacion, T_4]
ADD #-4[.IX], #-9[.IX]
MOVE .A , #-4[.IX]

; Quadruple - [MV T_5, estacion, null]
MOVE #-4[.IX], #-10[.IX]
; Quadruple - [MV T_6, 3, null]
MOVE #3, #-11[.IX]
; Quadruple - [EQ T_7, T_5, T_6]
CMP #-10[.IX], #-11[.IX]
BZ /L_6
BNZ /L_7
L_6: MOVE #1, #-12[.IX]
BR /L_8
L_7: MOVE #0, #-12[.IX]
L_8: NOP

; Quadruple - [BRF T_7, L_4, null]
CMP #-12[.IX], #0
BZ /L_4

; Quadruple - [WRSTR T_0, L_2, null]
WRSTR /L_2 

; Quadruple - [WRSTR T_1, L_3, null]
WRSTR /L_3 

; Quadruple - [INL L_4, null, null]
L_4: NOP

; Quadruple - [DEVUELTO null, null, null]
HALT

; Quadruple - [CADENA Que lo que?\n, L_0, null]
L_0: DATA "Que lo que?\n"
; Quadruple - [CADENA Estamos a rulay\n, L_1, null]
L_1: DATA "Estamos a rulay\n"
; Quadruple - [CADENA Empezo el verano!\n, L_2, null]
L_2: DATA "Empezo el verano!\n"
; Quadruple - [CADENA FUEEGOO!!!\n, L_3, null]
L_3: DATA "FUEEGOO!!!\n"
