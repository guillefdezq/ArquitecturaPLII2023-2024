; Quadruple - [AXIOM null, null, null]

; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
;MOVE .SP, .IX  ;guarda el valor de SP en IX
;PUSH #-1       ;valor de retorno
;PUSH .IX       ;enlace de control
;PUSH .SR       ;estado mÃ¡quina
;PUSH .IX       ;enlace de acceso

; Quadruple - [VARLOCAL test, 1, null]
MOVE #1, #-4[.IX]
; Quadruple - [VARLOCAL gaga, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [WRSTR T_0, L_0, null]
WRSTR /L_0 

; Quadruple - [MV T_1, test, null]
MOVE #-4[.IX], #-7[.IX]
; Quadruple - [WRINT T_1, null, null]
WRINT #-7[.IX] 
WRCHAR #10 

; Quadruple - [ADD test, test, 1]
ADD #-4[.IX], #1
MOVE .A , #-4[.IX]

; Quadruple - [WRSTR T_4, L_2, null]
WRSTR /L_2 

; Quadruple - [MV T_5, test, null]
MOVE #-4[.IX], #-11[.IX]
; Quadruple - [WRINT T_5, null, null]
WRINT #-11[.IX] 
WRCHAR #10 

; Quadruple - [MV T_7, test, null]
MOVE #-4[.IX], #-13[.IX]
; Quadruple - [ADD T_8, T_7, 1]
ADD #-13[.IX], #1
MOVE .A , #-14[.IX]

; Quadruple - [MV gaga, T_8, null]
MOVE #-14[.IX], #-5[.IX]
; Quadruple - [WRSTR T_9, L_4, null]
WRSTR /L_4 

; Quadruple - [MV T_10, test, null]
MOVE #-4[.IX], #-16[.IX]
; Quadruple - [WRINT T_10, null, null]
WRINT #-16[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO null, null, null]
HALT

; Quadruple - [CADENA Debe salir 1:\n, L_0, null]
L_0: DATA "Debe salir 1:\n"
; Quadruple - [CADENA Debe salir 2:\n, L_2, null]
L_2: DATA "Debe salir 2:\n"
; Quadruple - [CADENA Debe seguir saliendo 2:\n, L_4, null]
L_4: DATA "Debe seguir saliendo 2:\n"
