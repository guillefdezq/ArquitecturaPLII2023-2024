; Quadruple - [VARLOCAL z, 1, null]
MOVE #1, /10000
; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [INL L_decrementa, null, null]
L_decrementa: NOP

; Quadruple - [VARSUBPROGRAMA x, -4, null]
MOVE #-4[.IX], #-6[.IX]
; Quadruple - [PUNTERO_FUNCION 12, null, null]
SUB .IX, #12
MOVE .A, .SP

; Quadruple - [VARLOCAL y, 0, null]
MOVE #0, #-7[.IX]
; Quadruple - [MV T_0, x, null]
MOVE #-6[.IX], #-8[.IX]
; Quadruple - [MV T_1, 1, null]
MOVE #1, #-9[.IX]
; Quadruple - [ADD T_2, T_0, T_1]
ADD #-8[.IX], #-9[.IX]
MOVE .A , #-10[.IX]

; Quadruple - [MV y, T_2, null]
MOVE #-10[.IX], #-7[.IX]
; Quadruple - [WRSTR L_0, null, null]
WRSTR /L_0 

; Quadruple - [MV T_3, y, null]
MOVE #-7[.IX], #-11[.IX]
; Quadruple - [WRINT T_3, null, null]
WRINT #-11[.IX] 
WRCHAR #10 

; Quadruple - [FIN_FUNCION L_FIN_FUN_1, 6, null]
L_FIN_FUN_1: NOP
SUB .IX, #6
MOVE .A, .SP
RET




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL 9, null, null]
SUB .IX, #9
MOVE .A, .SP

; Quadruple - [VARLOCAL l, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [WRSTR L_4, null, null]
WRSTR /L_4 

; Quadruple - [MV T_0, z, null]
MOVE /10000, #-5[.IX]
; Quadruple - [MV l, T_0, null]
MOVE #-5[.IX], #-4[.IX]
; Quadruple - [MV T_1, 3, null]
MOVE #3, #-6[.IX]
; Quadruple - [MV z, T_1, null]
MOVE #-6[.IX], /10000
; Quadruple - [INICIO_FUNCION null, null, null]
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aquÃ­ IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [MV T_2, z, null]
MOVE /10000, #-7[.IX]
; Quadruple - [PARAM T_2, null, null]
PUSH #-7[.IX]

; Quadruple - [CALL L_decrementa, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX
CALL /L_decrementa            ; Guarda PC y salta
MOVE #0[.IX], .R9     ; Guarda retorno
MOVE #-1[.IX], .SP    ; Restaura enlace de control
MOVE #-3[.IX], .IX    ; Restaura enlace de acceso
; Puede que algo este mal configurado...
; Necesario: Recuperacion de la pila a su sitio original

; Quadruple - [WRSTR L_6, null, null]
WRSTR /L_6 

; Quadruple - [FIN_PRINCIPAL L_FIN_FUN_2, null, null]
L_FIN_FUN_2: HALT

; Quadruple - [CADENA y (4) = \n, L_0, null]
L_0: DATA "y (4) = \n"
; Quadruple - [CADENA *** INVOCACION DE SUBPROGRAMAS***\n, L_4, null]
L_4: DATA "*** INVOCACION DE SUBPROGRAMAS***\n"
; Quadruple - [CADENA FIN\n, L_6, null]
L_6: DATA "FIN\n"
