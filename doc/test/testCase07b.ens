; Quadruple - [AXIOM null, null, null]
AXIOM: NOP
BR /PRINCIPAL

; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IY
PUSH #-1       ;valor de retorno
PUSH .IX       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_8, 19, null]
SUB .IX, #19
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 25, null]
MOVE #25, #-4[.IX]
; Quadruple - [VARLOCAL b, 10, null]
MOVE #10, #-5[.IX]
; Quadruple - [VARLOCAL c, 0, null]
MOVE #0, #-6[.IX]
; Quadruple - [VARLOCAL d, 9, null]
MOVE #9, #-7[.IX]
; Quadruple - [VARLOCAL a, 50, null]
MOVE #50, #-8[.IX]
; Quadruple - [MV T_0, a, null]
MOVE #-4[.IX], #-9[.IX]
; Quadruple - [WRINT T_0, null, null]
WRINT #-9[.IX] 
WRCHAR #10 

; Quadruple - [MV T_1, d, null]
MOVE #-7[.IX], #-10[.IX]
; Quadruple - [MV c, T_1, null]
MOVE #-10[.IX], #-6[.IX]
; Quadruple - [ADD c, c, 1]
ADD #-6[.IX], #1
MOVE .A , #-6[.IX]

; Quadruple - [ADD c, c, 1]
ADD #-6[.IX], #1
MOVE .A , #-6[.IX]

; Quadruple - [MV T_4, a, null]
MOVE #-4[.IX], #-13[.IX]
; Quadruple - [MV T_5, 25, null]
MOVE #25, #-14[.IX]
; Quadruple - [EQ T_6, T_4, T_5]
CMP #-13[.IX], #-14[.IX]
BZ /L_7
BNZ /L_8
L_7: MOVE #1, #-15[.IX]
BR /L_9
L_8: MOVE #0, #-15[.IX]
L_9: NOP

; Quadruple - [BRF T_6, L_3, null]
CMP #-15[.IX], #0
BZ /L_3

; Quadruple - [MV T_0, b, null]
MOVE #-5[.IX], #-17[.IX]
; Quadruple - [WRINT T_0, null, null]
WRINT #-17[.IX] 
WRCHAR #10 

; Quadruple - [MV T_1, a, null]
MOVE #-8[.IX], #-18[.IX]
; Quadruple - [WRINT T_1, null, null]
WRINT #-18[.IX] 
WRCHAR #10 

; Quadruple - [INL L_3, null, null]
L_3: NOP

; Quadruple - [MV T_7, a, null]
MOVE #-4[.IX], #-16[.IX]
; Quadruple - [WRINT T_7, null, null]
WRINT #-16[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO L_FIN_FUN_1, null, null]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_FUN_1, null, null]
L_FIN_FUN_1: HALT

