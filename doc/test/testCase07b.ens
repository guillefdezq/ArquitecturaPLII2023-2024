; Quadruple - [AXIOM null, null, null]
AXIOM: NOP
BR /PRINCIPAL

; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en R0
PUSH #-1       ;valor de retorno
PUSH .IX       ;enlace de control
PUSH .SR       ;estado mÃ¡quina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_10, 19, null]
SUB .IX, #19
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 25, null]
MOVE #25, #-8[.IX]
; Quadruple - [VARLOCAL b, 10, null]
MOVE #10, #-9[.IX]
; Quadruple - [VARLOCAL c, 0, null]
MOVE #0, #-10[.IX]
; Quadruple - [VARLOCAL d, 9, null]
MOVE #9, #-11[.IX]
; Quadruple - [VARLOCAL a, 50, null]
MOVE #50, #-12[.IX]
; Quadruple - [MV T_0, a, null]
MOVE #-8[.IX], #-13[.IX]
; Quadruple - [WRINT T_0, null, null]
WRINT #-13[.IX] 
WRCHAR #10 

; Quadruple - [MV T_2, d, null]
MOVE #-11[.IX], #-15[.IX]
; Quadruple - [MV c, T_2, null]
MOVE #-15[.IX], #-10[.IX]
; Quadruple - [ADD c, c, 1]
ADD #-10[.IX], #1
MOVE .A , #-10[.IX]

; Quadruple - [ADD c, c, 1]
ADD #-10[.IX], #1
MOVE .A , #-10[.IX]

; Quadruple - [MV T_5, a, null]
MOVE #-8[.IX], #-18[.IX]
; Quadruple - [MV T_6, 25, null]
MOVE #25, #-19[.IX]
; Quadruple - [EQ T_7, T_5, T_6]
CMP #-18[.IX], #-19[.IX]
BZ /L_7
BNZ /L_8
L_7: MOVE #1, #-20[.IX]
BR /L_9
L_8: MOVE #0, #-20[.IX]
L_9: NOP

; Quadruple - [BRF T_7, L_3, null]
CMP #-20[.IX], #0
BZ /L_3

; Quadruple - [MV T_0, b, null]
MOVE #-9[.IX], #-23[.IX]
; Quadruple - [WRINT T_0, null, null]
WRINT #-23[.IX] 
WRCHAR #10 

; Quadruple - [MV T_2, a, null]
MOVE #-12[.IX], #-25[.IX]
; Quadruple - [WRINT T_2, null, null]
WRINT #-25[.IX] 
WRCHAR #10 

; Quadruple - [INL L_3, null, null]
L_3: NOP

; Quadruple - [MV T_8, a, null]
MOVE #-8[.IX], #-21[.IX]
; Quadruple - [WRINT T_8, null, null]
WRINT #-21[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO L_FIN_FUN_1, null, null]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_FUN_1, null, null]
L_FIN_FUN_1: HALT

