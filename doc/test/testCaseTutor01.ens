; Quadruple - [VARLOCAL lista1, 0, null]
MOVE #0, /10000
; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [INL L_incrementa, null, null]
L_incrementa: NOP

; Quadruple - [VARSUBPROGRAMA x, -4, null]
MOVE #-4[.IX], #-17[.IX]
; Quadruple - [PUNTERO_FUNCION 26, null, null]
SUB .IX, #26
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 0, null]
MOVE #0, #-6[.IX]
; Quadruple - [VARLOCALVECTOR lista2, 10, null]
; sin declarar?

; Quadruple - [VARLOCALVECTOR lista3, 4, null]
; sin declarar?

; Quadruple - [VARLOCAL c, 0, null]
MOVE #0, #-22[.IX]
; Quadruple - [MV T_0, 1, null]
MOVE #1, #-24[.IX]
; Quadruple - [MV c, T_0, null]
MOVE #-24[.IX], #-22[.IX]
; Quadruple - [WRSTR L_0, null, null]
WRSTR /L_0 

; Quadruple - [MV T_1, c, null]
MOVE #-22[.IX], #-25[.IX]
; Quadruple - [WRINT T_1, null, null]
WRINT #-25[.IX] 
WRCHAR #10 

; Quadruple - [MV T_0, 1, null]
MOVE #1, #-23[.IX]
; Quadruple - [DEVUELTO L_FIN_incrementa, T_0, null]
MOVE #-23[.IX], #-0[.IX]
BR /L_FIN_incrementa    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_FUNCION L_FIN_incrementa, 6, null]
L_FIN_incrementa: NOP
SUB .IX, #6
MOVE .A, .SP
RET




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL 11, null, null]
SUB .IX, #11
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [VARLOCALVECTOR lista3, 4, null]
; sin declarar?

; Quadruple - [INICIO_FUNCION null, null, null]
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aqui IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [MV T_0, a, null]
MOVE #-4[.IX], #-9[.IX]
; Quadruple - [PARAM T_0, null, null]
PUSH #-9[.IX]

; Quadruple - [CONTROL null, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX

; Quadruple - [CALL L_incrementa, null, null]
CALL /L_incrementa            ; Guarda PC y salta
MOVE #0[.IX], .R9     ; Guarda retorno
MOVE #-1[.IX], .SP    ; Restaura enlace de control
MOVE #-1[.IX], .IY    ; Restaura enlace de control
MOVE #-2[.IX], .SR    ; Restaura estado maquina
MOVE #-3[.IX], .IX    ; Restaura enlace de acceso
; Puede que algo este mal configurado...
; Necesario: Recuperacion de la pila a su sitio original

; Quadruple - [VALOR_RETORNO T_1, null, null]
MOVE .R9, #-10[.IX]

; Quadruple - [MV a, T_1, null]
MOVE #-10[.IX], #-4[.IX]
; Quadruple - [DEVUELTO L_FIN_principal, null, null]
BR /L_FIN_principal    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_principal, null, null]
L_FIN_principal: HALT

; Quadruple - [CADENA c\n, L_0, null]
L_0: DATA "c\n"
