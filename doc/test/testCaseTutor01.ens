; Quadruple - [FUNCION null, null, null]
null: NOP

; Quadruple - [FIN_FUNCION L_FIN_incrementa, 6, null]
SUB .IX, #6;posiciona el puntero de pila SP para recuperar el contador del programa
MOVE .A, .SP
RET ;rescata de la pila el contenido del contador de programa




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
