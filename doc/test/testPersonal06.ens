; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [INL L_suma, null, null]
L_suma: NOP

; Quadruple - [VARSUBPROGRAMA a, -4, null]
MOVE #-4[.IX], #-7[.IX]
; Quadruple - [VARSUBPROGRAMA b, -5, null]
MOVE #-5[.IX], #-8[.IX]
; Quadruple - [PUNTERO_FUNCION 12, null, null]
SUB .IX, #12
MOVE .A, .SP

; Quadruple - [MV T_0, a, null]
MOVE #-7[.IX], #-9[.IX]
; Quadruple - [MV T_1, b, null]
MOVE #-8[.IX], #-10[.IX]
; Quadruple - [ADD T_2, T_0, T_1]
ADD #-9[.IX], #-10[.IX]
MOVE .A , #-11[.IX]

; Quadruple - [DEVUELTO L_FIN_suma, T_2, null]
MOVE #-11[.IX], #-0[.IX]
BR /L_FIN_suma    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_FUNCION L_FIN_suma, 7, null]
L_FIN_suma: NOP
SUB .IX, #7
MOVE .A, .SP
RET




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL 9, null, null]
SUB .IX, #9
MOVE .A, .SP

; Quadruple - [VARLOCAL resultado, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [INICIO_FUNCION null, null, null]
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aquÃ­ IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [MV T_0, 1, null]
MOVE #1, #-5[.IX]
; Quadruple - [PARAM T_0, null, null]
PUSH #-5[.IX]

; Quadruple - [MV T_1, 2, null]
MOVE #2, #-6[.IX]
; Quadruple - [PARAM T_1, null, null]
PUSH #-6[.IX]

; Quadruple - [CALL L_suma, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX
CALL /L_suma            ; Guarda PC y salta
MOVE #0[.IX], .R9     ; Guarda retorno
MOVE #-1[.IX], .SP    ; Restaura enlace de control
MOVE #-3[.IX], .IX    ; Restaura enlace de acceso
; Puede que algo este mal configurado...
; Necesario: Recuperacion de la pila a su sitio original

; Quadruple - [VALOR_RETORNO T_2, null, null]
MOVE .R9, #-7[.IX]

; Quadruple - [MV resultado, T_2, null]
MOVE #-7[.IX], #-4[.IX]
; Quadruple - [MV T_3, resultado, null]
MOVE #-4[.IX], #-8[.IX]
; Quadruple - [WRINT T_3, null, null]
WRINT #-8[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO L_FIN_principal, null, null]
BR /L_FIN_principal    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_principal, null, null]
L_FIN_principal: HALT

