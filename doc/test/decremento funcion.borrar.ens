MOVE #0, /10000
AXIOM: BR /PRINCIPAL
L_decrementa: NOP
MOVE #-4[.IX], #-6[.IX]
SUB .IX, #17
MOVE .A, .SP
MOVE #8, #-7[.IX]
MOVE #2, #-8[.IX]
MOVE #3, #-9[.IX]
MOVE #-6[.IX], #-10[.IX]
MOVE #1, #-11[.IX]
ADD #-10[.IX], #-11[.IX]
MOVE .A , #-12[.IX]
MOVE #-12[.IX], #-7[.IX]
MOVE #-9[.IX], #-14[.IX]
MOVE #1, #-15[.IX]
ADD #-14[.IX], #-15[.IX]
MOVE .A , #-16[.IX]
MOVE #-16[.IX], #-8[.IX]
MOVE #-7[.IX], #-13[.IX]
MOVE #-13[.IX], #-0[.IX]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa
L_FIN_FUN_1: NOP
SUB .IX, #6
MOVE .A, .SP
RET
PRINCIPAL: NOP
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso
SUB .IX, #10
MOVE .A, .SP
MOVE #9, #-4[.IX]
WRSTR /L_3 
MOVE #3, #-5[.IX]
MOVE #-5[.IX], /10000
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aquÃ­ IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aquÃ­ IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso
MOVE /10000, #-6[.IX]
PUSH #-6[.IX]
MOVE .IY, .IX         
CALL /L_decrementa            
MOVE #0[.IX], .R9     
MOVE #-1[.IX], .SP    
MOVE #-3[.IX], .IX    
MOVE .R9, #-7[.IX]
PUSH #-7[.IX]
MOVE .IY, .IX         
CALL /L_decrementa            
MOVE #0[.IX], .R9   ; Falla aquí        
MOVE #-1[.IX], .SP    
MOVE #-3[.IX], .IX    
MOVE .R9, #-8[.IX]
MOVE #-8[.IX], #-4[.IX]
WRSTR /L_6 
MOVE #-4[.IX], #-9[.IX]
WRINT #-9[.IX] 
WRCHAR #10 
WRSTR /L_8 
L_FIN_FUN_3: HALT
L_3: DATA "*** INVOCACION DE SUBPROGRAMAS***\n"
L_6: DATA "w (2) = \n"
L_8: DATA "FIN\n"
