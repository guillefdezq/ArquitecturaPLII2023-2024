; Quadruple - [VARLOCAL z, 0, null]
MOVE #0, /10000
; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [INL L_decrementa, null, null]
L_decrementa: NOP

; Quadruple - [VARSUBPROGRAMA x, -4, null]
MOVE #-4[.IX], #-6[.IX]
; Quadruple - [PUNTERO_FUNCION 9, null, null]
SUB .IX, #9
MOVE .A, .SP

; Quadruple - [MV T_0, x, null]
MOVE #-6[.IX], #-7[.IX]
; Quadruple - [ADD T_1, T_0, 1]
ADD #-7[.IX], #1
MOVE .A , #-8[.IX]

; Quadruple - [DEVUELTO L_FIN_decrementa, T_1, null]
MOVE #-8[.IX], #-0[.IX]
BR /L_FIN_decrementa    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_FUNCION L_FIN_decrementa, 6, null]
L_FIN_decrementa: NOP
SUB .IX, #6
MOVE .A, .SP
RET




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL 10, null, null]
SUB .IX, #10
MOVE .A, .SP

; Quadruple - [VARLOCAL w, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [WRSTR L_3, null, null]
WRSTR /L_3 

; Quadruple - [INICIO_FUNCION null, null, null]
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aqui IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [CONTROL null, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX

; Quadruple - [INICIO_FUNCION null, null, null]
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aqui IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [CONTROL null, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX

; Quadruple - [CONTROL null, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX

; Quadruple - [INICIO_FUNCION null, null, null]
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aqui IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [CONTROL null, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX

; Quadruple - [MV T_0, 3, null]
MOVE #3, #-5[.IX]
; Quadruple - [PARAM T_0, null, null]
PUSH #-5[.IX]

; Quadruple - [CONTROL null, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX

; Quadruple - [CALL L_decrementa, null, null]
CALL /L_decrementa            ; Guarda PC y salta
MOVE #0[.IX], .R9     ; Guarda retorno
MOVE #-1[.IX], .SP    ; Restaura enlace de control
MOVE #-1[.IX], .IY    ; Restaura enlace de control
MOVE #-2[.IX], .SR    ; Restaura estado maquina
MOVE #-3[.IX], .IX    ; Restaura enlace de acceso
; Puede que algo este mal configurado...
; Necesario: Recuperacion de la pila a su sitio original

; Quadruple - [VALOR_RETORNO T_1, null, null]
MOVE .R9, #-6[.IX]

; Quadruple - [PARAM T_1, null, null]
PUSH #-6[.IX]

; Quadruple - [CALL L_decrementa, null, null]
CALL /L_decrementa            ; Guarda PC y salta
MOVE #0[.IX], .R9     ; Guarda retorno
MOVE #-1[.IX], .SP    ; Restaura enlace de control
MOVE #-1[.IX], .IY    ; Restaura enlace de control
MOVE #-2[.IX], .SR    ; Restaura estado maquina
MOVE #-3[.IX], .IX    ; Restaura enlace de acceso
; Puede que algo este mal configurado...
; Necesario: Recuperacion de la pila a su sitio original

; Quadruple - [VALOR_RETORNO T_2, null, null]
MOVE .R9, #-7[.IX]

; Quadruple - [PARAM T_2, null, null]
PUSH #-7[.IX]

; Quadruple - [CALL L_decrementa, null, null]
CALL /L_decrementa            ; Guarda PC y salta
MOVE #0[.IX], .R9     ; Guarda retorno
MOVE #-1[.IX], .SP    ; Restaura enlace de control
MOVE #-1[.IX], .IY    ; Restaura enlace de control
MOVE #-2[.IX], .SR    ; Restaura estado maquina
MOVE #-3[.IX], .IX    ; Restaura enlace de acceso
; Puede que algo este mal configurado...
; Necesario: Recuperacion de la pila a su sitio original

; Quadruple - [VALOR_RETORNO T_3, null, null]
MOVE .R9, #-8[.IX]

; Quadruple - [MV w, T_3, null]
MOVE #-8[.IX], #-4[.IX]
; Quadruple - [WRSTR L_7, null, null]
WRSTR /L_7 

; Quadruple - [MV T_4, w, null]
MOVE #-4[.IX], #-9[.IX]
; Quadruple - [WRINT T_4, null, null]
WRINT #-9[.IX] 
WRCHAR #10 

; Quadruple - [WRSTR L_9, null, null]
WRSTR /L_9 

; Quadruple - [FIN_PRINCIPAL L_FIN_principal, null, null]
L_FIN_principal: HALT

; Quadruple - [CADENA *** INVOCACION DE SUBPROGRAMAS***\n, L_3, null]
L_3: DATA "*** INVOCACION DE SUBPROGRAMAS***\n"
; Quadruple - [CADENA w (w(3)) = 6? \n, L_7, null]
L_7: DATA "w (w(3)) = 6? \n"
; Quadruple - [CADENA FIN\n, L_9, null]
L_9: DATA "FIN\n"
