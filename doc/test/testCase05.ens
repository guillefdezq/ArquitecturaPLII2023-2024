; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_17, 23, null]
SUB .IX, #23
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 0, null]
MOVE #0, #-4[.IX]
; Quadruple - [VARLOCAL b, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [MV T_0, 19, null]
MOVE #19, #-6[.IX]
; Quadruple - [MV b, T_0, null]
MOVE #-6[.IX], #-5[.IX]
; Quadruple - [MV T_1, b, null]
MOVE #-5[.IX], #-7[.IX]
; Quadruple - [ADD T_2, T_1, 1]
ADD #-7[.IX], #1
MOVE .A , #-8[.IX]

; Quadruple - [MV a, T_2, null]
MOVE #-8[.IX], #-4[.IX]
; Quadruple - [MV T_3, a, null]
MOVE #-4[.IX], #-9[.IX]
; Quadruple - [MV T_4, 1, null]
MOVE #1, #-10[.IX]
; Quadruple - [ADD T_5, T_3, T_4]
ADD #-9[.IX], #-10[.IX]
MOVE .A , #-11[.IX]

; Quadruple - [MV T_6, 6, null]
MOVE #6, #-12[.IX]
; Quadruple - [MV T_7, 2, null]
MOVE #2, #-13[.IX]
; Quadruple - [MUL T_8, T_6, T_7]
MUL #-12[.IX], #-13[.IX]
MOVE .A , #-14[.IX]

; Quadruple - [ADD T_9, T_5, T_8]
ADD #-11[.IX], #-14[.IX]
MOVE .A , #-15[.IX]

; Quadruple - [MV a, T_9, null]
MOVE #-15[.IX], #-4[.IX]
; Quadruple - [WRSTR L_0, null, null]
WRSTR /L_0 

; Quadruple - [MV T_10, a, null]
MOVE #-4[.IX], #-16[.IX]
; Quadruple - [WRINT T_10, null, null]
WRINT #-16[.IX] 
WRCHAR #10 

; Quadruple - [MV T_11, 3, null]
MOVE #3, #-17[.IX]
; Quadruple - [MV T_12, 3, null]
MOVE #3, #-18[.IX]
; Quadruple - [ADD T_13, T_11, T_12]
ADD #-17[.IX], #-18[.IX]
MOVE .A , #-19[.IX]

; Quadruple - [MV T_14, 2, null]
MOVE #2, #-20[.IX]
; Quadruple - [MUL T_15, T_13, T_14]
MUL #-19[.IX], #-20[.IX]
MOVE .A , #-21[.IX]

; Quadruple - [MV a, T_15, null]
MOVE #-21[.IX], #-4[.IX]
; Quadruple - [WRSTR L_2, null, null]
WRSTR /L_2 

; Quadruple - [MV T_16, a, null]
MOVE #-4[.IX], #-22[.IX]
; Quadruple - [WRINT T_16, null, null]
WRINT #-22[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO L_FIN_FUN_1, null, null]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_FUN_1, null, null]
L_FIN_FUN_1: HALT

; Quadruple - [CADENA a\n, L_0, null]
L_0: DATA "a\n"
; Quadruple - [CADENA asociacion parentesis\n, L_2, null]
L_2: DATA "asociacion parentesis\n"
