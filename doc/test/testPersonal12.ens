; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [INL L_factorial, null, null]
L_factorial: NOP

; Quadruple - [VARSUBPROGRAMA n, -4, null]
MOVE #-4[.IX], #-8[.IX]
; Quadruple - [PUNTERO_FUNCION 21, null, null]
SUB .IX, #21
MOVE .A, .SP

; Quadruple - [VARLOCAL resultado, 1, null]
MOVE #1, #-6[.IX]
; Quadruple - [VARLOCAL i, 1, null]
MOVE #1, #-7[.IX]
; Quadruple - [INL L_0, null, null]
L_0: NOP

; Quadruple - [MV T_0, i, null]
MOVE #-7[.IX], #-9[.IX]
; Quadruple - [MV T_1, n, null]
MOVE #-8[.IX], #-10[.IX]
; Quadruple - [MV T_2, 1, null]
MOVE #1, #-11[.IX]
; Quadruple - [ADD T_3, T_1, T_2]
ADD #-10[.IX], #-11[.IX]
MOVE .A , #-12[.IX]

; Quadruple - [LS T_4, T_0, T_3]
CMP #-9[.IX], #-12[.IX]
BZ /L_10
BP /L_10
L_9: MOVE #1, #-13[.IX]
BR /L_11
L_10: MOVE #0, #-13[.IX]
L_11: NOP

; Quadruple - [BZ T_4, L_1, null]
CMP #-13[.IX], #0
BZ /L_1

; Quadruple - [MV T_0, resultado, null]
MOVE #-6[.IX], #-15[.IX]
; Quadruple - [MV T_1, i, null]
MOVE #-7[.IX], #-16[.IX]
; Quadruple - [MUL T_2, T_0, T_1]
MUL #-15[.IX], #-16[.IX]
MOVE .A , #-17[.IX]

; Quadruple - [MV resultado, T_2, null]
MOVE #-17[.IX], #-6[.IX]
; Quadruple - [MV T_3, i, null]
MOVE #-7[.IX], #-18[.IX]
; Quadruple - [MV T_4, 1, null]
MOVE #1, #-19[.IX]
; Quadruple - [ADD T_5, T_3, T_4]
ADD #-18[.IX], #-19[.IX]
MOVE .A , #-20[.IX]

; Quadruple - [MV i, T_5, null]
MOVE #-20[.IX], #-7[.IX]
; Quadruple - [BR L_0, null, null]
BR /L_0

; Quadruple - [INL L_1, null, null]
L_1: NOP

; Quadruple - [MV T_5, resultado, null]
MOVE #-6[.IX], #-14[.IX]
; Quadruple - [DEVUELTO L_FIN_factorial, T_5, null]
MOVE #-14[.IX], #-0[.IX]
BR /L_FIN_factorial    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_FUNCION L_FIN_factorial, 6, null]
L_FIN_factorial: NOP
SUB .IX, #6
MOVE .A, .SP
RET




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL 9, null, null]
SUB .IX, #9
MOVE .A, .SP

; Quadruple - [VARLOCAL num, 5, null]
MOVE #5, #-4[.IX]
; Quadruple - [VARLOCAL resultadoFactorial, 0, null]
MOVE #0, #-5[.IX]
; Quadruple - [INICIO_FUNCION null, null, null]
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aqui IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [MV T_0, num, null]
MOVE #-4[.IX], #-6[.IX]
; Quadruple - [PARAM T_0, null, null]
PUSH #-6[.IX]

; Quadruple - [CONTROL null, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX

; Quadruple - [CALL L_factorial, null, null]
CALL /L_factorial            ; Guarda PC y salta
MOVE #0[.IX], .R9     ; Guarda retorno
MOVE #-1[.IX], .SP    ; Restaura enlace de control
MOVE #-1[.IX], .IY    ; Restaura enlace de control
MOVE #-2[.IX], .SR    ; Restaura estado maquina
MOVE #-3[.IX], .IX    ; Restaura enlace de acceso
; Puede que algo este mal configurado...
; Necesario: Recuperacion de la pila a su sitio original

; Quadruple - [VALOR_RETORNO T_1, null, null]
MOVE .R9, #-7[.IX]

; Quadruple - [MV resultadoFactorial, T_1, null]
MOVE #-7[.IX], #-5[.IX]
; Quadruple - [MV T_2, resultadoFactorial, null]
MOVE #-5[.IX], #-8[.IX]
; Quadruple - [WRINT T_2, null, null]
WRINT #-8[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO L_FIN_principal, null, null]
BR /L_FIN_principal    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_principal, null, null]
L_FIN_principal: HALT

