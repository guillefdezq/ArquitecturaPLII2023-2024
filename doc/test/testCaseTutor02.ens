; Quadruple - [AXIOM null, null, null]
AXIOM: NOP
BR /PRINCIPAL

; Quadruple - [VARGLOBAL NUM, 0, null]
; sin declarar?

; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en R0
PUSH #-1       ;valor de retorno
PUSH .IX       ;enlace de control
PUSH .SR       ;estado mÃ¡quina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL T_5, 11, null]
SUB .IX, #11
MOVE .A, .SP

; Quadruple - [VARLOCAL a, 30, null]
MOVE #30, #-5[.IX]
; Quadruple - [MV T_0, a, null]
MOVE #-5[.IX], #-6[.IX]
; Quadruple - [MV T_1, a, null]
MOVE #-5[.IX], #-7[.IX]
; Quadruple - [EQ T_2, T_0, T_1]
CMP #-6[.IX], #-7[.IX]
BZ /L_5
BNZ /L_6
L_5: MOVE #1, #-8[.IX]
BR /L_7
L_6: MOVE #0, #-8[.IX]
L_7: NOP

; Quadruple - [BRF T_2, L_1, null]
CMP #-8[.IX], #0
BZ /L_1

; Quadruple - [MV T_0, 37, null]
MOVE #37, #-11[.IX]
; Quadruple - [MV a, T_0, null]
MOVE #-11[.IX], #-5[.IX]
; Quadruple - [BR L_0, null, null]
BR /L_0

; Quadruple - [INL L_1, null, null]
L_1: NOP

; Quadruple - [MV T_0, 57, null]
MOVE #57, #-12[.IX]
; Quadruple - [MV a, T_0, null]
MOVE #-12[.IX], #-5[.IX]
; Quadruple - [INL L_0, null, null]
L_0: NOP

; Quadruple - [MV T_3, a, null]
MOVE #-5[.IX], #-9[.IX]
; Quadruple - [WRINT T_3, null, null]
WRINT #-9[.IX] 
WRCHAR #10 

; Quadruple - [DEVUELTO L_FIN_FUN_1, null, null]
BR /L_FIN_FUN_1    ;rescata de la pila el contenido del contador de programa

; Quadruple - [FIN_PRINCIPAL L_FIN_FUN_1, null, null]
L_FIN_FUN_1: HALT

