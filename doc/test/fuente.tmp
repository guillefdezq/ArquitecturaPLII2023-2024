; Quadruple - [VARLOCAL mayor, 0, null]
; sin declarar

; Quadruple - [VARLOCAL menor, 0, null]
; sin declarar

; Quadruple - [MV T_0, 17, null]
MOVE #17, #-6[.IX]
; Quadruple - [MV menor, T_0, null]
MOVE #-6[.IX], #-5[.IX]
; Quadruple - [MV T_1, 19, null]
MOVE #19, #-7[.IX]
; Quadruple - [MV mayor, T_1, null]
MOVE #-7[.IX], #-4[.IX]
; Quadruple - [MV T_2, menor, null]
MOVE #-5[.IX], #-8[.IX]
; Quadruple - [MV T_3, mayor, null]
MOVE #-4[.IX], #-9[.IX]
; Quadruple - [LS T_4, T_2, T_3]
CMP #-8[.IX], #-9[.IX]
BNZ /L_6
BN /L_6
BZ /L_7
BP /L_7
L_6: MOVE #1, #-10[.IX]
BR /L_8
L_7: MOVE #0, #-10[.IX]
L_8: NOP

; Quadruple - [BRF T_4, L_1, null]
CMP #-10[.IX], #0
BZ /L_1

; Quadruple - [WRSTR T_0, L_0, null]
WRSTR /L_0 

; Quadruple - [INL L_1, null, null]
L_1: NOP

; Quadruple - [MV T_5, mayor, null]
MOVE #-4[.IX], #-11[.IX]
; Quadruple - [MV T_6, menor, null]
MOVE #-5[.IX], #-12[.IX]
; Quadruple - [LS T_7, T_5, T_6]
CMP #-11[.IX], #-12[.IX]
BNZ /L_9
BN /L_9
BZ /L_10
BP /L_10
L_9: MOVE #1, #-13[.IX]
BR /L_11
L_10: MOVE #0, #-13[.IX]
L_11: NOP

; Quadruple - [BRF T_7, L_4, null]
CMP #-13[.IX], #0
BZ /L_4

; Quadruple - [WRSTR T_0, L_3, null]
WRSTR /L_3 

; Quadruple - [INL L_4, null, null]
L_4: NOP

; Quadruple - [DEVUELTO null, null, null]
HALT

; Quadruple - [CADENA tautologia\n, L_0, null]
L_0: DATA "tautologia\n"
; Quadruple - [CADENA contradiccion\n, L_3, null]
L_3: DATA "contradiccion\n"

