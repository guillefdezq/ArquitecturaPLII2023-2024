; Quadruple - [VARLOCAL c, 9, null]
MOVE #9, /10000
; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
; Por implementar correctamente, relacionado con subprogramas
MOVE .SP, .IX  ;guarda el valor de SP en IX
MOVE .IX, .IY  ;guarda el valor de IX en IY
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [PUNTERO_PRINCIPAL 42, null, null]
SUB .IX, #42
MOVE .A, .SP

; Quadruple - [VARLOCALVECTOR a, 7, null]
; sin declarar?

; Quadruple - [VARLOCAL b, 8, null]
MOVE #8, #-11[.IX]
; Quadruple - [VARLOCAL indice, 0, null]
MOVE #0, #-12[.IX]
; Quadruple - [MV T_0, 1, null]
MOVE #1, #-13[.IX]
; Quadruple - [MV T_2, 5, null]
MOVE #5, #-15[.IX]
; Quadruple - [STV a, T_2, T_0]
ADD #4, #-13[.IX]
SUB .IX, .A
MOVE #-15[.IX], [.A]

; Quadruple - [ADD b, b, 1]
ADD #-11[.IX], #1
MOVE .A , #-11[.IX]

; Quadruple - [ADD c, c, 1]
ADD /10000, #1
MOVE .A , /10000

; Quadruple - [MV T_3, b, null]
MOVE #-11[.IX], #-16[.IX]
; Quadruple - [WRINT T_3, null, null]
WRINT #-16[.IX] 
WRCHAR #10 

; Quadruple - [MV T_4, c, null]
MOVE /10000, #-17[.IX]
; Quadruple - [WRINT T_4, null, null]
WRINT #-17[.IX] 
WRCHAR #10 

; Quadruple - [MV T_5, 0, null]
MOVE #0, #-18[.IX]
; Quadruple - [MVV T_6, a, T_5]
ADD #4, #-18[.IX]
SUB .IX, .A
MOVE [.A], #-19[.IX]

; Quadruple - [MV T_7, 1, null]
MOVE #1, #-20[.IX]
; Quadruple - [ADD T_8, T_6, T_7]
ADD #-19[.IX], #-20[.IX]
MOVE .A , #-21[.IX]

; Quadruple - [WRINT T_8, null, null]
WRINT #-21[.IX] 
WRCHAR #10 

; Quadruple - [MV T_9, 1, null]
MOVE #1, #-22[.IX]
; Quadruple - [MVV T_10, a, T_9]
ADD #4, #-22[.IX]
SUB .IX, .A
MOVE [.A], #-23[.IX]

; Quadruple - [MV T_11, 1, null]
MOVE #1, #-24[.IX]
; Quadruple - [ADD T_12, T_10, T_11]
ADD #-23[.IX], #-24[.IX]
MOVE .A , #-25[.IX]

; Quadruple - [WRINT T_12, null, null]
WRINT #-25[.IX] 
WRCHAR #10 

; Quadruple - [MV T_13, 2, null]
MOVE #2, #-26[.IX]
; Quadruple - [MVV T_14, a, T_13]
ADD #4, #-26[.IX]
SUB .IX, .A
MOVE [.A], #-27[.IX]

; Quadruple - [MV T_15, 1, null]
MOVE #1, #-28[.IX]
; Quadruple - [ADD T_16, T_14, T_15]
ADD #-27[.IX], #-28[.IX]
MOVE .A , #-29[.IX]

; Quadruple - [WRINT T_16, null, null]
WRINT #-29[.IX] 
WRCHAR #10 

; Quadruple - [WRSTR L_5, null, null]
WRSTR /L_5 

; Quadruple - [INL L_11, null, null]
L_11: NOP

; Quadruple - [MV T_17, indice, null]
MOVE #-12[.IX], #-30[.IX]
; Quadruple - [MV T_18, 7, null]
MOVE #7, #-31[.IX]
; Quadruple - [LS T_19, T_17, T_18]
CMP #-30[.IX], #-31[.IX]
BZ /L_15
BP /L_15
L_14: MOVE #1, #-32[.IX]
BR /L_16
L_15: MOVE #0, #-32[.IX]
L_16: NOP

; Quadruple - [BZ T_19, L_12, null]
CMP #-32[.IX], #0
BZ /L_12

; Quadruple - [MV T_0, indice, null]
MOVE #-12[.IX], #-33[.IX]
; Quadruple - [MV T_1, 4, null]
MOVE #4, #-34[.IX]
; Quadruple - [LS T_2, T_0, T_1]
CMP #-33[.IX], #-34[.IX]
BZ /L_18
BP /L_18
L_17: MOVE #1, #-35[.IX]
BR /L_19
L_18: MOVE #0, #-35[.IX]
L_19: NOP

; Quadruple - [MV T_3, indice, null]
MOVE #-12[.IX], #-36[.IX]
; Quadruple - [MV T_4, 7, null]
MOVE #7, #-37[.IX]
; Quadruple - [LS T_5, T_3, T_4]
CMP #-36[.IX], #-37[.IX]
BZ /L_21
BP /L_21
L_20: MOVE #1, #-38[.IX]
BR /L_22
L_21: MOVE #0, #-38[.IX]
L_22: NOP

; Quadruple - [AND T_6, T_2, T_5]
CMP #-35[.IX], #0
BZ /L_24
BNZ /L_23
L_23: MOVE #1, .R0
BR /L_25
L_24: MOVE #0, .R0
L_25: NOP
CMP #-38[.IX], #0
BZ /L_27
BNZ /L_26
L_26: MOVE #1, .R1
BR /L_28
L_27: MOVE #0, .R1
L_28: NOP
AND .R0, .R1
CMP .A, #1
BZ /L_29
BNZ /L_30
L_29: MOVE #1, #-39[.IX]
BR /L_31
L_30: MOVE #0, #-39[.IX]
L_31: NOP

; Quadruple - [NEG T_7, T_6, null]
CMP #-39[.IX], #0
BZ /L_32
BNZ /L_33
L_32: MOVE #1, #-40[.IX]
BR /L_34
L_33: MOVE #0, #-40[.IX]
L_34: NOP

; Quadruple - [BZ T_7, L_9, null]
CMP #-40[.IX], #0
BZ /L_9

; Quadruple - [WRSTR L_6, null, null]
WRSTR /L_6 

; Quadruple - [BR L_8, null, null]
BR /L_8

; Quadruple - [INL L_9, null, null]
L_9: NOP

; Quadruple - [WRSTR L_7, null, null]
WRSTR /L_7 

; Quadruple - [INL L_8, null, null]
L_8: NOP

; Quadruple - [MV T_8, indice, null]
MOVE #-12[.IX], #-41[.IX]
; Quadruple - [WRINT T_8, null, null]
WRINT #-41[.IX] 
WRCHAR #10 

; Quadruple - [ADD indice, indice, 1]
ADD #-12[.IX], #1
MOVE .A , #-12[.IX]

; Quadruple - [BR L_11, null, null]
BR /L_11

; Quadruple - [INL L_12, null, null]
L_12: NOP

; Quadruple - [FIN_PRINCIPAL L_FIN_principal, null, null]
L_FIN_principal: HALT

; Quadruple - [CADENA Entro en Loop\n, L_5, null]
L_5: DATA "Entro en Loop\n"
; Quadruple - [CADENA Entre 6 y 4\n, L_6, null]
L_6: DATA "Entre 6 y 4\n"
; Quadruple - [CADENA Otro loop\n, L_7, null]
L_7: DATA "Otro loop\n"

