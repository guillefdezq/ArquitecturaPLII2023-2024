/* MI CASO DE PRUEBA EXPERIMENTAL */

#constante otra 420;

vacio hola () {
    entero todo;
    entero mal;
    mientras (todo < 5) {
        mientras (mal < 4) {
            escribeEnt(mal);
            mal++;
        }
    }
    devuelve;
}

vacio principal () {
    
    entero a;
    entero b;
    a = 3;

    mientras (a < 5) {
        b = 0;
        mientras (b < 3) {
            escribeEnt(b);
            b++;
        }

        escribeEnt(a);
        a++;
    }

    devuelve;

}