/* MI CASO DE PRUEBA EXPERIMENTAL */

#constante otra 420;

vacio hola () {
    entero todo;
    entero mal;
    mientras (todo < 5) {
        mal = 0;
        mientras (mal < 4) {
            entero a;
            escribeEnt(mal);
            mal++;
        }
        todo++;
    }
    devuelve;
}

vacio principal () {
    
    entero nada;
    entero bien;
    mientras (nada  < 5) {
        bien = 0;
        mientras (bien < 4) {
            entero b;
            escribeEnt(bien);
            bien++;
        }
        nada++;
    }
    
    escribe("SEPARACION");

    hola();

    devuelve;

}