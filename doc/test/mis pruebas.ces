/* MI CASO DE PRUEBA EXPERIMENTAL */

#constante verano 3;


vacio principal () {

si (1&&1) {
    escribe("TT=T pasado");
} sino {
    escribe("TT=T error");
}

si (1&&0) {
    escribe("TF=F error");
} sino {
    escribe("TF=F pasado");
}

si (0&&1) {
    escribe("FT=T error");
} sino {
    escribe("FT=T pasado");
}

si (0&&0) {
    escribe("FF=F error");
} sino {
    escribe("FF=F pasado");
}

si (5&&2) {
    escribe("tautologia especial pasada");
} sino {
    escribe("tautologia especial error");
}

si (3&&0) {
    escribe("contradiccion especial error");
} sino {
    escribe("contradiccion especial pasada");
}

devuelve;

}