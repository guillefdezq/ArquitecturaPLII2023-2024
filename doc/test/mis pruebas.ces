/* MI CASO DE PRUEBA EXPERIMENTAL */

vacio principal () {

entero test = 0;
entero prueba;

mientras (test < 3) {
    

    alternativas (test) {
        caso 0: 
        {
            prueba = 0;
        }
            corte;
        caso 1:
        {
            prueba = 1;
        }
            corte;
        pordefecto:
        {
            prueba =  69;
        }
            corte;
    }

    test++;

}

devuelve;

}