/* MI CASO DE PRUEBA EXPERIMENTAL */

#constante verano 3;


vacio principal () {

entero estacion;
estacion = 1;

escribe("Que lo que?");
estacion += 1;
escribe("Estamos a rulay");
estacion += 1;

si (estacion == verano) {
    escribe("Empezo el verano!");
    escribe("FUEEGOO!!!");
}

devuelve;

}