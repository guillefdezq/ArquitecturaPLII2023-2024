MOVE #-10[.IX], #-23[.IX]
; Quadruple - [ADD T_11, T_9, T_10]
ADD #-22[.IX], #-23[.IX]
MOVE .A , #-24[.IX]

; Quadruple - [PARAM T_11, null, null]
PUSH #-24[.IX]

; Quadruple - [CALL L_printfibo, null, null]
MOVE .IY, .IX         ; Guarda el valor de IY en IX
CALL /L_printfibo            ; Guarda PC y salta
MOVE #0[.IX], .R9     ; Guarda retorno
MOVE #-1[.IX], .SP    ; Restaura enlace de control
MOVE #-3[.IX], .IX    ; Restaura enlace de acceso
; Puede que algo este mal configurado...
; Necesario: Recuperacion de la pila a su sitio original

; Quadruple - [INL L_2, null, null]
L_2: NOP

; Quadruple - [DEVUELTO L_FIN_printfibo, null, null]
