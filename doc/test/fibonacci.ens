MOVE #-6[.IX], #-11[.IX]
; Quadruple - [VARSUBPROGRAMA val2, -7, null]
MOVE #-7[.IX], #-10[.IX]
; Quadruple - [PUNTERO_FUNCION 26, null, null]
SUB .IX, #26
MOVE .A, .SP

; Quadruple - [MV T_0, val2, null]
MOVE #-10[.IX], #-13[.IX]
; Quadruple - [WRINT T_0, null, null]
WRINT #-13[.IX] 
WRCHAR #10 

; Quadruple - [MV T_1, i, null]
MOVE #-12[.IX], #-14[.IX]
; Quadruple - [MV T_2, endi, null]
MOVE #-9[.IX], #-15[.IX]
; Quadruple - [LS T_3, T_1, T_2]
CMP #-14[.IX], #-15[.IX]
BZ /L_10
BP /L_10
L_9: MOVE #1, #-16[.IX]
BR /L_11
L_10: MOVE #0, #-16[.IX]
L_11: NOP

; Quadruple - [BZ T_3, L_2, null]
CMP #-16[.IX], #0
BZ /L_2

; Quadruple - [INICIO_FUNCION null, null, null]
MOVE .SP, .IY  ;guarda el valor de SP en IY para guardar EC y establecer aquÃ­ IX(nuevo EA)
PUSH #-1       ;valor de retorno
PUSH .IY       ;enlace de control
PUSH .SR       ;estado maquina
PUSH .IX       ;enlace de acceso

; Quadruple - [MV T_4, i, null]
MOVE #-12[.IX], #-17[.IX]
; Quadruple - [MV T_5, 1, null]
MOVE #1, #-18[.IX]
; Quadruple - [ADD T_6, T_4, T_5]
ADD #-17[.IX], #-18[.IX]
MOVE .A , #-19[.IX]

; Quadruple - [PARAM T_6, null, null]
PUSH #-19[.IX]

; Quadruple - [MV T_7, endi, null]
MOVE #-9[.IX], #-20[.IX]
; Quadruple - [PARAM T_7, null, null]
PUSH #-20[.IX]

; Quadruple - [MV T_8, val2, null]
MOVE #-10[.IX], #-21[.IX]
