; Quadruple - [AXIOM null, null, null]
AXIOM: BR /PRINCIPAL


; Quadruple - [INL L_printfibo, null, null]
L_printfibo: NOP

; Quadruple - [VARSUBPROGRAMA i, -4, null]
MOVE #-4[.IX], #-12[.IX]
; Quadruple - [VARSUBPROGRAMA endi, -5, null]
MOVE #-5[.IX], #-9[.IX]
