; Quadruple - [FIN_FUNCION L_FIN_printfibo, 9, null]
L_FIN_printfibo: NOP
SUB .IX, #9
MOVE .A, .SP
RET




; Quadruple - [PRINCIPAL null, null, null]
PRINCIPAL: NOP
