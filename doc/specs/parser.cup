sentenciaIncremento ::= IDENTIFICADOR:iden AUTO_INCREMENTO SEMI_COLON {: System.out.println("READ> sentenciaIncremento"); 
		
		String nombre = (String) iden.getLexema();
		SymbolIF sym = (SymbolIF) scopeManager.searchSymbol(nombre);
		SymbolVariable vari = (SymbolVariable) sym;

		if (sym.getType() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("No se puede incrementar una variable de tipo " + sym.getType().getName() + ", únicamente enteros.");
		}
		if (!(sym instanceof SymbolVariable)) {
			semanticErrorManager.semanticFatalError("Sólamente se pueden incrementar variables, no constantes u otro tipo.");
		}

		String valor = vari.getValor() + 1;
		// vari.setValor(Integer.toString((Integer.parseInt(valor) + 1)));   // Linea deshabilitada porque causa conflictos a la hora de funcionar


		// Código intermedio
		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();
		
		Sentencia sentencia = new Sentencia();

		// Lo que debería hacer:
		// obtener valor
		Variable variable = new Variable(((SymbolVariable)vari).getName(), sym.getScope());
		Value value = new Value(Integer.parseInt("1"));

		// Pueda que se pueda hacer más simple todavía con una línea, pero Keep It Stupid Simple...
			intermediateCodeBuilder.addQuadruple("ADD", variable, variable, value);
			

		sentencia.setIntermediateCode(intermediateCodeBuilder.create());


		System.out.println("SN++> " + vari.getName() + " = " + valor);
		
		RESULT = sentencia;
		
		 :};

sentenciaAsignacion ::= ref:ref ASSIGN expresion:exp SEMI_COLON {: System.out.println("READ> sentenciaAsignacion"); 

		Sentenciaasignacion sentenciaAsignacion = new Sentenciaasignacion();

		Expresion expr = (Expresion) exp;


		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);



		// dividir en instancias de expresión o símbolo

		if (ref instanceof SymbolIF) {			// código del identificadores
			SymbolIF sym = (SymbolIF) ref;
			if (!(sym instanceof SymbolVariable)) {
				semanticErrorManager.semanticFatalError("No se puede asignar un valor a una variable de tipo " + sym.getType().getName());
			}

			if (sym.getType() != scopeManager.searchType("ENTERO")) {
				semanticErrorManager.semanticFatalError("No se puede incrementar una variable de tipo " + sym.getType().getName() + ", únicamente enteros.");
			}

			SymbolVariable vari = (SymbolVariable) sym;

			if (sym.getType() != expr.getTipo()) {
				semanticErrorManager.semanticFatalError("No se puede asignar un valor de tipo " + expr.getTipo().getName() + " a una variable de tipo " + sym.getType().getName());
			}
			
			Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
			intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("MV", variable, expr.getTemporal());

			//vari.setValor(expr.getValor());
			System.out.println("ASIG> " + vari.getName() + " = " + expr.getValor());

		} else if (ref instanceof Expresion) {			// código del vector
			Expresion refexpr = (Expresion) ref;
			SymbolIF sym = (SymbolIF) scopeManager.searchSymbol(refexpr.getNombreVector());
			if(sym.getType() instanceof TypeArray) {
				SymbolVariable vari = (SymbolVariable) sym;

				/*  Tipo de comprobación invalidada, se utilizará cuádrupla
				int indice = refexpr.getIndice();
				if (vari.getType().getSize() < indice) {
					semanticErrorManager.semanticFatalError("La variable " + refexpr.getNombreVector() + " no tiene tantos elementos. Equivalente a un IndexOutOfBoundsException.");
				}
				*/

				String[] vector = vari.getValor().split(",");
				String valorAGuardar = expr.getValor();
				int indice = 0;  // está claro que no es esta la posición, pero debido a cambios, este valor es un señuelo
				vector[indice] = valorAGuardar;
				String nuevoVector = String.join(",", vector);
				System.out.println(nuevoVector);

				//vari.setValor(nuevoVector);

				Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
				intermediateCodeBuilder.addQuadruples(refexpr.getIntermediateCode());
				intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
				intermediateCodeBuilder.addQuadruple("STP", variable, expr.getTemporal(), refexpr.getIndice());

				System.out.println("ASIG> vector " + vari.getName() + "[" + indice + "] = " + valorAGuardar);
			} else {
				semanticErrorManager.semanticFatalError("Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto.");
			}

		} else { semanticErrorManager.semanticFatalError("Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto."); }

		sentenciaAsignacion.setIntermediateCode(intermediateCodeBuilder.create());
		System.out.println("     QUAD>" + expr.getIntermediateCode());  
		RESULT = sentenciaAsignacion; 
		:};
ref ::= IDENTIFICADOR:ident {: System.out.println("READ> ref"); 
		if (!(scopeManager.containsSymbol(ident.getLexema()))) {
			semanticErrorManager.semanticFatalError("No se encuentra la variable " + ident.getLexema());
		}
		SymbolIF symbol = scopeManager.searchSymbol(ident.getLexema());
		RESULT = symbol; :}
 | accesoVector:exp {: 
		RESULT = exp;	// Paso directamente la expresión
 		 :};

sentenciaAsignacionSuma ::= ref:ref ASSIGN_SUMA expresion:exp SEMI_COLON {: System.out.println("READ> sentenciaAsignacionSuma");
		Expresion expr = (Expresion) exp;
		Sentencia sen = new Sentencia();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());

		// dividir en instancias de expresión o símbolo

		if (ref instanceof SymbolIF) {			// código del identificadores
			SymbolIF sym = (SymbolIF) ref;
			if (!(sym instanceof SymbolVariable)) {
				semanticErrorManager.semanticFatalError("No se puede asignar un valor a una variable de tipo " + sym.getType().getName());
			}

			if (sym.getType() != scopeManager.searchType("ENTERO")) {
				semanticErrorManager.semanticFatalError("No se puede incrementar una variable de tipo " + sym.getType().getName() + ", únicamente enteros.");
			}

			SymbolVariable vari = (SymbolVariable) sym;

			if (sym.getType() != expr.getTipo()) {
				semanticErrorManager.semanticFatalError("No se puede asignar un valor de tipo " + expr.getTipo().getName() + " a una variable de tipo " + sym.getType().getName());
			}
			//vari.setValor(expr.getValor());

			Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
			intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruple("ADD", variable, variable, expr.getTemporal());
			//intermediateCodeBuilder.addQuadruple("MV", variable, expr.getTemporal());		// Modificar

			System.out.println("ASIG> " + vari.getName() + " = " + expr.getValor());

		} else if (ref instanceof Expresion) {			// código del vector
			Expresion refexpr = (Expresion) ref;
			SymbolIF sym = (SymbolIF) scopeManager.searchSymbol(refexpr.getNombreVector());
			if(sym.getType() instanceof TypeArray) {
				SymbolVariable vari = (SymbolVariable) sym;

				/*  Tipo de comprobación invalidada, se utilizará cuádrupla
				int indice = refexpr.getIndice();
				if (vari.getType().getSize() < indice) {
					semanticErrorManager.semanticFatalError("La variable " + refexpr.getNombreVector() + " no tiene tantos elementos. Equivalente a un IndexOutOfBoundsException.");
				}
				*/

				String[] vector = vari.getValor().split(",");
				String valorAGuardar = Integer.toString(Integer.parseInt(expr.getValor())+Integer.parseInt(refexpr.getValor()));
				int indice = 0;  // está claro que no es esta la posición, pero debido a cambios, este valor es un señuelo
				vector[indice] = valorAGuardar;
				String nuevoVector = String.join(",", vector);
				System.out.println(nuevoVector);

				//vari.setValor(nuevoVector);

				Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
				intermediateCodeBuilder.addQuadruples(refexpr.getIntermediateCode());
				intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
				intermediateCodeBuilder.addQuadruple("ADD", variable, variable, expr.getTemporal());
				intermediateCodeBuilder.addQuadruple("STP", variable, expr.getTemporal(), refexpr.getTemporal());


				System.out.println("ASIG> vector " + variable.getName() + "[" + indice + "] = " + valorAGuardar);
			} else {
				semanticErrorManager.semanticFatalError("Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto.");
			}

		} else { semanticErrorManager.semanticFatalError("Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto."); }

		sen.setIntermediateCode(intermediateCodeBuilder.create());
		RESULT = sen; :};

// ATENTO! No hace falta poner aquí ninguna apertura o cierre de ámbito, ya lo hace sentencia con bloque.
sentenciaSi ::= SI OPEN_KEY expresion:exp CLOSE_KEY sentencia:sentsi SINO sentencia:sentsino {: System.out.println("READ> sentenciaSi + SINO"); 
		Expresion expr = (Expresion) exp;
		Sentencia sentenciasi = (Sentencia) sentsi;
		Sentencia sentenciasino = (Sentencia) sentsino;

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("No se puede comparar un valor de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}
		
		ScopeIF scope=scopeManager.getCurrentScope();
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelFinal=labelFactory.create();
		LabelIF labelElse=labelFactory.create();

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("BRF", expr.getTemporal(), labelElse);		// Ir al else si no coincide
		intermediateCodeBuilder.addQuadruples(sentenciasi.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("BR", labelFinal); //me salgo del if
		intermediateCodeBuilder.addQuadruple("INL", labelElse);
		intermediateCodeBuilder.addQuadruples(sentenciasino.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("INL", labelFinal);

		Sentenciasi sentenciasSi =new Sentenciasi(expr, sentenciasi, sentenciasino);
		sentenciasSi.setIntermediateCode(intermediateCodeBuilder.create());
		System.out.println("     QUAD>" + sentenciasSi.getIntermediateCode());  

		RESULT = sentenciasSi; :}
	 | SI OPEN_KEY expresion:exp CLOSE_KEY sentencia:sentsi {: System.out.println("READ> sentenciaSi");
		Expresion expr = (Expresion) exp;
		Sentencia sentenciasi = (Sentencia) sentsi;

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("No se puede comparar un valor de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}

		ScopeIF scope=scopeManager.getCurrentScope();
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelFinal=labelFactory.create();
		//LabelIF labelElse=labelFactory.create();

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("BRF", expr.getTemporal(), labelFinal);	// Salir si no coincide
		intermediateCodeBuilder.addQuadruples(sentenciasi.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("INL", labelFinal);

		Sentenciasi sentenciasSi =new Sentenciasi(expr, sentenciasi);
