accesoVector ::= IDENTIFICADOR:id OPEN_BRACKET expresion:exp CLOSE_BRACKET {: System.out.println("READ> accesoVector");

		ScopeIF scope = scopeManager.getCurrentScope();

		Expresion expr = (Expresion) exp;
		String identificador = id.getLexema(); 
		System.out.println(identificador);
		Expresion exprN = new Expresion();
		if(!(scopeManager.containsSymbol(identificador))) {
			semanticErrorManager.semanticFatalError("La variable " + identificador + " no existe");
		}
		
		SymbolIF symbol = scopeManager.searchSymbol(identificador);

		// Get instance of symbol
		//System.out.println(symbol.getClass());

		String numero = "";

		SymbolVariable symbolvariable = (SymbolVariable) symbol;
		if (symbol instanceof SymbolVariable) {
			if (!(symbolvariable.getType() instanceof TypeArray)) {
				semanticErrorManager.semanticFatalError("La variable " + identificador + " no es un vector.");
			}
			if (symbolvariable.getType().getSize() <= Integer.parseInt(expr.getValor())) {
				semanticErrorManager.semanticFatalError("La variable " + identificador + " no tiene tantos elementos. Rango admitido entre 0 y " + (symbolvariable.getType().getSize() - 1) + ". Equivalente a un IndexOutOfBoundsException.");
			}
			if (0 > Integer.parseInt(expr.getValor())) {
				// Estado inalcanzable: no se puede utilizar enteros negativos.
				semanticErrorManager.semanticFatalError("Imposible utilizar un indice negativo. Rango admitido entre 0 y " + (symbolvariable.getType().getSize() - 1) + ". Equivalente a un IndexOutOfBoundsException.");
			}
			exprN.setSymbolVariableIdentificador(symbolvariable);
			numero = symbolvariable.getValor().split(",")[Integer.parseInt(expr.getValor())];
		} else {
			semanticErrorManager.semanticFatalError("La variable " + identificador + " no es una variable.");
		}

		System.out.println("READ> expresion = accesoVector "+ symbol.getName() +" @pos"+ expr.getValor() +" = " + numero + " " + symbol.getType() + " ");

		exprN.setTipo(scopeManager.searchType("ENTERO"));	// Debería retirar el atributo de tipo. No se llega a utilizar.
		exprN.setValor(numero);
		//exprN.setIndice(Integer.parseInt(expr.getValor()));
		exprN.setIndice(expr.getTemporal());
		exprN.setNombreVector(identificador);
		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();
		exprN.setTemporal(temporal);

		Variable variable = new Variable(identificador, symbol.getScope());

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());
		//intermediateCodeBuilder.addQuadruple("MVP", temporal, variable, exprN.getIndice());

		exprN.setIntermediateCode(intermediateCodeBuilder.create());

		RESULT = exprN;
		 :};

// DUDA: es necesario poner aquí ámbito?
// IDEA: para los parámetros crear variables del tipo nombreFunción+Parametro+nombreParámetro o bien, crear en el no terminal un booleano que compruebe si es parámetro y su posición en la función.
llamadaFuncion ::= IDENTIFICADOR:ident OPEN_KEY parametros:params CLOSE_KEY {: System.out.println("READ> llamadaFuncion = conParametros");
		ScopeIF scope = scopeManager.getCurrentScope();

		if (!scopeManager.containsSymbol(ident.getLexema())) {
			semanticErrorManager.semanticFatalError("El identificador " + ident.getLexema() + " no existe. DEBUG: llamadafuncion");
		}
		
		SymbolIF symbol = scopeManager.searchSymbol(ident.getLexema());
		
		if (!(symbol instanceof SymbolFunction || symbol instanceof SymbolProcedure)) {
			semanticErrorManager.semanticFatalError("El identificador " + ident.getLexema() + " no es una función o procedimiento.");
		}
		
		// Borrar?
		SymbolProcedure funcion = (SymbolProcedure) symbol;
		
		ArrayList<SymbolIF> listaParametros = (ArrayList<SymbolIF>) funcion.getParameters();		// Lista de parámetros de la función
		ArrayList<Expresion> parametros = (ArrayList<Expresion>) params;		// Lista de parámetros de la declaración
		if (listaParametros.size() != parametros.size()) {
			semanticErrorManager.semanticFatalError("La función o procedimiento " + ident.getLexema() + " requiere " + listaParametros.size() + " parámetro(s)");
		}

		ArrayList<Expresion> expresionesParametro = new ArrayList<Expresion>();
		for (int i = 0; i < parametros.size(); i++) {
			Expresion parametro = parametros.get(i);
			parametro.setIdentificador(listaParametros.get(i).getName());
			expresionesParametro.add(parametro);
			System.out.println("Parametro> " + parametro.getValor() + " " + parametro.getIdentificador());
		}
		// La comprobación de introducir tipos enteros ya debería realizarse previamente (o eso creo).

		Procedure procedure = new Procedure(funcion.getName(), funcion.getScope());

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);



		intermediateCodeBuilder.addQuadruple("DVLP", "STARTSUBPROGRAMA");

		Value direccionesInvocador = new Value(scope.getSymbolTable().getSymbols().size() + scope.getTemporalTable().getTemporals().size());
		System.out.println("Llamada tamano " + direccionesInvocador);


		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();
		
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelIdentificador = labelFactory.create(ident.getLexema());
		intermediateCodeBuilder.addQuadruple("INICIO_FUNCION");

		for (int i = expresionesParametro.size()-1; i >=0 ; i--) {
			intermediateCodeBuilder.addQuadruples(expresionesParametro.get(i).getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("PARAM", expresionesParametro.get(i).getTemporal());
		}

		intermediateCodeBuilder.addQuadruple("CALL", labelIdentificador);

		if (symbol instanceof SymbolFunction) {
			intermediateCodeBuilder.addQuadruple("VALOR_RETORNO", temporal);
		}
			
		Expresion expr = new Expresion();
		expr.setValor("0");		// Este valor es un sueñuelo, no tiene efectividad real (debería borrarlo).
		expr.setIntermediateCode(intermediateCodeBuilder.create());
		expr.setTemporal(temporal);
		expr.setTipo(((SymbolIF) funcion).getType());
		RESULT = expr; :}
	| IDENTIFICADOR:ident OPEN_KEY CLOSE_KEY {: System.out.println("READ> llamadaFuncion = sinParametros");
	 	ScopeIF scope = scopeManager.getCurrentScope();

		if (!scopeManager.containsSymbol(ident.getLexema())) {
			semanticErrorManager.semanticFatalError("El identificador " + ident.getLexema() + " no existe. DEBUG: llamadafuncion");
		}
		
		SymbolIF symbol = scopeManager.searchSymbol(ident.getLexema());
		
		if (!(symbol instanceof SymbolFunction || symbol instanceof SymbolProcedure)) {
			semanticErrorManager.semanticFatalError("El identificador " + ident.getLexema() + " no es una función o procedimiento.");
		}
		
		// Borrar?
		SymbolProcedure funcion = (SymbolProcedure) symbol;
		

		Procedure procedure = new Procedure(funcion.getName(), funcion.getScope());

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);



		intermediateCodeBuilder.addQuadruple("DVLP", "STARTSUBPROGRAMA");

		Value direccionesInvocador = new Value(scope.getSymbolTable().getSymbols().size() + scope.getTemporalTable().getTemporals().size());
		System.out.println("Llamada tamano " + direccionesInvocador);


		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();
		
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelIdentificador = labelFactory.create(ident.getLexema());
		intermediateCodeBuilder.addQuadruple("INICIO_FUNCION");

		intermediateCodeBuilder.addQuadruple("CALL", labelIdentificador);

		if (symbol instanceof SymbolFunction) {
			intermediateCodeBuilder.addQuadruple("VALOR_RETORNO", temporal);
		}
			
		Expresion expr = new Expresion();
		expr.setValor("0");		// Este valor es un sueñuelo, no tiene efectividad real (debería borrarlo).
		expr.setIntermediateCode(intermediateCodeBuilder.create());
		expr.setTemporal(temporal);
		expr.setTipo(((SymbolIF) funcion).getType());
		RESULT = expr; :};
parametros ::= expresion:exp {: System.out.println("READ> parametros = expresion"); 
		ArrayList<Expresion> params = new ArrayList<Expresion>();
		//params.add(0, (Expresion) exp);
		params.add((Expresion) exp);
		RESULT = params; :}
 | expresion:exp COLON parametros:paramsEntrada {: System.out.println("READ> parametros = expresion COLON parametros"); 
		ArrayList<Expresion> params = (ArrayList<Expresion>) paramsEntrada;
		//params.add(0, (Expresion) exp);
		params.add((Expresion) exp);
 		RESULT = params; :};

//  SENTENCIAS

