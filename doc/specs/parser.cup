funcion ::= funcion0:func0 seccionTipos:secTip funcion1:fun1 {: 

		SymbolIF simboloFuncion = (SymbolIF) func0;
		String identificador = simboloFuncion.getName();
		String identificadorFin = "FUN_" + String.valueOf(scopeManager.getCurrentScope().getId());
		ArrayList<SymbolIF> params = ((SymbolProcedure)simboloFuncion).getParameters();

		for (SymbolIF param : params) {
			System.out.println("ParametroFunc> " + param.getName());
		}

		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();


		// Asignación de direcciones

		int direccion = 5 + params.size();

		List<ScopeIF> listScopeHijos = scopeManager.getAllScopes();
		
		System.out.println("listScopeHijos en funcion normal sin borrar " + listScopeHijos);

		for (int i = 0 ; i < scopeManager.getAllScopes().size() ; i++) {
			if (i < scope.getId()) listScopeHijos.remove(0);
		}

		System.out.println("listScopeHijos en funcion normal " + listScopeHijos);


		for (ScopeIF tempScope: listScopeHijos) {
			for (int i = 0; i < tempScope.getSymbolTable().getSymbols().size(); i++) {
				SymbolIF symbol = tempScope.getSymbolTable().getSymbols().get(i);
				if (symbol instanceof SymbolVariable) {
					((SymbolVariable) symbol).setAddress(direccion);
					direccion += symbol.getType().getSize();
				}
			}
		}

		//	for (int i = 0 ; i < scope.getTemporalTable().getTemporals().size(); i++) {
		//		TemporalIF temporal = scope.getTemporalTable().getTemporals().get(i);
		//		if (temporal instanceof Temporal) {
		//			((Temporal) temporal).setAddress(direccion);
		//			//direccion += temporal.getType().getSize();
		//			direccion += ((Temporal) temporal).getSize();
		//		}
		//	}
		
		for (ScopeIF tempScope: listScopeHijos) {
			for (int i = 0; i < tempScope.getTemporalTable().getTemporals().size(); i++) {
				TemporalIF temporal = tempScope.getTemporalTable().getTemporals().get(i);
				if (temporal instanceof Temporal) {
					((Temporal) temporal).setAddress(direccion);
					direccion += ((Temporal) temporal).getSize();
				}
			}
		}

		// Lo demás


		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();

		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelInicio = labelFactory.create(identificador);
		LabelIF labelFin = labelFactory.create("FIN_" + identificadorFin);
		
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruple("INL", labelInicio);

		int direccionParams = -4;

		//	for (int i=0; i<scope.getSymbolTable().getSymbols().size(); i++) {
		//		SymbolIF symbol = scope.getSymbolTable().getSymbols().get(i);
		//		if (symbol instanceof SymbolParameter) {
		//			// int valor = (((SymbolParameter)symbol).getValor() != null) ? Integer.parseInt(((SymbolParameter)symbol).getValor()) : 0;
		//			// ^^^^^^^^^	La linea anterior no se utiliza...
		//			Variable variable = new Variable(symbol.getName(), symbol.getScope());
		//			// intermediateCodeBuilder.addQuadruple("VARSUBPROGRAMA", temporal, direccionParams);
		//			intermediateCodeBuilder.addQuadruple("VARSUBPROGRAMA", variable, direccionParams);
		//			System.out.println("PARAMETRO POS " + direccionParams + " = " + ((SymbolParameter)symbol).getAddress());
		//			direccionParams--;
		//		}
		//	}

		for (SymbolIF symbol : params) {
			if (symbol instanceof SymbolParameter) {
				Variable variable = new Variable(symbol.getName(), symbol.getScope());
				intermediateCodeBuilder.addQuadruple("VARSUBPROGRAMA", variable, direccionParams);
				System.out.println("PARAMETRO POS " + direccionParams + " = " + ((SymbolParameter)symbol).getAddress());
				direccionParams--;
			}
		}

		//int tamanoRA = scope.getSymbolTable().getSymbols().size() + scope.getTemporalTable().getTemporals().size() + 5;  // Para que es el +5? El +5 es para reservar los elementos comunes del registro de activacion
		int tamanoRA = direccion;

		intermediateCodeBuilder.addQuadruple("PUNTERO_FUNCION", temporal, tamanoRA);
		
		for (ScopeIF tempScope: listScopeHijos) {
			for (int i = 0; i < tempScope.getSymbolTable().getSymbols().size(); i++) {
				SymbolIF symbol = tempScope.getSymbolTable().getSymbols().get(i);
				Variable variable = new Variable(symbol.getName(), symbol.getScope());
				int valor;
				System.out.println("	 symbol.getName() = " + symbol.getName());
				System.out.println("     symbol.getType() = " + symbol.getType());
				if ((symbol.getType() instanceof TypeSimple) && (symbol instanceof SymbolVariable) && !(symbol instanceof SymbolParameter)) {
					valor = ( ((SymbolVariable)symbol).getValor() != null ) ? Integer.parseInt(((SymbolVariable)symbol).getValor()) : 0;
				System.out.println(" D E B U G");
					intermediateCodeBuilder.addQuadruple("VARLOCAL", variable, valor);
				} else if ((symbol.getType() instanceof TypeArray)) {
					String valores = ((SymbolVariable)symbol).getValor();
					int size = ((TypeArray)symbol.getType()).getSize();
					intermediateCodeBuilder.addQuadruple("VARLOCALVECTOR", variable, size);
				}
			}
		}

		intermediateCodeBuilder.addQuadruples(((Sentencia) fun1).getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("FIN_FUNCION", labelFin, params.size()+5);

		// Reposicionado cerrado de ámbitos aquí
		System.out.println("AMBT>cerrar " + scope.getName() + " (" + (scope.getLevel()) + ")");
		semanticErrorManager.semanticDebug("Tabla de Simbolos: " + scopeManager.getCurrentScope().getSymbolTable());
		semanticErrorManager.semanticDebug("Tabla de Tipos:    " + scopeManager.getCurrentScope().getTypeTable());
		semanticErrorManager.semanticDebug("Tabla de Temporales: " + scopeManager.getCurrentScope().getTemporalTable());
		scopeManager.closeScope();

		Funcion funcion = new Funcion();
		funcion.setSymbolProcedure((SymbolProcedure) simboloFuncion);
		funcion.setIntermediateCode(intermediateCodeBuilder.create());

		QuadrupleIF devuelto = null;
		
		for (QuadrupleIF cuadrupla : funcion.getIntermediateCode()) {
			System.out.println(cuadrupla.toString());
			if (cuadrupla.getOperation().equals("DEVUELTO")) {
				devuelto = cuadrupla;
				break;
			}
		}

		if (devuelto == null) 
			semanticErrorManager.semanticFatalError("Falta asignar una instrucción devuelto en " + (simboloFuncion instanceof SymbolProcedure ? "el procedimiento" : " la función") + " " + identificador + ".");


		try {
			if (((SymbolIF) func0) instanceof SymbolFunction) {
				if (devuelto.getFirstOperand() == null) {
					semanticErrorManager.semanticFatalError("Funcion " + identificador + " no devuelve valor.");
				}
			} else if (((SymbolIF) func0) instanceof SymbolProcedure) {
				if (devuelto.getFirstOperand() != null) {
					semanticErrorManager.semanticFatalError("Procedimiento " + identificador + " devuelve valor.");
				}
			} else {
				semanticErrorManager.semanticFatalError("ERROR INESPERADO EN LA LINEA 821");
			}
		} catch (Exception e) {
			System.out.println("Estado inalcanzable, ya se ha asignado una comprobación anteriormente en las líneas 811.");
			semanticErrorManager.semanticFatalError("Falta asignar una instrucción devuelto en la función/procedimiento " + identificador);
			e.printStackTrace();
		}


		RESULT = funcion; :};
                     
