// EXPRESIONES

expresion ::= NUMERO:num {: if (debugSout) System.out.println("READ> expresion = NUMERO"); 
		String numero = num.getLexema();
		Expresion expr = new Expresion();

		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();

		Value value = new Value(Integer.parseInt(numero));
		intermediateCodeBuilder.addQuadruple("MV", temporal, value);

		expr.setTemporal(temporal);
		expr.setIntermediateCode(intermediateCodeBuilder.create());
		if (debugSout) System.out.println("     QUAD>" + expr.getIntermediateCode());  

		expr.setTipo(scopeManager.searchType("ENTERO"));
		expr.setValor(numero);
		RESULT = expr; :}
	| IDENTIFICADOR:id {: 
		String identificador = id.getLexema(); 
		Expresion expr = new Expresion();
		expr.setIdentificador(identificador);
		if(!(scopeManager.containsSymbol(identificador))) {
			semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "La variable " + identificador + " no existe");
		}
		
		SymbolIF symbol = scopeManager.searchSymbol(identificador);

		if (debugSout) System.out.println(symbol.getClass());

		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();

		String numero = "";

		if (symbol instanceof SymbolVariable) {
			SymbolVariable vari = (SymbolVariable) symbol;
			Variable variable = new Variable(((SymbolVariable)vari).getName(), symbol.getScope());
			intermediateCodeBuilder.addQuadruple("MV", temporal, variable);
			numero = vari.getValor();
		} else if (symbol instanceof SymbolConstant) {
			SymbolConstant constant = (SymbolConstant) symbol;
			Value value = new Value(Integer.parseInt(((SymbolConstant) symbol).getValor()));
			intermediateCodeBuilder.addQuadruple("MV", temporal, value);
			numero = constant.getValor();
		} else if (symbol instanceof SymbolParameter) {
			SymbolParameter parameter = (SymbolParameter) symbol;
			Variable variable = new Variable(((SymbolParameter)parameter).getName(), symbol.getScope());
			intermediateCodeBuilder.addQuadruple("MV", temporal, variable);
			numero = parameter.getValor();
		} else {
			semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "El identificador " + identificador + " no es una variable o constante");
		}

		if (numero == null) {
			numero = "0";
		}

		if (debugSout) System.out.println("READ> expresion = IDENTIFICADOR = " + numero + " " + symbol.getType() + " " + symbol.getClass() );

		expr.setTipo(symbol.getType());
		expr.setValor(numero);
		expr.setTemporal(temporal);
		expr.setIntermediateCode(intermediateCodeBuilder.create());
		if (debugSout) System.out.println("     QUAD>" + expr.getIntermediateCode());  
		RESULT = expr; :}	
 	|  OPEN_KEY expresion:exp CLOSE_KEY {: if (debugSout) System.out.println("READ> expresion = OPEN_KEY expresion CLOSE_KEY");
 		Expresion expr = (Expresion) exp;
		if (debugSout) System.out.println("(EX)> (" + expr.getValor() + ")");
		RESULT = expr; :}
 	|  expresion:a PLUS:check expresion:b {: if (debugSout) System.out.println("READ> expresion = PLUS"); 
			Expresion expr = new Expresion();
			Expresion expra = (Expresion) a;
			Expresion exprb = (Expresion) b;
			if (!(expra.getTipo().equals(exprb.getTipo()))) {
				semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "La expresión de suma requiere que los operandos sean del mismo tipo");
			} else if (!(expra.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "La expresión de suma requiere el operando izquierdo sea de tipo entero");
			} else if (!(exprb.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "La expresión de suma requiere el operando derecho sea de tipo entero");
			}
			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expra.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruples(exprb.getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("ADD", temporal, expra.getTemporal(), exprb.getTemporal());

			expr.setTipo(scopeManager.searchType("ENTERO"));
			expr.setValor(Integer.toString(Integer.parseInt(expra.getValor()) + Integer.parseInt(exprb.getValor())));
			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());


			if (debugSout) System.out.println("EXP+> " + expra.getValor() + "+" + exprb.getValor() + "=" + expr.getValor());
			if (debugSout) System.out.println("     QUAD>" + expr.getIntermediateCode());  
			RESULT = expr; :}
 	|  expresion:a MULT:check expresion:b {: if (debugSout) System.out.println("READ> expresion = MULT");
			Expresion expr = new Expresion();
			Expresion expra = (Expresion) a;
			Expresion exprb = (Expresion) b;
			if (!(expra.getTipo().equals(exprb.getTipo()))) {
				semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "La expresión de multiplicación requiere que los operandos sean del mismo tipo");
			} else if (!(expra.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "La expresión de multiplicación requiere el operando izquierdo sea de tipo entero");
			} else if (!(exprb.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "La expresión de multiplicación requiere el operando derecho sea de tipo entero");
			}

			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expra.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruples(exprb.getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("MUL", temporal, expra.getTemporal(), exprb.getTemporal());

			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());

			expr.setTipo(scopeManager.searchType("ENTERO"));
			expr.setValor(Integer.toString(Integer.parseInt(expra.getValor()) * Integer.parseInt(exprb.getValor())));
			if (debugSout) System.out.println("EXP*> " + expra.getValor() + "*" + exprb.getValor() + "=" + expr.getValor());
			if (debugSout) System.out.println("     QUAD>" + expr.getIntermediateCode());  
			RESULT = expr; :}
 	|  expresion:exp AUTO_INCREMENTO:check {: if (debugSout) System.out.println("READ> expresion = AUTO_INCREMENTO");
		
		Expresion expr = (Expresion) exp;

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "No se puede incrementar una variable de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}

		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();

		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	

		Value value = new Value(Integer.parseInt("1"));
		intermediateCodeBuilder.addQuadruple("ADD", temporal, expr.getTemporal(), value);

		expr.setTemporal(temporal);
		expr.setIntermediateCode(intermediateCodeBuilder.create());

		String valor = expr.getValor();
		expr.setValor(Integer.toString((Integer.parseInt(valor) + 1)));

		if (debugSout) System.out.println("EX++> " + expr.getValor());
		if (debugSout) System.out.println("     QUAD>" + expr.getIntermediateCode());  
		
		RESULT = expr; :}
 	|  NEGACION:check expresion:exp {: if (debugSout) System.out.println("READ> expresion = NEGACION"); 
			Expresion expr = (Expresion) exp;
			if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
				semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "No se puede negar una variable de tipo " + expr.getTipo().getName() + ", únicamente usando enteros.");
			}

			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruple("NEG", temporal, expr.getTemporal());

			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());
			if (debugSout) System.out.println("     QUAD>" + expr.getIntermediateCode());  

			expr.setTipo(scopeManager.searchType("ENTERO"));
			expr.setValor((Integer.parseInt(expr.getValor()) == 0)?"1":"0");
			if (debugSout) System.out.println("EXP-> " + expr.getValor());
			RESULT = expr; :}
 	|  expresion:a LOWER_THAN:check expresion:b {: if (debugSout) System.out.println("READ> expresion = LOWER_THAN "); 
