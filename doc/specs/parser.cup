			if (debugSout) System.out.println("     QUAD>" + expr.getIntermediateCode());  
			RESULT = expr; :}
 	|  expresion:a AND_LOGICA:check expresion:b {: if (debugSout) System.out.println("READ> expresion = AND_LOGICA "); Expresion expr = new Expresion();
			Expresion expra = (Expresion) a;
			Expresion exprb = (Expresion) b;
			if (!(expra.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "La expresión AND requiere el operando izquierdo sea de tipo lógico");
			} else if (!(exprb.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "La expresión AND requiere el operando derecho sea de tipo lógico");
			}

			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expra.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruples(exprb.getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("AND", temporal, expra.getTemporal(), exprb.getTemporal());

			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());

			expr.setTipo(scopeManager.searchType("ENTERO"));
			expr.setValor((Integer.parseInt(expra.getValor()) == 1 && Integer.parseInt(exprb.getValor()) == 1)?"1":"0");
			if (debugSout) System.out.println("EX&&> " + expra.getValor() + "AND" + exprb.getValor() + "=" + expr.getValor());
			if (debugSout) System.out.println("     QUAD>" + expr.getIntermediateCode());  
			RESULT = expr; :}
 	|  accesoVector:exp {: if (debugSout) System.out.println("READ> expresion = accesoVector"); 
			Expresion expr = (Expresion) exp;

			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalIF temporal = expr.getTemporal();

			intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
			Variable variable = new Variable(expr.getNombreVector(), expr.getSymbolVariableIdentificador().getScope());

			intermediateCodeBuilder.addQuadruple("MVV", temporal, variable, expr.getIndice());		
			expr.setIntermediateCode(intermediateCodeBuilder.create());
			if (debugSout) System.out.println("     QUAD>" + expr.getIntermediateCode());  

			RESULT = expr; :}
