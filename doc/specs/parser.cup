sentenciaSalida ::=ESCRIBE OPEN_KEY opcionesEscribe:expr CLOSE_KEY SEMI_COLON {:
		Sentencia sen = new Sentencia();
		String salida = (String) expr;
		salida = salida.substring(1, salida.length() - 1) + "\\n";

		TemporalFactory temporalFactory = new TemporalFactory(scopeManager.getCurrentScope());		
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());
		LabelFactory labelFactory = new LabelFactory();
		LabelIF label = labelFactory.create();
		TemporalIF temporal = temporalFactory.create();

		Value value = new Value(salida);
		intermediateCodeBuilder.addQuadruple("WRSTR", temporal, label);

		listaCadenas.add(new Quadruple("CADENA", new Label(salida), label));

		sen.setIntermediateCode(intermediateCodeBuilder.create());

		System.out.println("READ> sentenciaSalida = ESCRIBE");
		System.out.println("PRNT> " + salida); 
		RESULT = sen;
 :}
	| ESCRIBE_ENT OPEN_KEY opcionesEscribeEnt:exp CLOSE_KEY SEMI_COLON {: 
		Sentencia sen = new Sentencia();
		Expresion expr = (Expresion) exp;
		String salida = expr.getValor() + "\\n";
		TemporalFactory temporalFactory = new TemporalFactory(scopeManager.getCurrentScope());		
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());
		LabelFactory labelFactory = new LabelFactory();
		LabelIF label = labelFactory.create();
		TemporalIF temporal = temporalFactory.create();

		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());

		//Value value = new Value(salida);
		intermediateCodeBuilder.addQuadruple("WRINT", expr.getTemporal());

		// Está tomando la salida del propio parser, no del código intermedio.

		sen.setIntermediateCode(intermediateCodeBuilder.create());

		System.out.println("READ> sentenciaSalida = ESCRIBE_ENT"); 
		System.out.println("PRNT> " + salida); 
		RESULT = sen;
 :};
opcionesEscribe ::= epsilon {:
		System.out.println("READ> opcionesEscribe = epsilon");
		RESULT = null;
 :}
 | STRING:string {: 
 		System.out.println("READ> opcionesEscribe = STRING"); 
		RESULT = string.getLexema();
 :};
opcionesEscribeEnt ::= epsilon {:
		System.out.println("READ> opcionesEscribeEnt = epsilon");
		RESULT = null;
 :}
 | expresion:expr {:  // DUDA: se permite imprimir lógicos como uno o cero?
		Expresion expresion = (Expresion) expr;
		// Si es tipo lógico, escribir error semántico.
		if (expresion.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("Únicamente se pueden imprimir valores enteros.");
		}

		String salida = expresion.getValor();
		System.out.println("READ> opcionesEscribeEnt = expresion = " + salida);
		RESULT = expresion;
 :};
