sentenciaAlternativas ::= ALTENATIVAS OPEN_KEY expresion:exp CLOSE_KEY OPEN_PARENTHESIS casosAlternativa:casosAlter porDefecto:porD CLOSE_PARENTHESIS {: System.out.println("READ> sentenciaAlternativas"); 
		Expresion expr = (Expresion) exp;
		Casosalternativa casos = (Casosalternativa) casosAlter;
		ArrayList<LabelIF> labels = new ArrayList<LabelIF>();

		Pordefecto porDefecto = (porD != null)? (Pordefecto) porD : null;

		System.out.println((porDefecto != null)? "POR DEFECTO" : "SIN POR DEFECTO");

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("No se puede comparar un valor de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}


		ScopeIF scope=scopeManager.getCurrentScope();
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelFinal=labelFactory.create();

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);

		intermediateCodeBuilder.addQuadruple("DVLP", "Alternativas", "Inicio");

		if (porDefecto != null) {
			casos.addPorDefecto(porDefecto);		// No sé si esto es posible de ejecutar...
		}		
		
		for (Casoalt casoalt : casos.getCasos()) {
			labels.add(labelFactory.create());
			/*  LabelIF label = labelFactory.create();
			 *  labels.add(label);
			 */
		}

		// Print labels content
		System.out.println("LABELS " + labels);

		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());

		for (int i = 0; i < labels.size(); i++) {
			if (i == labels.size()-1) {
				if (porDefecto != null) {
					intermediateCodeBuilder.addQuadruple("INL", labels.get(i));
					intermediateCodeBuilder.addQuadruples(casos.getCasos().get(i).getIntermediateCode());
				} else {
					intermediateCodeBuilder.addQuadruple("INL", labels.get(i));
					intermediateCodeBuilder.addQuadruple("CMP", expr.getTemporal(), casos.getCasos().get(i).getValor());
					intermediateCodeBuilder.addQuadruple("BNZ", labelFinal);
					intermediateCodeBuilder.addQuadruples(casos.getCasos().get(i).getIntermediateCode());
					intermediateCodeBuilder.addQuadruple("BR", labelFinal); 
				}
				
			} else {
				/*  LABEL i:
				 *  		CMP expr, casos.getCasos().get(i).getValor()
				 * 			BRF? casos[i+1]
				 * 			casos.getCasos().get(i).getIntermediateCode()
				 * 			JMP Fin
				 */
				intermediateCodeBuilder.addQuadruple("INL", labels.get(i));
				intermediateCodeBuilder.addQuadruple("CMP", expr.getTemporal(), casos.getCasos().get(i).getValor());
				intermediateCodeBuilder.addQuadruple("BNZ", labels.get(i+1));
				intermediateCodeBuilder.addQuadruples(casos.getCasos().get(i).getIntermediateCode());
				intermediateCodeBuilder.addQuadruple("BR", labelFinal); 

			}
		}
		/*  LABEL fin */
		intermediateCodeBuilder.addQuadruple("INL", labelFinal);

		intermediateCodeBuilder.addQuadruple("DVLP", "Alternativas", "Final");

		Sentenciaalternativas sentAlternativas =new Sentenciaalternativas();
		sentAlternativas.setIntermediateCode(intermediateCodeBuilder.create());
		System.out.println("     QUAD>" + sentAlternativas.getIntermediateCode());  


		RESULT = sentAlternativas; :};


