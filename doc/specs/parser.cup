accesoVector ::= IDENTIFICADOR:id OPEN_BRACKET:vectorSize expresion:exp CLOSE_BRACKET {: if (debugSout) System.out.println("READ> accesoVector");

		ScopeIF scope = scopeManager.getCurrentScope();

		Expresion expr = (Expresion) exp;
		String identificador = id.getLexema(); 
		if (debugSout) System.out.println(identificador);
		Expresion exprN = new Expresion();
		if(!(scopeManager.containsSymbol(identificador))) {
			semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "La variable " + identificador + " no existe");
		}
		
		SymbolIF symbol = scopeManager.searchSymbol(identificador);


		String numero = "";

		SymbolVariable symbolvariable = (SymbolVariable) symbol;
		if (symbol instanceof SymbolVariable) {
			if (!(symbolvariable.getType() instanceof TypeArray)) {
				semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "La variable " + identificador + " no es de tipo vector.");
			}
			if (symbolvariable.getType().getSize() <= Integer.parseInt(expr.getValor())) {
				semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "Error en la línea " + vectorSize.getLine() + ", caracter " + vectorSize.getColumn() + ". " + "La variable " + identificador + " no tiene tantos elementos. Rango admitido entre 0 y " + (symbolvariable.getType().getSize() - 1) + ". Equivalente a un IndexOutOfBoundsException.");
			}
			if (0 > Integer.parseInt(expr.getValor())) {
				// Estado inalcanzable: imposible utilizar enteros negativos por la propia gramática.
				semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "Error en la línea " + vectorSize.getLine() + ", caracter " + vectorSize.getColumn() + ". " + "Imposible utilizar un indice negativo. Rango admitido entre 0 y " + (symbolvariable.getType().getSize() - 1) + ". Equivalente a un IndexOutOfBoundsException.");
			}
			exprN.setSymbolVariableIdentificador(symbolvariable);
			numero = symbolvariable.getValor().split(",")[Integer.parseInt(expr.getValor())];
		} else {
			semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "El identificador " + identificador + " no es una variable.");
		}

		if (debugSout) System.out.println("READ> expresion = accesoVector "+ symbol.getName() +" @pos"+ expr.getValor() +" = " + numero + " " + symbol.getType() + " ");

		exprN.setTipo(scopeManager.searchType("ENTERO"));
		exprN.setValor(numero);
		exprN.setIndice(expr.getTemporal());
		exprN.setNombreVector(identificador);
		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();
		exprN.setTemporal(temporal);

		Variable variable = new Variable(identificador, symbol.getScope());

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());

		exprN.setIntermediateCode(intermediateCodeBuilder.create());

		RESULT = exprN;
		 :};

llamadaFuncion ::= IDENTIFICADOR:ident OPEN_KEY:check parametros:params CLOSE_KEY {: if (debugSout) System.out.println("READ> llamadaFuncion = conParametros");
		ScopeIF scope = scopeManager.getCurrentScope();

		if (!scopeManager.containsSymbol(ident.getLexema())) {
			semanticErrorManager.semanticFatalError("Error en la línea " + ident.getLine() + ", caracter " + ident.getColumn() + ". " + "El identificador " + ident.getLexema() + " no existe. DEBUG: llamadafuncion");
		}
		
		SymbolIF symbol = scopeManager.searchSymbol(ident.getLexema());
		
		if (!(symbol instanceof SymbolFunction || symbol instanceof SymbolProcedure)) {
			semanticErrorManager.semanticFatalError("Error en la línea " + ident.getLine() + ", caracter " + ident.getColumn() + ". " + "El identificador " + ident.getLexema() + " no es una función o procedimiento.");
		}
		
		SymbolProcedure funcion = (SymbolProcedure) symbol;
		
		ArrayList<SymbolIF> listaParametros = (ArrayList<SymbolIF>) funcion.getParameters();		// Lista de parámetros de la función
		ArrayList<Expresion> parametros = (ArrayList<Expresion>) params;		// Lista de parámetros de la declaración
		if (listaParametros.size() != parametros.size()) {
			semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "La función o procedimiento " + ident.getLexema() + " requiere " + listaParametros.size() + " parámetro(s)");
		}

		ArrayList<Expresion> expresionesParametro = new ArrayList<Expresion>();
		for (int i = 0; i < parametros.size(); i++) {
			Expresion parametro = parametros.get(i);
			if (parametro.getTipo() != listaParametros.get(i).getType()) {
				semanticErrorManager.semanticFatalError("Error en la linea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "El parametro de la posicion numero " + (i + 1) + ", con tipo " + parametro.getTipo().getName() + " no coincide con el tipo de parametro " + listaParametros.get(i).getType().getName() + ".");
			}
			parametro.setIdentificador(listaParametros.get(i).getName());
			expresionesParametro.add(parametro);
			if (debugSout) System.out.println("Parametro> " + parametro.getValor() + " " + parametro.getIdentificador());
		}

		Procedure procedure = new Procedure(funcion.getName(), funcion.getScope());

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);

		Value direccionesInvocador = new Value(scope.getSymbolTable().getSymbols().size() + scope.getTemporalTable().getTemporals().size());
		if (debugSout) System.out.println("Llamada tamano " + direccionesInvocador);

		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();
		
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelIdentificador = labelFactory.create(ident.getLexema());
		intermediateCodeBuilder.addQuadruple("INICIO_FUNCION");

		boolean encontradoEspecial = false;			

		for (int i = expresionesParametro.size()-1; i >=0 ; i--) {
			
			List<QuadrupleIF> quadruples = expresionesParametro.get(i).getIntermediateCode();

			for (QuadrupleIF cuadrupla : quadruples) {
				if (debugSout) System.out.println(cuadrupla.toString());
				if (!encontradoEspecial && cuadrupla.getOperation().equals("INICIO_FUNCION")) {
					System.out.println("SE HA DETECTADO UNA FUNCION EN LOS PARAMETROS");
					intermediateCodeBuilder.addQuadruple("CONTROL");
					intermediateCodeBuilder.addQuadruple(cuadrupla);
					intermediateCodeBuilder.addQuadruple("CONTROL");
					//break;
					encontradoEspecial = true;
				} else 
				intermediateCodeBuilder.addQuadruple(cuadrupla);
			}

			
			//intermediateCodeBuilder.addQuadruples(quadruples);
			intermediateCodeBuilder.addQuadruple("PARAM", expresionesParametro.get(i).getTemporal());
		}

		if (!encontradoEspecial) 
			intermediateCodeBuilder.addQuadruple("CONTROL");

		intermediateCodeBuilder.addQuadruple("CALL", labelIdentificador);

		if (symbol instanceof SymbolFunction) {
			intermediateCodeBuilder.addQuadruple("VALOR_RETORNO", temporal);
		}

		Expresion expr = new Expresion();
		expr.setValor("0");		// Este valor es un sueñuelo, sirve como referencia.
		expr.setIntermediateCode(intermediateCodeBuilder.create());
		expr.setTemporal(temporal);
		expr.setTipo(((SymbolIF) funcion).getType());
		RESULT = expr; :}
	| IDENTIFICADOR:ident OPEN_KEY CLOSE_KEY {: if (debugSout) System.out.println("READ> llamadaFuncion = sinParametros");
	 	ScopeIF scope = scopeManager.getCurrentScope();

		if (!scopeManager.containsSymbol(ident.getLexema())) {
			semanticErrorManager.semanticFatalError("Error en la línea " + ident.getLine() + ", caracter " + ident.getColumn() + ". " + "El identificador " + ident.getLexema() + " no existe. DEBUG: llamadafuncion");
		}
		
		SymbolIF symbol = scopeManager.searchSymbol(ident.getLexema());
		
		if (!(symbol instanceof SymbolFunction || symbol instanceof SymbolProcedure)) {
			semanticErrorManager.semanticFatalError("Error en la línea " + ident.getLine() + ", caracter " + ident.getColumn() + ". " + "El identificador " + ident.getLexema() + " no es una función o procedimiento.");
		}
		
		SymbolProcedure funcion = (SymbolProcedure) symbol;

		Procedure procedure = new Procedure(funcion.getName(), funcion.getScope());

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);

		Value direccionesInvocador = new Value(scope.getSymbolTable().getSymbols().size() + scope.getTemporalTable().getTemporals().size());
		if (debugSout) System.out.println("Llamada tamano " + direccionesInvocador);


		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();
		
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelIdentificador = labelFactory.create(ident.getLexema());
		intermediateCodeBuilder.addQuadruple("INICIO_FUNCION");

		intermediateCodeBuilder.addQuadruple("CALL", labelIdentificador);

		if (symbol instanceof SymbolFunction) {
			intermediateCodeBuilder.addQuadruple("VALOR_RETORNO", temporal);
		}
			
		Expresion expr = new Expresion();
		expr.setValor("0");		// Este valor es un sueñuelo, sirve como referencia.
		expr.setIntermediateCode(intermediateCodeBuilder.create());
		expr.setTemporal(temporal);
		expr.setTipo(((SymbolIF) funcion).getType());
		RESULT = expr; :};
parametros ::= expresion:exp {: if (debugSout) System.out.println("READ> parametros = expresion"); 
		ArrayList<Expresion> params = new ArrayList<Expresion>();
		params.add((Expresion) exp);
		RESULT = params; :}
 | expresion:exp COLON parametros:paramsEntrada {: if (debugSout) System.out.println("READ> parametros = expresion COLON parametros"); 
		ArrayList<Expresion> params = (ArrayList<Expresion>) paramsEntrada;
		params.add((Expresion) exp);
 		RESULT = params; :};

bloque ::= OPEN_PARENTHESIS abrirAmbito seccionVariables listadoSentencias:sen cerrarAmbito CLOSE_PARENTHESIS {: if (debugSout) System.out.println("READ> bloque = OPEN_PARENTHESIS seccionVariables listadoSentencias CLOSE_PARENTHESIS"); RESULT = (Sentencia) sen; :}
 	|  OPEN_PARENTHESIS abrirAmbito listadoSentencias:sen cerrarAmbito CLOSE_PARENTHESIS {: if (debugSout) System.out.println("READ> bloque = OPEN_PARENTHESIS listadoSentencias CLOSE_PARENTHESIS"); RESULT = (Sentencia) sen; :};

listadoSentencias ::= listadoSentencias:listSent sentencia:sent {: if (debugSout) System.out.println("READ> listadoSentencias = listadoSentencias sentencia"); 
		Sentencia ls = (Sentencia) listSent;
		Sentencia s = (Sentencia) sent;
		List<QuadrupleIF> intermediateCode = ls.getIntermediateCode();
		intermediateCode.addAll(s.getIntermediateCode());
		s.setIntermediateCode(intermediateCode);

		if (debugSout) System.out.println("     QUAD>" + s.getIntermediateCode());

		RESULT = s;
		:}
 | sentencia:sent {: if (debugSout) System.out.println("READ> listadoSentencias = sentencia"); 
		Sentencia s = (Sentencia) sent;
		if (debugSout) System.out.println("     QUAD>" + s.getIntermediateCode());
		RESULT = s; 
		:};

