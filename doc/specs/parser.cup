// Declaracion de relaciones de precedencia
precedence left     AND_LOGICA;
precedence left		EQUAL;
precedence left		LOWER_THAN;
precedence left		PLUS;
precedence left		MULT;
precedence left		AUTO_INCREMENTO, NEGACION;
precedence right	OPEN_BRACKET, CLOSE_BRACKET;
precedence left 	OPEN_KEY, CLOSE_KEY;
precedence nonassoc SINO;
precedence nonassoc SI;
            

// Declaracion de reglas de produccion


start with program;

program ::= 
  {: 
        syntaxErrorManager.syntaxInfo ("Starting parsing..."); 

		scopeManager.openScope("global");
		ScopeIF scope = scopeManager.getCurrentScope();
		if (debugSout) System.out.println("AMBT>comenzamos! " + scope.getName() + " (" + scope.getLevel() + ")");

		if (debugSout) System.out.println("GLBL> creando tipos");
		
		//Obtenemos del ámbito creado la Tabla de Tipos y Símbolos
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();

		//Introduccion del Tipo Simple Entero o Integer y Logico o Booleano, vacio y vector
		TypeSimple tsEntero = new TypeSimple(scope);
			tsEntero.setName("ENTERO");
			typeTable.addType("ENTERO",tsEntero);

		// Es muy posible que este no sea necesario
		TypeSimple tsVacio = new TypeSimple(scope);
			tsVacio.setName("VACIO");
			typeTable.addType("VACIO",tsVacio);

		/*
		// Referencia para uso posterior.
		TypeArray tsVector = new TypeArray(scope);
			tsVector.setName("VECTORexp");
			typeTable.addType("VECTORexp",tsVector);
		*/

   :}
  axiom:ax
  {:   		
  		// No modificar esta estructura, aunque se pueden añadir más acciones semánticas

  		List intermediateCode = ax.getIntermediateCode ();
		finalCodeFactory.setEnvironment(CompilerContext.getExecutionEnvironment());
  		finalCodeFactory.create (intermediateCode);

  		// En caso de no comentarse las dos sentencias anteriores se puede generar una excepcion
  		// en las llamadas a cupTest si el compilador no está completo. Esto es debido a que 
  		// aún no se tendrá implementada la generación de código intermedio ni final.
  		// Para la entrega final deberán descomentarse y usarse.
  		
		ScopeIF scope = scopeManager.getCurrentScope();
		if (debugSout) System.out.println("AMBT>terminamos! " + scope.getName() + " (" + scope.getLevel() + ")");

		if (debugSout) System.out.println("\n P A R S E R    F I N A L I Z A N D O . . .");
		if (debugSout) System.out.println("Atención: si esta es la primera línea que está leyendo después de que el compilador haya terminado es muy probable que algo haya fallado en la compilación.");

		if (debugSout) System.out.println("Tabla de Simbolos: " + scopeManager.getCurrentScope().getSymbolTable());
		if (debugSout) System.out.println("Tabla de Tipos:    " + scopeManager.getCurrentScope().getTypeTable());
		if (debugSout) System.out.println("Tabla de Temporales: " + scopeManager.getCurrentScope().getTemporalTable());
		scopeManager.closeScope();

		if (debugSout) System.out.println("\n\n\n");
		semanticErrorManager.semanticDebug("           [[[ C O D I G O   I N T E R M E D I O ]]]");
		for (QuadrupleIF cuadrupla : ax.getIntermediateCode()) {
			semanticErrorManager.semanticDebug(cuadrupla.toString());
		}
		if (debugSout) System.out.println("\n\n\n");

  		syntaxErrorManager.syntaxInfo ("Parsing process ended.");
  		
   :};


epsilon ::= ;

marcadorPrincipal ::= {:
	nombreFuncion = "principal";
	if (debugSout) System.out.println("<<< nombreFuncion = " + nombreFuncion);
:};

abrirAmbito ::= {:
		// abrir ámbito
		ScopeIF scope = scopeManager.getCurrentScope();
		scopeManager.openScope("ambito"+ (scope.getLevel()+1));
		if (debugSout) System.out.println("AMBT>abrir " + "ambito"+ (scope.getLevel()+1) + " (" + (scope.getLevel()+1) + ")");
:}; 

cerrarAmbito ::= {:
		// cerrar ámbito
		ScopeIF scope = scopeManager.getCurrentScope();
		if (debugSout) System.out.println("AMBT>cerrar " + scope.getName() + " (" + (scope.getLevel()) + ")");
		if (debugSout) System.out.println("Tabla de Simbolos: " + scopeManager.getCurrentScope().getSymbolTable());
		if (debugSout) System.out.println("Tabla de Tipos:    " + scopeManager.getCurrentScope().getTypeTable());
		if (debugSout) System.out.println("Tabla de Temporales: " + scopeManager.getCurrentScope().getTemporalTable());
		scopeManager.closeScope();
:}; 

axiom ::=  seccionConstantes seccionTipos  axiom1:axi1 {: 
		if (debugSout) System.out.println("READ> axiom = constantes y tipos"); 
		
		ScopeIF thisScope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(thisScope);


		int direccionGlobal=10000;

		for(int i=0;i<thisScope.getSymbolTable().getSymbols().size();i++) {
			SymbolIF symbol=thisScope.getSymbolTable().getSymbols().get(i);
			if(symbol instanceof SymbolVariable) {
				((SymbolVariable)symbol).setAddress(direccionGlobal);
				direccionGlobal = direccionGlobal + symbol.getType().getSize();
				if (debugSout) System.out.println("variable: " + symbol.getType());
				if (debugSout) System.out.println("tamano: " + symbol.getType().getSize());
				
				Variable variable = new Variable(symbol.getName(), symbol.getScope());
				int valor = ( symbol.getType() instanceof TypeSimple && ((SymbolVariable)symbol).getValor() != null ) ? Integer.parseInt(((SymbolVariable)symbol).getValor()) : 0;

				intermediateCodeBuilder.addQuadruple("VARLOCAL", variable, valor);
			}
		}
		
		intermediateCodeBuilder.addQuadruple("AXIOM");

		List<ScopeIF> scopes = scopeManager.getAllScopes();

		// Axiom ax = new Axiom(); // No se puede declarar un abstracto, en su defecto se crea una clase que pueda propagar
		AxiomaCompilador ax = new AxiomaCompilador();

		Program ax1 = (Program) axi1;

		List<QuadrupleIF> intermediateCode = intermediateCodeBuilder.create();
		intermediateCode.addAll(ax1.getIntermediateCode());

		
		for (int i = 0; i < listaCadenas.size(); i++) {
			intermediateCodeBuilder.addQuadruple(listaCadenas.get(i));
		}
		

		ax.setIntermediateCode(intermediateCode);

		RESULT = (Axiom) ax;
		:} ;

axiom1 ::= seccionVariables:secVar seccionFunciones:secFun {: 
		if (debugSout) System.out.println("READ> axiom1 = variables y funciones");

		ScopeIF scope = scopeManager.getCurrentScope();

		Program ax1 = new Program();
		SeccionFunciones sf = (SeccionFunciones) secFun;
		ax1.setIntermediateCode(sf.getIntermediateCode());

		RESULT = ax1; 
		:}
  | seccionFunciones:secFun {: 
  		if (debugSout) System.out.println("READ> axiom1 = solo funciones");

		ScopeIF scope = scopeManager.getCurrentScope();

		Program ax1 = new Program();
		SeccionFunciones sf = (SeccionFunciones) secFun;
		ax1.setIntermediateCode(sf.getIntermediateCode());

		RESULT = ax1; 
		:};

seccionConstantes ::= declaracionConstante seccionConstantes {: if (debugSout) System.out.println("READ> seccionConstantes + recursion"); RESULT = null; :}
                      | epsilon {: if (debugSout) System.out.println("READ> seccionConstantes = ya está"); RESULT = null; :};
                      
                      
declaracionConstante ::= CONSTANTE IDENTIFICADOR:id NUMERO:num SEMI_COLON {:
		if (debugSout) System.out.println("READ> declaracionConstante");
		ScopeIF scope = scopeManager.getCurrentScope();
		SymbolTableIF sTable = scope.getSymbolTable(); 
		TypeTableIF typeTable = scope.getTypeTable ();
		String nombre = id.getLexema();
		String valor = num.getLexema();
		if (debugSout) System.out.println("CONS>existe? "+sTable.containsSymbol(nombre));
		if (sTable.containsSymbol(nombre)) {
			semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "Constante " + nombre + " ya declarada previamente.");
		} else {
			TypeIF tipo = scopeManager.searchType("ENTERO");
			SymbolConstant simboloConstante = new SymbolConstant(scope, nombre, tipo);
			simboloConstante.setValor(valor);
			sTable.addSymbol(nombre, simboloConstante);

			SymbolIF fetch = sTable.getSymbol(nombre);

			if (debugSout) System.out.println("CONS>nuevo " + fetch.getName() + "@" + fetch.getScope().getName() + "=" + ((SymbolConstant)fetch).getValor());
			
			Declaracionconstante declCons = new Declaracionconstante(simboloConstante);
			RESULT = declCons;
		}

 :};

seccionTipos ::= declaracionTipo seccionTipos {: if (debugSout) System.out.println("READ> seccionTipos + recursion"); RESULT = null; :}
                      | epsilon {: if (debugSout) System.out.println("READ> seccionTipos = ya está"); RESULT = null; :};
                      
declaracionTipo ::= TIPO ENTERO IDENTIFICADOR:id OPEN_BRACKET tamTipo:tam CLOSE_BRACKET SEMI_COLON {: 
		if (debugSout) System.out.println("READ> declaracionTipo"); 
		
		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable(); 
		String nombre = id.getLexema();
		int tamano = Integer.parseInt(tam.toString());
		
		if (typeTable.containsType(nombre)) {
			semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "Tipo " + nombre + " ya declarado.");
		} else {			
			TypeArray tsVector = new TypeArray (scope, nombre, tamano);	
			typeTable.addType(nombre,tsVector);

			if (debugSout) System.out.println("VCTR>NEW> " + nombre + "@" + scope.getName() + "=" + "tamaño(" + tamano + ")");

		}

		RESULT = null; 
:};

tamTipo ::= NUMERO:numero {: 
		if (debugSout) System.out.println("READ> tamTipo = NUMERO = " + numero.getLexema()); 
		if (!(Integer.parseInt(numero.getLexema()) > 0)) { semanticErrorManager.semanticFatalError("Error en la línea " + numero.getLine() + ", caracter " + numero.getColumn() + ". " + "Tamaño de vector debe ser positivo"); }
		RESULT = numero.getLexema(); :}
 | IDENTIFICADOR:id {: 
		String cadena = id.getLexema();
		String numero = "";
		if (!scopeManager.containsSymbol(cadena)) {
			semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "La variable con identificador " + cadena + " no existe.");
		}
		SymbolIF symbol = (SymbolIF) scopeManager.searchSymbol(cadena);
		if (symbol instanceof SymbolVariable) {
			SymbolVariable variable = (SymbolVariable) symbol;
			numero = variable.getValor();
		} else if (symbol instanceof SymbolConstant) {
			SymbolConstant constant = (SymbolConstant) symbol;
			numero = constant.getValor();
		} else {
			semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "El identificador " + cadena + " no es una variable o constante.");
		}
		if (debugSout) System.out.println("READ> tamTipo = IDENTIFICADOR = " + numero);
 		RESULT = numero; :};

seccionVariables ::= seccionVariables declaracionVariable {: if (debugSout) System.out.println("READ> seccionVariables + recursion"); RESULT = null; :}
 | declaracionVariable {: if (debugSout) System.out.println("READ> seccionVariables"); RESULT = null; :};

declaracionVariable ::= ENTERO:check listadoIDs:ids SEMI_COLON {:
		if (debugSout) System.out.println("READ> declaracionVariable = ENTERO"); 

		Declaracionvariable declVar = new Declaracionvariable((TypeSimple) scopeManager.searchType("ENTERO"), (Listadoids) ids);

		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);


		ArrayList<Id> identificadores = ((Listadoids) ids).getObjetos();

		for (Id id : identificadores) {
			String nombre = id.getNombre(); 
			if (sTable.containsSymbol(nombre)) {
				semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "Variable " + nombre + " ya declarada.");
			} else {
				TypeIF tipo = scopeManager.searchType("ENTERO");
				SymbolVariable simboloVariable = new SymbolVariable(scope, nombre, tipo);
				if (id.getValor() != null) { 
					Value value = new Value(Integer.parseInt(id.getValor()));
					simboloVariable.setValor(id.getValor()); 
					Variable variable = new Variable(((SymbolVariable)simboloVariable).getName(), ((SymbolVariable)simboloVariable).getScope());
					intermediateCodeBuilder.addQuadruple("MV", variable, value);
				}
				sTable.addSymbol(nombre, simboloVariable);
				
				SymbolIF fetch = sTable.getSymbol(nombre);
				if (debugSout) System.out.println("VARI>nuevo " + fetch.getType().getName() + " " + fetch.getName() + "@" + fetch.getScope().getName() + "=" + ((SymbolVariable)fetch).getValor());
			}
		}

			declVar.setIntermediateCode(intermediateCodeBuilder.create());
			if (debugSout) System.out.println("     QUAD>" + declVar.getIntermediateCode());  
		RESULT = declVar;
 :}
                      | IDENTIFICADOR:ident listadoIDs:ids SEMI_COLON {:
		if (debugSout) System.out.println("READ> declaracionVariable = IDENTIFICADOR");

		Declaracionvariable declVar = new Declaracionvariable((TypeIF) scopeManager.searchType(ident.getLexema()), (Listadoids) ids);

		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();

		ArrayList<Id> identificadores = ((Listadoids) ids).getObjetos();

		for (Id id : identificadores) {
			String nombre = id.getNombre();
			if (sTable.containsSymbol(nombre)) {
				semanticErrorManager.semanticFatalError("Error en la línea " + ident.getLine() + ", caracter " + ident.getColumn() + ". " + "Variable " + nombre + " ya declarada.");
			} else {
				TypeIF tipo = scopeManager.searchType(ident.getLexema());
				SymbolVariable simboloVariable = new SymbolVariable(scope, nombre, tipo);
				if (id.getValor() != null) { semanticErrorManager.semanticFatalError("Error en la línea " + ident.getLine() + ", caracter " + ident.getColumn() + ". " + "Declaraciones en vectores con valor no permitidas."); }
				int size = ((TypeArray)tipo).getSize();
				String comas = "";
				
				for (int i = 1; i < size; i++) comas += "0,";
				comas += "0";

				simboloVariable.setValor(comas);
				sTable.addSymbol(nombre, simboloVariable);
				
				SymbolIF fetch = sTable.getSymbol(nombre);
				if (debugSout) System.out.println("VARI>nuevo " + fetch.getType().getName() + " " + fetch.getName() + "[" + simboloVariable.getType().getSize() + "]" + "@" + fetch.getScope().getName() + "=" + ((SymbolVariable)fetch).getValor());
			}
		}

		RESULT = declVar;
 :};
                      
listadoIDs ::= id:ident listadoIDs1:listadoIdents {: 
		if (debugSout) System.out.println("READ> listadoIDs");
		
		Listadoids listado = (Listadoids) listadoIdents;
		Id identificador = (Id) ident;
		listado.addObjeto(identificador);

		if (debugSout) System.out.print("LIDS> ");

		for (Id id : listado.getObjetos()) 
			if (debugSout) System.out.print(id.getNombre() + " ");
		
		if (debugSout) System.out.println();



		RESULT = listado; 
 :};

listadoIDs1 ::= COLON listadoIDs:listadoIdents {:
		if (debugSout) System.out.println("READ> listadoIDs1 = más variables");
		RESULT = listadoIdents;
 :}
                      | epsilon {:
		if (debugSout) System.out.println("READ> listadoIDs1 = ya está");
		RESULT = new Listadoids();
 :};

id ::= IDENTIFICADOR:ident id1:asign {:
		if (debugSout) System.out.println("READ> id"); 

		Id identificador = new Id();
		identificador.setNombre(ident.getLexema());
		if (asign != null) {
			if (debugSout) System.out.println("ID> Asignar valor " + asign);
			identificador.setValor((String) asign);
		} else { if (debugSout) System.out.println("ID> No asignar valor"); identificador.setValor(null);}
		if (debugSout) System.out.println("ID> Testing data = " + identificador.getValor());
		RESULT = identificador;
 :};

id1 ::= epsilon {:
		if (debugSout) System.out.println("READ> id1 = epsilon");
		RESULT = null;
 :}
        | ASSIGN NUMERO:num {: 
		if (debugSout) System.out.println("READ> id1 = ASSIGN NUMERO"); 
		RESULT = num.getLexema();
 :};

seccionFunciones ::= funcion:fun seccionFunciones:secFun {: 
		if (debugSout) System.out.println("READ> seccionFunciones = funciones extra"); 
		Funcion f = (Funcion) fun;
		SeccionFunciones sf = (SeccionFunciones) secFun;
		List<QuadrupleIF> intermediateCode = f.getIntermediateCode(); // se busca "la primera funcion" antes de las demás
		intermediateCode.addAll(sf.getIntermediateCode()); // las demás funciones se añaden a continuación
		sf.setIntermediateCode(intermediateCode);
		RESULT = sf; 
	:}
                      | funcionPrincipal:funPrin {: 
		if (debugSout) System.out.println("READ> seccionFunciones = funcion principal"); 
		Funcion fp = (Funcion) funPrin;
		SeccionFunciones sf = new SeccionFunciones();
		sf.setIntermediateCode(fp.getIntermediateCode());
		if (debugSout) System.out.println("     QUAD>" + sf.getIntermediateCode());
		RESULT = sf; 
	:};

funcion0 ::= VACIO IDENTIFICADOR:identificador abrirAmbito OPEN_KEY seccionParametros:params CLOSE_KEY OPEN_PARENTHESIS 
		{:
			if (debugSout) System.out.println("READ> funcion = vacio"); 

			ScopeIF scope = scopeManager.getCurrentScope();
			ScopeIF scopeParent = scope.getParentScope();
			SymbolTableIF sTable = scope.getSymbolTable();
			SymbolTableIF sTableParent = scopeParent.getSymbolTable();

			SymbolProcedure simboloProcedimiento = new SymbolProcedure(scopeParent, identificador.getLexema(), (TypeIF) scopeManager.searchType("VACIO"));
			simboloProcedimiento.setParameters((ArrayList<SymbolIF>) params);

			nombreFuncion = identificador.getLexema();

			if (debugSout) System.out.println("<<< nombreFuncion = " + nombreFuncion);

			sTableParent.addSymbol(nombreFuncion, simboloProcedimiento);

			RESULT = simboloProcedimiento;

		:} | ENTERO IDENTIFICADOR:identificador abrirAmbito OPEN_KEY seccionParametros:params CLOSE_KEY OPEN_PARENTHESIS
		{:
			if (debugSout) System.out.println("READ> funcion = entero"); 

			ScopeIF scope = scopeManager.getCurrentScope();
			ScopeIF scopeParent = scope.getParentScope();
			SymbolTableIF sTable = scope.getSymbolTable();
			SymbolTableIF sTableParent = scopeParent.getSymbolTable();

			SymbolFunction simboloFuncion = new SymbolFunction(scopeParent, identificador.getLexema(), (TypeIF) scopeManager.searchType("ENTERO"));
			simboloFuncion.setParameters((ArrayList<SymbolIF>) params);

			nombreFuncion = identificador.getLexema();

			if (debugSout) System.out.println("<<< nombreFuncion = " + nombreFuncion);

			sTableParent.addSymbol(nombreFuncion, simboloFuncion);

			RESULT = simboloFuncion;
		:};	


funcion ::= funcion0:func0 seccionTipos:secTip funcion1:fun1 {: 

		SymbolIF simboloFuncion = (SymbolIF) func0;
		ArrayList<SymbolIF> params = ((SymbolProcedure)simboloFuncion).getParameters();

		for (SymbolIF param : params) {
			if (debugSout) System.out.println("ParametroFunc> " + param.getName());
		}

		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();


		int direccion = 5 + params.size();

		List<ScopeIF> listScopeHijos = scopeManager.getAllScopes();
		
		if (debugSout) System.out.println("listScopeHijos en funcion normal sin borrar " + listScopeHijos);

		for (int i = 0 ; i < scopeManager.getAllScopes().size() ; i++) {
			if (i < scope.getId()) listScopeHijos.remove(0);
		}

		if (debugSout) System.out.println("listScopeHijos en funcion normal " + listScopeHijos);


		for (ScopeIF tempScope: listScopeHijos) {
			for (int i = 0; i < tempScope.getSymbolTable().getSymbols().size(); i++) {
				SymbolIF symbol = tempScope.getSymbolTable().getSymbols().get(i);
				if (symbol instanceof SymbolVariable) {
					((SymbolVariable) symbol).setAddress(direccion);
					direccion += symbol.getType().getSize();
				}
			}
		}

		if (debugSout) System.out.println("direccion = " + direccion);
		
		for (ScopeIF tempScope: listScopeHijos) {
			for (int i = 0; i < tempScope.getTemporalTable().getTemporals().size(); i++) {
				TemporalIF temporal = tempScope.getTemporalTable().getTemporals().get(i);
				if (temporal instanceof Temporal) {
					((Temporal) temporal).setAddress(direccion);
					direccion += ((Temporal) temporal).getSize();
				}
			}
		}		

		if (debugSout) System.out.println("direccion = " + direccion);

		if (debugSout) System.out.println(">>> nombrefuncion = " + nombreFuncion + " funcion");

		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelInicio = labelFactory.create(nombreFuncion);
		LabelIF labelFin = labelFactory.create("FIN_" + nombreFuncion);
		
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruple("INL", labelInicio);

		int direccionParams = -4;

		for (SymbolIF symbol : params) {
			if (symbol instanceof SymbolParameter) {
				Variable variable = new Variable(symbol.getName(), symbol.getScope());
				intermediateCodeBuilder.addQuadruple("VARSUBPROGRAMA", variable, direccionParams);
				if (debugSout) System.out.println("PARAMETRO POS " + direccionParams + " = " + ((SymbolParameter)symbol).getAddress());
				direccionParams--;
			}
		}

		String tamanoRA = String.valueOf(direccion);

		intermediateCodeBuilder.addQuadruple("PUNTERO_FUNCION", tamanoRA);
		
		for (ScopeIF tempScope: listScopeHijos) {
			for (int i = 0; i < tempScope.getSymbolTable().getSymbols().size(); i++) {
				SymbolIF symbol = tempScope.getSymbolTable().getSymbols().get(i);
				Variable variable = new Variable(symbol.getName(), symbol.getScope());
				int valor;
				if (debugSout) System.out.println("	 symbol.getName() = " + symbol.getName());
				if (debugSout) System.out.println("     symbol.getType() = " + symbol.getType());
				if ((symbol.getType() instanceof TypeSimple) && (symbol instanceof SymbolVariable) && !(symbol instanceof SymbolParameter)) {
					valor = ( ((SymbolVariable)symbol).getValor() != null ) ? Integer.parseInt(((SymbolVariable)symbol).getValor()) : 0;
					intermediateCodeBuilder.addQuadruple("VARLOCAL", variable, valor);
				} else if ((symbol.getType() instanceof TypeArray)) {
					String valores = ((SymbolVariable)symbol).getValor();
					int size = ((TypeArray)symbol.getType()).getSize();
					intermediateCodeBuilder.addQuadruple("VARLOCALVECTOR", variable, size);
				}
			}
		}

		intermediateCodeBuilder.addQuadruples(((Sentencia) fun1).getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("FIN_FUNCION", labelFin, params.size()+5);

		// Reposicionado cerrado de ámbitos aquí
		if (debugSout) System.out.println("AMBT>cerrar " + scope.getName() + " (" + (scope.getLevel()) + ")");
		if (debugSout) System.out.println("Tabla de Simbolos: " + scopeManager.getCurrentScope().getSymbolTable());
		if (debugSout) System.out.println("Tabla de Tipos:    " + scopeManager.getCurrentScope().getTypeTable());
		if (debugSout) System.out.println("Tabla de Temporales: " + scopeManager.getCurrentScope().getTemporalTable());
		scopeManager.closeScope();

		Funcion funcion = new Funcion();
		funcion.setSymbolProcedure((SymbolProcedure) simboloFuncion);
		funcion.setIntermediateCode(intermediateCodeBuilder.create());

		QuadrupleIF devuelto = null;
		
		for (QuadrupleIF cuadrupla : funcion.getIntermediateCode()) {
			if (debugSout) System.out.println(cuadrupla.toString());
			if (cuadrupla.getOperation().equals("DEVUELTO")) {
				devuelto = cuadrupla;
				break;
			}
		}

		if (devuelto == null && ((SymbolIF) func0) instanceof SymbolFunction) 
			semanticErrorManager.semanticFatalError("Error en la función" + nombreFuncion + ". Falta asignar una instrucción devuelto.");

		if (((SymbolIF) func0) instanceof SymbolFunction) {
			if (devuelto.getFirstOperand() == null) {
				semanticErrorManager.semanticFatalError("Error en la funcion " + nombreFuncion + ". Funcion " + nombreFuncion + " no devuelve valor.");
			}
		} else if (((SymbolIF) func0) instanceof SymbolProcedure) {
			if (devuelto != null && devuelto.getFirstOperand() != null) {
				semanticErrorManager.semanticFatalError("Error en el procedimiento " + nombreFuncion + ". Procedimiento " + nombreFuncion + " devuelve valor.");
			}
		} else {
			semanticErrorManager.semanticFatalError("Error en la funcion/procedimiento " + nombreFuncion + ". ERROR INESPERADO EN LA LINEA 821. No se ha podido detectar el tipo de retorno.");
		}


		RESULT = funcion; :};
                     
