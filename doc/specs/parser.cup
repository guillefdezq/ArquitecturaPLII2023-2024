seccionParametros ::= declaracionParametros:params {: System.out.println("READ> seccionParametros = sí"); RESULT = params; :}
 | epsilon {: System.out.println("READ> seccionParametros = no"); RESULT = null; :};

declaracionParametros  ::= parametro:param {: System.out.println("READ> declaracionParametros = uno/ultimo");
		ArrayList<SymbolIF> params = new ArrayList<SymbolIF>();
		params.add(((Parametro) param).getSymbolVariableIdentificador());
		 RESULT = params; :}
 | parametro:param COLON declaracionParametros:paramsEntrada {: System.out.println("READ> declaracionParametros = uno mas");
