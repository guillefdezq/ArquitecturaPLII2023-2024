// Declaracion de relaciones de precedencia
precedence left     AND_LOGICA;
precedence left		EQUAL;
precedence left		LOWER_THAN;
precedence left		PLUS;
precedence left		MULT;
precedence left		AUTO_INCREMENTO, NEGACION;
precedence right	OPEN_BRACKET, CLOSE_BRACKET;
precedence left 	OPEN_KEY, CLOSE_KEY;
precedence nonassoc SINO;
precedence nonassoc SI;
            

// Declaracion de reglas de produccion


start with program;

program ::= 
  {: 
        syntaxErrorManager.syntaxInfo ("Starting parsing..."); 

		scopeManager.openScope("global");
		ScopeIF scope = scopeManager.getCurrentScope();
		System.out.println("AMBT>comenzamos! " + scope.getName() + " (" + scope.getLevel() + ")");

		System.out.println("GLBL> creando tipos");
		//Obtenemos del ámbito creado la Tabla de Tipos y Símbolos
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();

		//Introduccion del Tipo Simple Entero o Integer y Logico o Booleano, vacio y vector
		TypeSimple tsEntero = new TypeSimple(scope);
			tsEntero.setName("ENTERO");
			typeTable.addType("ENTERO",tsEntero);

		TypeSimple tsLogico = new TypeSimple(scope); // DUDA: realmente se utiliza este?
			tsLogico.setName("LOGICO");
			typeTable.addType("LOGICO",tsLogico);

		// Es muy posible que este no sea necesario
		TypeSimple tsVacio = new TypeSimple(scope);
			tsVacio.setName("VACIO");
			typeTable.addType("VACIO",tsVacio);

		// Es muy posible que este no haga falta
		TypeArray tsVector = new TypeArray(scope);
			tsVector.setName("VECTORexp");
			typeTable.addType("VECTORexp",tsVector);

   :}
  axiom:ax
  {:   		
  		// No modificar esta estructura, aunque se pueden añadir más acciones semánticas
  		
  		//List intermediateCode = ax.getIntermediateCode ();
  		//finalCodeFactory.create (intermediateCode);

  		// En caso de no comentarse las dos sentencias anteriores se puede generar una excepcion
  		// en las llamadas a cupTest si el compilador no está completo. Esto es debido a que 
  		// aún no se tendrá implementada la generación de código intermedio ni final.
  		// Para la entrega final deberán descomentarse y usarse.
  		
		ScopeIF scope = scopeManager.getCurrentScope();
		System.out.println("AMBT>terminamos! " + scope.getName() + " (" + scope.getLevel() + ")");
		scopeManager.closeScope();

  		syntaxErrorManager.syntaxInfo ("Parsing process ended.");
  		
   :};


epsilon ::= ;

abrirAmbito ::= {:
		// abrir ámbito
		ScopeIF scope = scopeManager.getCurrentScope();
		scopeManager.openScope("ambito"+ (scope.getLevel()+1));
		System.out.println("AMBT>abrir " + "ambito"+ (scope.getLevel()+1) + " (" + (scope.getLevel()+1) + ")");
		// System.out.println(scopeManager.getAllScopes()); // Para debug
:}; 

cerrarAmbito ::= {:
		// cerrar ámbito
		ScopeIF scope = scopeManager.getCurrentScope();
		System.out.println("AMBT>cerrar " + scope.getName() + " (" + (scope.getLevel()) + ")");
		scopeManager.closeScope();
:}; 

axiom ::=  seccionConstantes seccionTipos  axiom1 {: System.out.println("READ> axiom = constantes y tipos"); RESULT = null; :} ;

axiom1 ::= seccionVariables seccionFunciones {: System.out.println("READ> axiom1 = variables y funciones"); RESULT = null; :}
  | seccionFunciones {: System.out.println("READ> axiom1 = solo funciones"); RESULT = null; :};

seccionConstantes ::= declaracionConstante seccionConstantes {: System.out.println("READ> seccionConstantes + recursion"); RESULT = null; :}
                      | epsilon {: System.out.println("READ> seccionConstantes = ya está"); RESULT = null; :};
                      
                      
declaracionConstante ::= CONSTANTE IDENTIFICADOR:id NUMERO:num SEMI_COLON {:
		System.out.println("READ> declaracionConstante");
		ScopeIF scope = scopeManager.getCurrentScope();
		SymbolTableIF sTable = scope.getSymbolTable(); 
		TypeTableIF typeTable = scope.getTypeTable ();
		String nombre = id.getLexema();
		String valor = num.getLexema();
		System.out.println("CONS>existe? "+sTable.containsSymbol(nombre));
		if (sTable.containsSymbol(nombre)) {  // MEJORA: añadir comprobación de nivel actual vs niveles anteriores (scopes)
			semanticErrorManager.semanticFatalError("Constante " + nombre + " ya declarada");
		} else {
			//introducimos en la tabla de símbolos la constante con su ámbito, nombre, tipo y su valor
			TypeIF tipo = scopeManager.searchType("ENTERO");
			SymbolConstant simboloConstante = new SymbolConstant(scope, nombre, tipo);
			simboloConstante.setValor(valor);
			sTable.addSymbol(nombre, simboloConstante);

			// Intentando buscar - TRY FETCH
			SymbolIF fetch = sTable.getSymbol(nombre);

			System.out.println("CONS>nuevo " + fetch.getName() + "@" + fetch.getScope().getName() + "=" + ((SymbolConstant)fetch).getValor());
		}
		RESULT = null;
 :};

seccionTipos ::= declaracionTipo seccionTipos {: System.out.println("READ> seccionTipos + recursion"); RESULT = null; :}
                      | epsilon {: System.out.println("READ> seccionTipos = ya está"); RESULT = null; :};
                      
declaracionTipo ::= TIPO ENTERO IDENTIFICADOR:id OPEN_BRACKET tamTipo:tam CLOSE_BRACKET SEMI_COLON {: 
		System.out.println("READ> declaracionTipo"); 
		
		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable(); 
		String nombre = id.getLexema();
		String tamano = tam.toString();
		
		if (typeTable.containsType(nombre)) {  // MEJORA: añadir comprobación de nivel actual vs niveles anteriores (scopes)
			semanticErrorManager.semanticFatalError("Tipo " + nombre + " ya declarada");
		} else {
			TypeArray tsVector = new TypeArray(scope);
			tsVector.setName(nombre);
			tsVector.setSize(Integer.parseInt(tamano));
			typeTable.addType(nombre,tsVector);

			// Mirando que tiene
			System.out.println("VCTR>NEW> " + nombre + "@" + scope.getName() + "=" + "tamaño(" + tamano + ")"); //contenido);

			// Intentando buscar - TRY FETCH
			TypeIF tipo = typeTable.getType(nombre);
			System.out.println(tipo);
		} //fin if

		RESULT = null; 
:};

tamTipo ::= NUMERO:numero {: 
System.out.println("READ> tamTipo = NUMERO = " + numero.getLexema()); 
if (!(Integer.parseInt(numero.getLexema()) > 0)) { semanticErrorManager.semanticFatalError("Tamaño de vector debe ser positivo"); }
RESULT = numero.getLexema(); :}
 | IDENTIFICADOR {: System.out.println("READ> tamTipo = IDENTIFICADOR = " + "sin definir"); RESULT = null; :};

seccionVariables ::= seccionVariables declaracionVariable {: System.out.println("READ> seccionVariables + recursion"); RESULT = null; :}
 | declaracionVariable {: System.out.println("READ> seccionVariables"); RESULT = null; :};

declaracionVariable ::= ENTERO listadoIDs:ids SEMI_COLON {:
		System.out.println("READ> declaracionVariable = ENTERO"); 

		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();
		ArrayList<String> nombres = ((Listadoids) ids).getIdentificadores();

		String contenido = null;
		if (nombres.size() > 1 && nombres.get(nombres.size()-2).contains("=")) { contenido = nombres.get(nombres.size()-1);} 

		//comprobamos que la variable no este ya declarada en la tabla de símbolos

		for (String nombre : nombres) {
			if (nombre.contains("=")) { break;} 
			if (sTable.containsSymbol(nombre)) {	// MEJORA: añadir comprobación de nivel actual vs niveles anteriores (scopes)
				semanticErrorManager.semanticFatalError("Variable " + nombre + " ya declarada");
			} else {
				//introducimos en la tabla de símbolos la constante con su ámbito, nombre, tipo y su valor
				TypeIF tipo = scopeManager.searchType("ENTERO");
				SymbolVariable simboloVariable = new SymbolVariable(scope, nombre, tipo);
				simboloVariable.setValor(contenido);
				sTable.addSymbol(nombre, simboloVariable);

				// Si se ha creado crrectamente
				SymbolIF fetch = sTable.getSymbol(nombre);
				System.out.println("VARI>nuevo " + fetch.getType().getName() + " " + fetch.getName() + "@" + fetch.getScope().getName() + "=" + ((SymbolVariable)fetch).getValor());
			} 
		}

		RESULT = null;		//RESULT = ids; 
 :}
                      | IDENTIFICADOR listadoIDs:ids SEMI_COLON {:
		System.out.println("READ> declaracionVariable = IDENTIFICADOR");

		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();
		ArrayList<String> nombres = ((Listadoids) ids).getIdentificadores();

		String contenido = null;
		if (nombres.size() > 1 && nombres.get(nombres.size()-2).contains("=")) { contenido = nombres.get(nombres.size()-1);} 

		//comprobamos que la variable no este ya declarada en la tabla de símbolos

		// DUDA: no creo que sea posible hacer asignaciones a vectores
		

		for (String nombre : nombres) {
			if (nombre.contains("=")) { semanticErrorManager.semanticFatalError("Declaraciones en vectores con valor no permitidas");}
			if (sTable.containsSymbol(nombre)) {	// MEJORA: añadir comprobación de nivel actual vs niveles anteriores (scopes)
				semanticErrorManager.semanticFatalError("Variable " + nombre + " ya declarada");
			} else {
				//introducimos en la tabla de símbolos la constante con su ámbito, nombre, tipo y su valor
				TypeIF tipo = scopeManager.searchType("ENTERO");
				SymbolVariable simboloVariable = new SymbolVariable(scope, nombre, tipo);
				simboloVariable.setValor(contenido);
				sTable.addSymbol(nombre, simboloVariable);

				// Si se ha creado crrectamente
				SymbolIF fetch = sTable.getSymbol(nombre);
				System.out.println("VARI>nuevo " + fetch.getType().getName() + " " + fetch.getName() + "@" + fetch.getScope().getName() + "=" + ((SymbolVariable)fetch).getValor());
			} 
		}

		RESULT = null;		//RESULT = ids; 
 :};
                      
listadoIDs ::= id:ident listadoIDs1:listadoIdents {: 
		System.out.println("READ> listadoIDs");
		Listadoids listado = new Listadoids();
		for (String element : (ArrayList<String>)ident) {  // ¿No sería más fácil usar sólo un tipo de adición?
		System.out.println("DEBUG");
			listado.addElement((String) element); 
		}
		listado.addList((Listadoids) listadoIdents);

		//ScopeIF ambito = scopeManager.getCurrentScope();

		RESULT = listado; 
 :};

listadoIDs1 ::= COLON listadoIDs:listadoIdents {:
		System.out.println("READ> listadoIDs1 = más variables");
		RESULT = listadoIdents;
 :}
                      | epsilon {:
		System.out.println("READ> listadoIDs1 = ya está");
		RESULT = new Listadoids();
 :};

id ::= IDENTIFICADOR:ident id1:asign {:
		System.out.println("READ> id"); 
		ArrayList<String> salida = new ArrayList<String>();  // MEJORA: Cambiar por listadoIDS
		salida.add(ident.getLexema());
		if (asign != null) {
			salida.add("=");
			salida.add((String)asign);
		}
		RESULT = salida;
 :};

id1 ::= epsilon {:
		System.out.println("READ> id1 = epsilon");
		RESULT = null;
 :}
        | ASSIGN NUMERO:num {: 
		System.out.println("READ> id1 = ASSIGN NUMERO"); 
		RESULT = num.getLexema();
 :};

seccionFunciones ::= funcion seccionFunciones {: System.out.println("READ> seccionFunciones = funciones extra"); RESULT = null; :}
                      | funcionPrincipal {: System.out.println("READ> seccionFunciones = funcion principal"); RESULT = null; :};
                      
funcion ::= VACIO IDENTIFICADOR abrirAmbito OPEN_KEY seccionParametros CLOSE_KEY OPEN_PARENTHESIS seccionTipos funcion1 {: System.out.println("READ> funcion = vacio"); RESULT = null; :}
            | ENTERO IDENTIFICADOR abrirAmbito OPEN_KEY seccionParametros CLOSE_KEY OPEN_PARENTHESIS seccionTipos funcion1 {: System.out.println("READ> funcion = entero"); RESULT = null; :};
                     
         
funcion1 ::= listadoSentencias CLOSE_PARENTHESIS cerrarAmbito {: System.out.println("READ> funcion1 = sinVariables"); RESULT = null; :}
                      | seccionVariables listadoSentencias  CLOSE_PARENTHESIS cerrarAmbito {: System.out.println("READ> funcion1 = conVariables"); RESULT = null; :};





seccionParametros ::= declaracionParametros {: System.out.println("READ> seccionParametros = sí"); RESULT = null; :}
 | epsilon {: System.out.println("READ> seccionParametros = no"); RESULT = null; :};

declaracionParametros  ::= parametro {: System.out.println("READ> declaracionParametros = uno/ultimo"); RESULT = null; :}
 | parametro COLON declaracionParametros {: System.out.println("READ> declaracionParametros = uno mas"); RESULT = null; :};

parametro ::= ENTERO IDENTIFICADOR {: System.out.println("READ> parametro = entero"); RESULT = null; :}
 | IDENTIFICADOR IDENTIFICADOR {: System.out.println("READ> parametro = identificador"); RESULT = null; :};

funcionPrincipal ::= VACIO principal abrirAmbito OPEN_KEY CLOSE_KEY OPEN_PARENTHESIS seccionTipos listadoSentencias CLOSE_PARENTHESIS cerrarAmbito {: System.out.println("READ> funcionPrincipal"); RESULT = null; :}
				  |  VACIO principal abrirAmbito OPEN_KEY CLOSE_KEY OPEN_PARENTHESIS seccionTipos seccionVariables listadoSentencias CLOSE_PARENTHESIS cerrarAmbito {: System.out.println("READ> funcionPrincipal + seccion variables"); RESULT = null; :};



// EXPRESIONES

expresion ::= NUMERO {: System.out.println("READ> expresion = NUMERO"); RESULT = null; :}
	| IDENTIFICADOR {: System.out.println("READ> expresion = IDENTIFICADOR"); RESULT = null; :}
	|  OPEN_KEY expresion CLOSE_KEY {: System.out.println("READ> expresion = OPEN_KEY expresion CLOSE_KEY"); RESULT = null; :}  // DUDA: Debería crear un ámbito aquí?
 	|  expresion PLUS expresion {: System.out.println("READ> expresion = PLUS"); RESULT = null; :}
 	|  expresion MULT expresion {: System.out.println("READ> expresion = MULT"); RESULT = null; :}
 	|  expresion AUTO_INCREMENTO expresion {: System.out.println("READ> expresion = AUTO_INCREMENTO"); RESULT = null; :}
 	|  NEGACION expresion {: System.out.println("READ> expresion = NEGACION"); RESULT = null; :}
 	|  expresion LOWER_THAN expresion {: System.out.println("READ> expresion = LOWER_THAN "); RESULT = null; :}
 	|  expresion EQUAL expresion {: System.out.println("READ> expresion = EQUAL "); RESULT = null; :}
 	|  expresion AND_LOGICA expresion {: System.out.println("READ> expresion = AND_LOGICA "); RESULT = null; :}
 	|  accesoVector {: System.out.println("READ> expresion = accesoVector"); RESULT = null; :}
 	|  llamadaFuncion {: System.out.println("READ> expresion = llamadaFuncion"); RESULT = null; :};

accesoVector ::= IDENTIFICADOR OPEN_BRACKET expresion CLOSE_BRACKET {: System.out.println("READ> accesoVector"); RESULT = null; :};

// DUDA: es necesario poner aquí ámbito?
llamadaFuncion ::= IDENTIFICADOR OPEN_KEY parametros CLOSE_KEY {: System.out.println("READ> llamadaFuncion = conParametros"); RESULT = null; :}
	| IDENTIFICADOR OPEN_KEY CLOSE_KEY {: System.out.println("READ> llamadaFuncion = sinParametros"); RESULT = null; :};
parametros ::= expresion {: System.out.println("READ> parametros = expresion"); RESULT = null; :}
 | expresion COLON parametros {: System.out.println("READ> parametros = expresion COLON parametros"); RESULT = null; :};

//  SENTENCIAS

bloque ::= OPEN_PARENTHESIS abrirAmbito seccionVariables listadoSentencias cerrarAmbito CLOSE_PARENTHESIS {: System.out.println("READ> bloque = OPEN_PARENTHESIS seccionVariables listadoSentencias CLOSE_PARENTHESIS"); RESULT = null; :}
 	|  OPEN_PARENTHESIS abrirAmbito listadoSentencias cerrarAmbito CLOSE_PARENTHESIS {: System.out.println("READ> bloque = OPEN_PARENTHESIS listadoSentencias CLOSE_PARENTHESIS"); RESULT = null; :};

listadoSentencias ::= listadoSentencias sentencia {: System.out.println("READ> listadoSentencias = listadoSentencias sentencia"); RESULT = null; :}
 | sentencia {: System.out.println("READ> listadoSentencias = sentencia"); RESULT = null; :};

sentencia ::= sentenciaDevuelve {: System.out.println("READ> sentencia = sentenciaDevuelve"); RESULT = null; :}
	| sentenciaIncremento {: System.out.println("READ> sentencia = sentenciaIncremento"); RESULT = null; :}
	| sentenciaAsignacion {: System.out.println("READ> sentencia = sentenciaAsignacion"); RESULT = null; :}
	| sentenciaAsignacionSuma {: System.out.println("READ> sentencia = sentenciaAsignacionSuma"); RESULT = null; :}
	| sentenciaSi {: System.out.println("READ> sentencia = sentenciaSi"); RESULT = null; :}
	| sentenciaAlternativas {: System.out.println("READ> sentencia = sentenciaAlternativas"); RESULT = null; :}
	| sentenciaMientras {: System.out.println("READ> sentencia = sentenciaMientras"); RESULT = null; :}
	| sentenciaLlamadaFuncion {: System.out.println("READ> sentencia = sentenciaLlamadaFuncion"); RESULT = null; :}
	| sentenciaSalida {: System.out.println("READ> sentencia = sentenciaSalida"); RESULT = null; :}
	| bloque {: System.out.println("READ> sentencia = bloque"); RESULT = null; :};

sentenciaDevuelve ::= DEVUELVE SEMI_COLON {: System.out.println("READ> sentenciaDevuelve"); RESULT = null; :}
	| DEVUELVE expresion SEMI_COLON {: System.out.println("READ> sentenciaDevuelve + expresion"); RESULT = null; :};

sentenciaIncremento ::= IDENTIFICADOR AUTO_INCREMENTO SEMI_COLON {: System.out.println("READ> sentenciaIncremento"); RESULT = null; :};

sentenciaAsignacion ::= ref ASSIGN expresion SEMI_COLON {: System.out.println("READ> sentenciaAsignacion"); RESULT = null; :};
ref ::= IDENTIFICADOR {: System.out.println("READ> ref"); RESULT = null; :}
 | accesoVector {: System.out.println("READ> accesoVector"); RESULT = null; :};

sentenciaAsignacionSuma ::= ref ASSIGN_SUMA expresion SEMI_COLON {: System.out.println("READ> sentenciaAsignacionSuma"); RESULT = null; :};

// ATENTO! No hace falta poner aquí ninguna apertura o cierre de ámbito, ya lo hace sentencia con bloque.
sentenciaSi ::= SI OPEN_KEY expresion CLOSE_KEY sentencia SINO sentencia {: System.out.println("READ> sentenciaSi + SINO"); RESULT = null; :}
	 | SI OPEN_KEY expresion CLOSE_KEY sentencia {: System.out.println("READ> sentenciaSi"); RESULT = null; :};
	
// 'Ergo', aquí tampoco hace falta, al usar bloque directamente.
sentenciaAlternativas ::= ALTENATIVAS OPEN_KEY expresion CLOSE_KEY OPEN_PARENTHESIS casosAlternativa porDefecto CLOSE_PARENTHESIS {: System.out.println("READ> sentenciaAlternativas"); RESULT = null; :};
casosAlternativa ::= casosAlternativa casoAlt {: System.out.println("READ> casosAlternativa = casoAlternativa"); RESULT = null; :}
 | casoAlt {: System.out.println("READ> casoAlternativa = casoAlt"); RESULT = null; :};

casoAlt ::= CASO NUMERO TWO_POINTS bloque CORTE SEMI_COLON {: System.out.println("READ> casoAlt"); RESULT = null; :};
porDefecto ::= PORDEFECTO TWO_POINTS bloque CORTE SEMI_COLON {: System.out.println("READ> porDefecto = PORDEFECTO"); RESULT = null; :}
 | epsilon {: System.out.println("READ> porDefecto = epsilon"); RESULT = null; :};

// Duda: está bien colocado el ámbito? tanto aquí como en el si y en el alternativas
sentenciaMientras ::= MIENTRAS OPEN_KEY expresion CLOSE_KEY abrirAmbito sentencia cerrarAmbito {: System.out.println("READ> sentenciaMientras"); RESULT = null; :};

sentenciaLlamadaFuncion ::= llamadaFuncion SEMI_COLON {: System.out.println("READ> sentenciaLlamadaFuncion"); RESULT = null; :};

sentenciaSalida ::=ESCRIBE OPEN_KEY opcionesEscribe CLOSE_KEY SEMI_COLON {: System.out.println("READ> sentenciaSalida = ESCRIBE"); RESULT = null; :}
	| ESCRIBE_ENT OPEN_KEY opcionesEscribeEnt CLOSE_KEY SEMI_COLON {: System.out.println("READ> sentenciaSalida = ESCRIBE_ENT"); RESULT = null; :};
opcionesEscribe ::= epsilon {: System.out.println("READ> opcionesEscribe = epsilon"); RESULT = null; :}
 | STRING {: System.out.println("READ> opcionesEscribe = STRING"); RESULT = null; :};
opcionesEscribeEnt ::= epsilon {: System.out.println("READ> opcionesEscribeEnt = epsilon"); RESULT = null; :}
 | expresion {: System.out.println("READ> opcionesEscribeEnt = expresion"); RESULT = null; :};
