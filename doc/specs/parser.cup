sentenciaDevuelve ::= DEVUELVE SEMI_COLON {: if (debugSout) System.out.println("READ> sentenciaDevuelve = vacío"); 
		Sentencia sen = new Sentenciadevuelve();

		if (debugSout) System.out.println(">>> nombreFuncion = " + nombreFuncion + " devuelve");

		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelFin = labelFactory.create("FIN_" + nombreFuncion);
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());
		intermediateCodeBuilder.addQuadruple("DEVUELTO", labelFin);
		sen.setIntermediateCode(intermediateCodeBuilder.create());
		RESULT = sen; :}
	| DEVUELVE expresion:exp SEMI_COLON {: 
		Expresion expr = (Expresion) exp;
		Sentencia sen = new Sentenciadevuelve(expr.getValor());

		if (debugSout) System.out.println(">>> nombreFuncion = " + nombreFuncion + " devuelve");

		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelFin = labelFactory.create("FIN_" + nombreFuncion);
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());
		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("DEVUELTO", labelFin, expr.getTemporal()); 
		sen.setIntermediateCode(intermediateCodeBuilder.create());
		if (debugSout) System.out.println("READ> sentenciaDevuelve + expresion = " + expr.getValor()); 
		RESULT = sen; :};

sentenciaIncremento ::= IDENTIFICADOR:ident AUTO_INCREMENTO SEMI_COLON {: if (debugSout) System.out.println("READ> sentenciaIncremento"); 
		
		String nombre = (String) ident.getLexema();
		SymbolIF sym = (SymbolIF) scopeManager.searchSymbol(nombre);
		SymbolVariable vari = (SymbolVariable) sym;

		if (sym.getType() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("Error en la línea " + ident.getLine() + ", caracter " + ident.getColumn() + ". " + "No se puede incrementar una variable de tipo " + sym.getType().getName() + ", únicamente enteros.");
		}
		if (!(sym instanceof SymbolVariable)) {
			semanticErrorManager.semanticFatalError("Error en la línea " + ident.getLine() + ", caracter " + ident.getColumn() + ". " + "Sólamente se pueden incrementar variables, no constantes u otro tipo.");
		}

		String valor = vari.getValor() + 1;

		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		
		Sentencia sentencia = new Sentencia();

		Variable variable = new Variable(((SymbolVariable)vari).getName(), sym.getScope());
		Value value = new Value(Integer.parseInt("1"));

		intermediateCodeBuilder.addQuadruple("ADD", variable, variable, value);
			

		sentencia.setIntermediateCode(intermediateCodeBuilder.create());


		if (debugSout) System.out.println("SN++> " + vari.getName() + " = " + valor);
		
		RESULT = sentencia;
		
		 :};

sentenciaAsignacion ::= ref:refe ASSIGN:id expresion:exp SEMI_COLON {: if (debugSout) System.out.println("READ> sentenciaAsignacion"); 

		Sentenciaasignacion sentenciaAsignacion = new Sentenciaasignacion();

		Expresion expr = (Expresion) exp;

		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);

		Ref ref = (Ref) refe;

		if (!ref.isExpresion()) {			// código de identificadores
			SymbolIF sym = ref.getSymbol();
			if (!(sym instanceof SymbolVariable)) {
				semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "No se puede asignar un valor a una variable de tipo " + sym.getType().getName());
			}

			if (sym.getType() != scopeManager.searchType("ENTERO")) {
				semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "No se puede asignar una variable de tipo " + sym.getType().getName() + ", únicamente enteros.");
			}

			SymbolVariable vari = (SymbolVariable) sym;

			if (sym.getType() != expr.getTipo()) {
				semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "No se puede asignar un valor de tipo " + expr.getTipo().getName() + " a una variable de tipo " + sym.getType().getName());
			}
			
			Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
			intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("MV", variable, expr.getTemporal());

			if (debugSout) System.out.println("ASIG> " + vari.getName() + " = " + expr.getValor());

		} else if (ref.isExpresion()) {			// código del vector
			Expresion refexpr = ref.getExpresion();
			SymbolIF sym = (SymbolIF) scopeManager.searchSymbol(refexpr.getNombreVector());
			if(sym.getType() instanceof TypeArray) {
				SymbolVariable vari = (SymbolVariable) sym;

				String[] vector = vari.getValor().split(",");
				String valorAGuardar = expr.getValor();
				int indice = 0;  // está claro que no es esta la posición, pero debido a cambios, este valor es un señuelo
				vector[indice] = valorAGuardar;
				String nuevoVector = String.join(",", vector);
				if (debugSout) System.out.println(nuevoVector);

				Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
				intermediateCodeBuilder.addQuadruples(refexpr.getIntermediateCode());
				intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
				intermediateCodeBuilder.addQuadruple("STV", variable, expr.getTemporal(), refexpr.getIndice());

				if (debugSout) System.out.println("ASIG> vector " + vari.getName() + "[" + indice + "] = " + valorAGuardar);
			} else {
				semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto.");
			}

		} else { semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto."); }

		sentenciaAsignacion.setIntermediateCode(intermediateCodeBuilder.create());
		if (debugSout) System.out.println("     QUAD>" + expr.getIntermediateCode());  
		RESULT = sentenciaAsignacion; 
		:};
ref ::= IDENTIFICADOR:ident {: if (debugSout) System.out.println("READ> ref"); 
		if (!(scopeManager.containsSymbol(ident.getLexema()))) {
			semanticErrorManager.semanticFatalError("Error en la línea " + ident.getLine() + ", caracter " + ident.getColumn() + ". " + "No se encuentra la variable " + ident.getLexema());
		}
		SymbolIF symbol = scopeManager.searchSymbol(ident.getLexema());
		RESULT = new Ref(symbol); :}
 | accesoVector:exp {: 
		RESULT = new Ref((Expresion) exp);	// Paso directamente la expresión
 		 :};

// Provisional ASSIGN_SUMA:id
sentenciaAsignacionSuma ::= ref:refe ASSIGN_SUMA:id expresion:exp SEMI_COLON {: if (debugSout) System.out.println("READ> sentenciaAsignacionSuma");
		Expresion expr = (Expresion) exp;
		Sentencia sen = new Sentencia();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());
		
		Ref ref = (Ref) refe;

		if (!ref.isExpresion()) {			// código de identificadores
			SymbolIF sym = ref.getSymbol();
			if (!(sym instanceof SymbolVariable)) {
				semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "No se puede asignar un valor a una variable de tipo " + sym.getType().getName());
			}

			if (sym.getType() != scopeManager.searchType("ENTERO")) {
				semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "No se puede incrementar una variable de tipo " + sym.getType().getName() + ", únicamente enteros.");
			}

			SymbolVariable vari = (SymbolVariable) sym;

			if (sym.getType() != expr.getTipo()) {
				semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "No se puede asignar un valor de tipo " + expr.getTipo().getName() + " a una variable de tipo " + sym.getType().getName());
			}

			Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
			intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruple("ADD", variable, variable, expr.getTemporal());

			if (debugSout) System.out.println("ASIG> " + vari.getName() + " = " + expr.getValor());

		} else if (ref.isExpresion()) {			// código del vector
			Expresion refexpr = ref.getExpresion();
			SymbolIF sym = (SymbolIF) scopeManager.searchSymbol(refexpr.getNombreVector());
			if(sym.getType() instanceof TypeArray) {
				SymbolVariable vari = (SymbolVariable) sym;

				String[] vector = vari.getValor().split(",");
				String valorAGuardar = Integer.toString(Integer.parseInt(expr.getValor())+Integer.parseInt(refexpr.getValor()));
				int indice = 0;  // está claro que no es esta la posición, pero debido a cambios de última hora, este valor es un señuelo
				vector[indice] = valorAGuardar;
				String nuevoVector = String.join(",", vector);
				if (debugSout) System.out.println(nuevoVector);

				Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
				intermediateCodeBuilder.addQuadruples(refexpr.getIntermediateCode());
				intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
				intermediateCodeBuilder.addQuadruple("ADD", variable, variable, expr.getTemporal());
				intermediateCodeBuilder.addQuadruple("STV", variable, expr.getTemporal(), refexpr.getTemporal());


				if (debugSout) System.out.println("ASIG> vector " + variable.getName() + "[" + indice + "] = " + valorAGuardar);
			} else {
				semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto.");
			}

		} else { semanticErrorManager.semanticFatalError("Error en la línea " + id.getLine() + ", caracter " + id.getColumn() + ". " + "Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto."); }

		sen.setIntermediateCode(intermediateCodeBuilder.create());
		RESULT = sen; :};

// No hace falta poner aquí ninguna apertura o cierre de ámbito, ya lo hace sentencia con bloque.
sentenciaSi ::= SI OPEN_KEY:check expresion:exp CLOSE_KEY sentencia:sentsi SINO sentencia:sentsino {: if (debugSout) System.out.println("READ> sentenciaSi + SINO"); 
		Expresion expr = (Expresion) exp;
		Sentencia sentenciasi = (Sentencia) sentsi;
		Sentencia sentenciasino = (Sentencia) sentsino;

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "No se puede comparar un valor de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}
		
		ScopeIF scope=scopeManager.getCurrentScope();
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelFinal=labelFactory.create();
		LabelIF labelElse=labelFactory.create();

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("BZ", expr.getTemporal(), labelElse);		// Ir al else si no coincide
		intermediateCodeBuilder.addQuadruples(sentenciasi.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("BR", labelFinal); //me salgo del if
		intermediateCodeBuilder.addQuadruple("INL", labelElse);
		intermediateCodeBuilder.addQuadruples(sentenciasino.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("INL", labelFinal);

		Sentenciasi sentenciasSi =new Sentenciasi(expr, sentenciasi, sentenciasino);
		sentenciasSi.setIntermediateCode(intermediateCodeBuilder.create());
		if (debugSout) System.out.println("     QUAD>" + sentenciasSi.getIntermediateCode());  

		RESULT = sentenciasSi; :}
	 | SI OPEN_KEY:check expresion:exp CLOSE_KEY sentencia:sentsi {: if (debugSout) System.out.println("READ> sentenciaSi");
		Expresion expr = (Expresion) exp;
		Sentencia sentenciasi = (Sentencia) sentsi;

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "No se puede comparar un valor de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}

		ScopeIF scope=scopeManager.getCurrentScope();
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelFinal=labelFactory.create();

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("BZ", expr.getTemporal(), labelFinal);	// Salir si no coincide
		intermediateCodeBuilder.addQuadruples(sentenciasi.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("INL", labelFinal);

		Sentenciasi sentenciasSi =new Sentenciasi(expr, sentenciasi);
		sentenciasSi.setIntermediateCode(intermediateCodeBuilder.create());
		if (debugSout) System.out.println("     QUAD>" + sentenciasSi.getIntermediateCode());  

		RESULT = sentenciasSi; :};
	
// 'Ergo', aquí tampoco hace falta, al usar bloque directamente.
sentenciaAlternativas ::= ALTENATIVAS OPEN_KEY:check expresion:exp CLOSE_KEY OPEN_PARENTHESIS casosAlternativa:casosAlter porDefecto:porD CLOSE_PARENTHESIS {: if (debugSout) System.out.println("READ> sentenciaAlternativas"); 
		Expresion expr = (Expresion) exp;
		Casosalternativa casos = (Casosalternativa) casosAlter;
		ArrayList<LabelIF> labels = new ArrayList<LabelIF>();

		Pordefecto porDefecto = (porD != null)? (Pordefecto) porD : null;

		if (debugSout) System.out.println((porDefecto != null)? "POR DEFECTO" : "SIN POR DEFECTO");

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "No se puede comparar un valor de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}


		ScopeIF scope=scopeManager.getCurrentScope();
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelFinal=labelFactory.create();

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);


		if (porDefecto != null) 
			casos.addPorDefecto(porDefecto);

		
		for (Casoalt casoalt : casos.getCasos()) 
			labels.add(labelFactory.create());


		if (debugSout) System.out.println("LABELS " + labels);

		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());

		for (int i = 0; i < labels.size(); i++) {
			if (i == labels.size()-1) {
				if (porDefecto != null) {
					intermediateCodeBuilder.addQuadruple("INL", labels.get(i));
					intermediateCodeBuilder.addQuadruples(casos.getCasos().get(i).getIntermediateCode());
				} else {
					intermediateCodeBuilder.addQuadruple("INL", labels.get(i));
					intermediateCodeBuilder.addQuadruple("CMP", expr.getTemporal(), casos.getCasos().get(i).getValor());
					intermediateCodeBuilder.addQuadruple("BNZ", labelFinal);
					intermediateCodeBuilder.addQuadruples(casos.getCasos().get(i).getIntermediateCode());
					intermediateCodeBuilder.addQuadruple("BR", labelFinal); 
				}
				
			} else {
				intermediateCodeBuilder.addQuadruple("INL", labels.get(i));
				intermediateCodeBuilder.addQuadruple("CMP", expr.getTemporal(), casos.getCasos().get(i).getValor());
				intermediateCodeBuilder.addQuadruple("BNZ", labels.get(i+1));
				intermediateCodeBuilder.addQuadruples(casos.getCasos().get(i).getIntermediateCode());
				intermediateCodeBuilder.addQuadruple("BR", labelFinal); 

			}
		}

		intermediateCodeBuilder.addQuadruple("INL", labelFinal);

		Sentenciaalternativas sentAlternativas =new Sentenciaalternativas();
		sentAlternativas.setIntermediateCode(intermediateCodeBuilder.create());
		if (debugSout) System.out.println("     QUAD>" + sentAlternativas.getIntermediateCode());  


		RESULT = sentAlternativas; :};


casosAlternativa ::= casosAlternativa:casos casoAlt:caso {: if (debugSout) System.out.println("READ> casosAlternativa = casoAlternativa"); 
	Casosalternativa casosAlternativa = (Casosalternativa) casos;
	casosAlternativa.addCaso((Casoalt) caso);
	RESULT = casosAlternativa; :}
 | casoAlt:caso {: if (debugSout) System.out.println("READ> casoAlternativa = casoAlt"); 
	Casosalternativa casosAlternativa = new Casosalternativa();
	casosAlternativa.addCaso((Casoalt) caso);
	RESULT = casosAlternativa; :};

casoAlt ::= CASO NUMERO:nume TWO_POINTS bloque:bloq CORTE SEMI_COLON {: if (debugSout) System.out.println("READ> casoAlt"); 
	int num = Integer.parseInt(nume.getLexema());
	Sentencia bloque = (Sentencia) bloq;

	ScopeIF scope = scopeManager.getCurrentScope();
	
	IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
	intermediateCodeBuilder.addQuadruples(bloque.getIntermediateCode());	

	Casoalt casoAlt = new Casoalt();
	casoAlt.setIntermediateCode(intermediateCodeBuilder.create());
	casoAlt.setValor(num);

	RESULT = casoAlt; 
	:};
porDefecto ::= PORDEFECTO TWO_POINTS bloque:bloq CORTE SEMI_COLON {: if (debugSout) System.out.println("READ> porDefecto = PORDEFECTO");

	ScopeIF scope = scopeManager.getCurrentScope();
	Sentencia bloque = (Sentencia) bloq;

	LabelFactory labelFactory = new LabelFactory();
	LabelIF labelPorDefecto = labelFactory.create();

	IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
	intermediateCodeBuilder.addQuadruples(bloque.getIntermediateCode());

	Pordefecto porDefecto = new Pordefecto();
	porDefecto.setIntermediateCode(intermediateCodeBuilder.create());
	if (debugSout) System.out.println("     QUAD>" + porDefecto.getIntermediateCode());

	RESULT = porDefecto; :}
 | epsilon {: if (debugSout) System.out.println("READ> porDefecto = epsilon"); RESULT = null; :};

sentenciaMientras ::= MIENTRAS OPEN_KEY:check expresion:exp CLOSE_KEY sentencia:sentmien {: if (debugSout) System.out.println("READ> sentenciaMientras");   
		Expresion expr = (Expresion) exp;
		Sentencia sentenciasmientras = (Sentencia) sentmien;

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "No se puede comparar un valor de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}

		ScopeIF scope=scopeManager.getCurrentScope();
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelInicio=labelFactory.create();
		LabelIF labelFinal=labelFactory.create();

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruple("INL", labelInicio);
		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("BZ", expr.getTemporal(), labelFinal);	// Salir si no coincide
		intermediateCodeBuilder.addQuadruples(sentenciasmientras.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("BR", labelInicio); //me salgo del while
		intermediateCodeBuilder.addQuadruple("INL", labelFinal);


		Sentenciamientras sentenciaMientras =new Sentenciamientras(expr, sentenciasmientras);
		sentenciaMientras.setIntermediateCode(intermediateCodeBuilder.create());
		if (debugSout) System.out.println("     QUAD>" + sentenciaMientras.getIntermediateCode());  

		RESULT = sentenciaMientras;

		:};

sentenciaLlamadaFuncion ::= llamadaFuncion:fun SEMI_COLON {: if (debugSout) System.out.println("READ> sentenciaLlamadaFuncion"); 
	Expresion func = (Expresion) fun;
	Sentencia sen = new Sentencia();
	sen.setIntermediateCode(func.getIntermediateCode());
	RESULT = sen; :};

sentenciaSalida ::=ESCRIBE OPEN_KEY opcionesEscribe:expr CLOSE_KEY SEMI_COLON {:
		Sentencia sen = new Sentencia();
		String salida = (String) expr;
		salida = (salida == null) ? "\\n" : salida.substring(1, salida.length() - 1) + "\\n";
		
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());
		LabelFactory labelFactory = new LabelFactory();
		LabelIF label = labelFactory.create();

		Value value = new Value(salida);
		intermediateCodeBuilder.addQuadruple("WRSTR", label);

		listaCadenas.add(new Quadruple("CADENA", new Label(salida), label));

		sen.setIntermediateCode(intermediateCodeBuilder.create());

		if (debugSout) System.out.println("READ> sentenciaSalida = ESCRIBE");
		if (debugSout) System.out.println("PRNT> " + salida); 
		RESULT = sen;
 :}
	| ESCRIBE_ENT OPEN_KEY opcionesEscribeEnt:exp CLOSE_KEY SEMI_COLON {: 
		Sentencia sen = new Sentencia();
		Expresion expr = (Expresion) exp;
		String salida = expr.getValor() + "\\n";	
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());
		LabelFactory labelFactory = new LabelFactory();
		LabelIF label = labelFactory.create();

		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());

		intermediateCodeBuilder.addQuadruple("WRINT", expr.getTemporal());

		sen.setIntermediateCode(intermediateCodeBuilder.create());

		if (debugSout) System.out.println("READ> sentenciaSalida = ESCRIBE_ENT"); 
		if (debugSout) System.out.println("PRNT> " + salida); 
		RESULT = sen;
 :};
opcionesEscribe ::= epsilon {:
		if (debugSout) System.out.println("READ> opcionesEscribe = epsilon");
		RESULT = null;
 :}
 | STRING:string {: 
 		if (debugSout) System.out.println("READ> opcionesEscribe = STRING"); 
		RESULT = string.getLexema();
 :};
opcionesEscribeEnt ::= epsilon {:
		if (debugSout) System.out.println("READ> opcionesEscribeEnt = epsilon");
		RESULT = new Expresion();
 :}
 | expresion:expr {:
		Expresion expresion = (Expresion) expr;
		if (expresion.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("Únicamente se pueden imprimir valores enteros.");
		}

		String salida = expresion.getValor();
		if (debugSout) System.out.println("READ> opcionesEscribeEnt = expresion = " + salida);
		RESULT = expresion;
 :};
