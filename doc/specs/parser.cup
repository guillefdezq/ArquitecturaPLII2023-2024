				symbol = tempScope.getSymbolTable().getSymbols().get(i);
				if (symbol instanceof SymbolVariable) {
					Variable variable = new Variable(symbol.getName(), symbol.getScope());
					intermediateCodeBuilder.addQuadruple("VARLOCAL", variable, 0);
				}	
			}
		}

		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();
		
		Funcion fp = new Funcion();

		// Añadir listado de sentencias
		Sentencia lt = (Sentencia) listsent;

		intermediateCodeBuilder.addQuadruples(lt.getIntermediateCode());

		intermediateCodeBuilder.addQuadruple("PUNTEROFINAL", temporal, direccion);

		fp.setIntermediateCode(intermediateCodeBuilder.create());

		System.out.println("     QUAD>" + fp.getIntermediateCode());

		RESULT = fp;  :};



// EXPRESIONES

expresion ::= NUMERO:num {: System.out.println("READ> expresion = NUMERO"); 
		String numero = num.getLexema();
		Expresion expr = new Expresion();

		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();

		Value value = new Value(Integer.parseInt(numero));
		intermediateCodeBuilder.addQuadruple("MV", temporal, value);

		expr.setTemporal(temporal);
		expr.setIntermediateCode(intermediateCodeBuilder.create());
		System.out.println("     QUAD>" + expr.getIntermediateCode());  

		expr.setTipo(scopeManager.searchType("ENTERO"));
		expr.setValor(numero);
		RESULT = expr; :}
	| IDENTIFICADOR:id {: 
		String identificador = id.getLexema(); 
		Expresion expr = new Expresion();
		if(!(scopeManager.containsSymbol(identificador))) {
			semanticErrorManager.semanticFatalError("La variable " + identificador + " no existe");
		}
		
		SymbolIF symbol = scopeManager.searchSymbol(identificador);

		// Get instance of symbol
		System.out.println(symbol.getClass());

		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();

		String numero = "";

		if (symbol instanceof SymbolVariable) {
			SymbolVariable vari = (SymbolVariable) symbol;
			Variable variable = new Variable(((SymbolVariable)vari).getName(), symbol.getScope());
			intermediateCodeBuilder.addQuadruple("MV", temporal, variable);
			numero = vari.getValor();
		} else if (symbol instanceof SymbolConstant) {
			SymbolConstant constant = (SymbolConstant) symbol;
			Value value = new Value(Integer.parseInt(((SymbolConstant) symbol).getValor()));
			intermediateCodeBuilder.addQuadruple("MV", temporal, value);
			numero = constant.getValor();
		} else {
			semanticErrorManager.semanticFatalError("La variable " + identificador + " no es una variable o constante");
		}

		System.out.println("READ> expresion = IDENTIFICADOR = " + numero + " " + symbol.getType() + " " + symbol.getClass() );

		expr.setTipo(symbol.getType());
		expr.setValor(numero);
		expr.setTemporal(temporal);
		expr.setIntermediateCode(intermediateCodeBuilder.create());
		System.out.println("     QUAD>" + expr.getIntermediateCode());  
		RESULT = expr;

 :}	|  OPEN_KEY expresion:exp CLOSE_KEY {: System.out.println("READ> expresion = OPEN_KEY expresion CLOSE_KEY");
 		Expresion expr = (Expresion) exp;
		System.out.println("(EX)> (" + expr.getValor() + ")");
		RESULT = expr; :}  // DUDA: Debería crear un ámbito aquí?
 	|  expresion:a PLUS expresion:b {: System.out.println("READ> expresion = PLUS"); 
			Expresion expr = new Expresion();
			Expresion expra = (Expresion) a;
			Expresion exprb = (Expresion) b;
			if (!(expra.getTipo().equals(exprb.getTipo()))) {
				semanticErrorManager.semanticFatalError("La expresión de suma requiere que los operandos sean del mismo tipo");
			} else if (!(expra.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("La expresión de suma requiere el operando izquierdo sea de tipo entero");
			} else if (!(exprb.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("La expresión de suma requiere el operando derecho sea de tipo entero");
			}
			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expra.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruples(exprb.getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("ADD", temporal, expra.getTemporal(), exprb.getTemporal());

			expr.setTipo(scopeManager.searchType("ENTERO"));
			expr.setValor(Integer.toString(Integer.parseInt(expra.getValor()) + Integer.parseInt(exprb.getValor())));		// MEJORA: debería poner todos estos como enteros y al terminar pasarlo a String (y ni siquiera)
			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());


			System.out.println("EXP+> " + expra.getValor() + "+" + exprb.getValor() + "=" + expr.getValor());
			System.out.println("     QUAD>" + expr.getIntermediateCode());  
			RESULT = expr; :}
 	|  expresion:a MULT expresion:b {: System.out.println("READ> expresion = MULT");
			Expresion expr = new Expresion();
			Expresion expra = (Expresion) a;
			Expresion exprb = (Expresion) b;
			if (!(expra.getTipo().equals(exprb.getTipo()))) {
				semanticErrorManager.semanticFatalError("La expresión de multiplicación requiere que los operandos sean del mismo tipo");
			} else if (!(expra.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("La expresión de multiplicación requiere el operando izquierdo sea de tipo entero");
			} else if (!(exprb.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("La expresión de multiplicación requiere el operando derecho sea de tipo entero");
			}

			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expra.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruples(exprb.getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("MUL", temporal, expra.getTemporal(), exprb.getTemporal());

			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());

			expr.setTipo(scopeManager.searchType("ENTERO"));
			expr.setValor(Integer.toString(Integer.parseInt(expra.getValor()) * Integer.parseInt(exprb.getValor())));		// MEJORA: debería poner todos estos como enteros y al terminar pasarlo a String (y ni siquiera)
			System.out.println("EXP*> " + expra.getValor() + "*" + exprb.getValor() + "=" + expr.getValor());
			System.out.println("     QUAD>" + expr.getIntermediateCode());  
			RESULT = expr; :}
 	|  expresion:exp AUTO_INCREMENTO {: System.out.println("READ> expresion = AUTO_INCREMENTO"); 
		
		Expresion expr = (Expresion) exp;

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("No se puede incrementar una variable de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}

		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();

		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
		intermediateCodeBuilder.addQuadruple("INC", temporal, expr.getTemporal());

		expr.setTemporal(temporal);
		expr.setIntermediateCode(intermediateCodeBuilder.create());

		String valor = expr.getValor();
		expr.setValor(Integer.toString((Integer.parseInt(valor) + 1)));

		System.out.println("EX++> " + expr.getValor());
		System.out.println("     QUAD>" + expr.getIntermediateCode());  
		
		RESULT = expr; :}
 	|  NEGACION expresion:exp {: System.out.println("READ> expresion = NEGACION"); 
			Expresion expr = (Expresion) exp;
			if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
				semanticErrorManager.semanticFatalError("No se puede negar una variable de tipo " + expr.getTipo().getName() + ", únicamente usando enteros.");
			}

			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruple("NEG", temporal, expr.getTemporal());  /// Duda: es esta?

			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());
			System.out.println("     QUAD>" + expr.getIntermediateCode());  

			expr.setTipo(scopeManager.searchType("ENTERO"));
			expr.setValor((Integer.parseInt(expr.getValor()) == 0)?"1":"0");		// MEJORA: debería poner todos estos como enteros y al terminar pasarlo a String (y ni siquiera)
			System.out.println("EXP-> " + expr.getValor());
			RESULT = expr; :}
 	|  expresion:a LOWER_THAN expresion:b {: System.out.println("READ> expresion = LOWER_THAN "); 
			Expresion expr = new Expresion();
			Expresion expra = (Expresion) a;
			Expresion exprb = (Expresion) b;
			if (!(expra.getTipo().equals(exprb.getTipo()))) {
				semanticErrorManager.semanticFatalError("La expresión de igualdad requiere que los operandos sean del mismo tipo");
			}

			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expra.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruples(exprb.getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("LS", temporal, expra.getTemporal(), exprb.getTemporal());

			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());

			expr.setTipo(scopeManager.searchType("ENTERO"));
			expr.setValor((Integer.parseInt(expra.getValor()) < Integer.parseInt(exprb.getValor()))?"1":"0");		// MEJORA: debería poner todos estos como enteros y al terminar pasarlo a String (y ni siquiera)
			System.out.println("EXP<> " + expra.getValor() + "<" + exprb.getValor() + "=" + expr.getValor());
			System.out.println("     QUAD>" + expr.getIntermediateCode());  
			RESULT = expr; :}
 	|  expresion:a EQUAL expresion:b {: System.out.println("READ> expresion = EQUAL "); 
			Expresion expr = new Expresion();
			Expresion expra = (Expresion) a;
			Expresion exprb = (Expresion) b;
			if (!(expra.getTipo().equals(exprb.getTipo()))) {
				semanticErrorManager.semanticFatalError("La expresión de igualdad requiere que los operandos sean del mismo tipo");
			}

			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expra.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruples(exprb.getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("EQ", temporal, expra.getTemporal(), exprb.getTemporal());

			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());

			expr.setTipo(scopeManager.searchType("ENTERO"));
			expr.setValor((Integer.parseInt(expra.getValor()) == Integer.parseInt(exprb.getValor()))?"1":"0");		// MEJORA: debería poner todos estos como enteros y al terminar pasarlo a String (y ni siquiera)
			System.out.println("EX==> " + expra.getValor() + "==" + exprb.getValor() + "=" + expr.getValor());
			System.out.println("     QUAD>" + expr.getIntermediateCode());  
			RESULT = expr; :}
 	|  expresion:a AND_LOGICA expresion:b {: System.out.println("READ> expresion = AND_LOGICA "); Expresion expr = new Expresion();
			Expresion expra = (Expresion) a;
			Expresion exprb = (Expresion) b;
			if (!(expra.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("La expresión AND requiere el operando izquierdo sea de tipo lógico");
			} else if (!(exprb.getTipo().equals(scopeManager.searchType("ENTERO")))) {
				semanticErrorManager.semanticFatalError("La expresión AND requiere el operando derecho sea de tipo lógico");
			}

			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expra.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruples(exprb.getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("AND", temporal, expra.getTemporal(), exprb.getTemporal());

			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());

			expr.setTipo(scopeManager.searchType("ENTERO"));
			expr.setValor((Integer.parseInt(expra.getValor()) == 1 && Integer.parseInt(exprb.getValor()) == 1)?"1":"0");		// MEJORA: debería poner todos estos como enteros y al terminar pasarlo a String (y ni siquiera)
			System.out.println("EX&&> " + expra.getValor() + "AND" + exprb.getValor() + "=" + expr.getValor());
			System.out.println("     QUAD>" + expr.getIntermediateCode());  
			RESULT = expr; :}
 	|  accesoVector:exp {: System.out.println("READ> expresion = accesoVector"); 
			Expresion expr = (Expresion) exp;

			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
			Variable variable = new Variable(expr.getNombreVector(), expr.getSymbolVariableIdentificador().getScope());
			intermediateCodeBuilder.addQuadruple("MVP", temporal, variable, expr.getIndice());

			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());
			// expr.setType(scopeManager.searchType("ENTERO")); // Esto no hace falta porque estamos reutilizando la expresión.
			System.out.println("     QUAD>" + expr.getIntermediateCode());  

			RESULT = expr; :}		// Lo mismo falta algo que escribir por aquí.
 	|  llamadaFuncion:exp {: 
			System.out.println("READ> expresion = llamadaFuncion"); 

			ScopeIF scope = scopeManager.getCurrentScope();

			Expresion expr = (Expresion) exp;

			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	

			/* WTF
			if (expr.getTipo() != null) {  /// Esto no se siente correcto
				expr.setType(scopeManager.searchType("VACIO"));
			} else {
				expr.setType(scopeManager.searchType("ENTERO"));
				intermediateCodeBuilder.addQuadruple("DEVUELTO", temporal);
				expr.setTemporal(temporal);
			}*/

			// expr.setTipo(...); // No necesario, estoy reutilizando la expresión.

			if (expr.getTipo() == scopeManager.searchType("ENTERO")) {
				intermediateCodeBuilder.addQuadruple("DEVUELTO", temporal);
				expr.setTemporal(temporal);
			}

			expr.setIntermediateCode(intermediateCodeBuilder.create());
			System.out.println("     QUAD>" + expr.getIntermediateCode());

			RESULT = expr; 
			:};

accesoVector ::= IDENTIFICADOR:id OPEN_BRACKET expresion:exp CLOSE_BRACKET {: System.out.println("READ> accesoVector");

		Expresion expr = (Expresion) exp;
		String identificador = id.getLexema(); 
		System.out.println(identificador);
		Expresion exprN = new Expresion();
		if(!(scopeManager.containsSymbol(identificador))) {
			semanticErrorManager.semanticFatalError("La variable " + identificador + " no existe");
		}
		
		SymbolIF symbol = scopeManager.searchSymbol(identificador);

		// Get instance of symbol
		//System.out.println(symbol.getClass());

		String numero = "";

		if (symbol instanceof SymbolVariable) {
			SymbolVariable variable = (SymbolVariable) symbol;
			if (!(variable.getType() instanceof TypeArray)) {
				semanticErrorManager.semanticFatalError("La variable " + identificador + " no es un vector.");
			}
			if (variable.getType().getSize() < Integer.parseInt(expr.getValor())) {
				semanticErrorManager.semanticFatalError("La variable " + identificador + " no tiene tantos elementos. Equivalente a un IndexOutOfBoundsException.");
			}
			exprN.setSymbolVariableIdentificador(variable);
			numero = variable.getValor().split(",")[Integer.parseInt(expr.getValor())];
		} else {
			semanticErrorManager.semanticFatalError("La variable " + identificador + " no es una variable.");
		}

		System.out.println("READ> expresion = accesoVector "+ symbol.getName() +" @pos"+ expr.getValor() +" = " + numero + " " + symbol.getType() + " ");

		exprN.setTipo(scopeManager.searchType("ENTERO"));	// Debería retirar el atributo de tipo. No se llega a utilizar.
		exprN.setValor(numero);
		exprN.setIndice(Integer.parseInt(expr.getValor()));
		exprN.setNombreVector(identificador);

		RESULT = exprN;
		 :};

// DUDA: es necesario poner aquí ámbito?
// IDEA: para los parámetros crear variables del tipo nombreFunción+Parametro+nombreParámetro o bien, crear en el no terminal un booleano que compruebe si es parámetro y su posición en la función.
llamadaFuncion ::= IDENTIFICADOR:ident OPEN_KEY parametros:params CLOSE_KEY {: System.out.println("READ> llamadaFuncion = conParametros");
		ScopeIF scope = scopeManager.getCurrentScope();
		SymbolProcedure funcion = (SymbolProcedure) scopeManager.searchSymbol(ident.getLexema());

		SymbolIF symbol = scopeManager.searchSymbol(ident.getLexema());

		// Get instance of symbol
		System.out.println(scopeManager.containsSymbol(ident.getLexema()));

		if (!(funcion instanceof SymbolFunction || funcion instanceof SymbolProcedure)) {
			semanticErrorManager.semanticFatalError("El identificador " + ident.getLexema() + " no es una función o procedimiento.");
		}
		
		ArrayList<SymbolIF> listaParametros = (ArrayList<SymbolIF>) funcion.getParameters();		// Lista de parámetros de la función
		ArrayList<String> parametros = (ArrayList<String>) params;		// Lista de parámetros de la declaración
		if (listaParametros.size() != parametros.size()) {
			semanticErrorManager.semanticFatalError("La función o procedimiento " + ident.getLexema() + " requiere " + listaParametros.size() + " parámetro(s)");
		}

		ArrayList<Expresion> expresionesParametro = new ArrayList<Expresion>();
		for (String parametro : parametros) {
			Expresion expresionParametro = new Expresion();
			expresionParametro.setValor(parametro);
			expresionParametro.setTipo(scopeManager.searchType("ENTERO"));
			expresionesParametro.add(expresionParametro);
		}
		// La comprobación de introducir tipos enteros ya debería realizarse previamente (o eso creo).


		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);

		Procedure procedure = new Procedure(funcion.getName(), funcion.getScope());

		intermediateCodeBuilder.addQuadruple("INICIA_FUNCION", procedure);

		for (int i = 0; i < expresionesParametro.size(); i++) {		/// Es muy probable que salte error. Las expresiones no tienen definido los temporales.
			intermediateCodeBuilder.addQuadruple("PARAM", expresionesParametro.get(expresionesParametro.size()-1-i).getTemporal());
		}

		intermediateCodeBuilder.addQuadruple("LLAMA_FUNCION", procedure);

		/// Falta codigo de devolución del resultado.
		
		Expresion expr = new Expresion();
		expr.setValor("9999");		// Este valor sirve únicamente de referencia, no devuelve valor real.
		//expr.setTipo(scopeManager.searchType("ENTERO"));
		expr.setTipo(((SymbolIF) funcion).getType());
		RESULT = expr; :}
	| IDENTIFICADOR:ident OPEN_KEY CLOSE_KEY {: System.out.println("READ> llamadaFuncion = sinParametros");
	 	ScopeIF scope = scopeManager.getCurrentScope();
		SymbolProcedure funcion = (SymbolProcedure) scopeManager.searchSymbol(ident.getLexema());
		
		if (!(funcion instanceof SymbolFunction || funcion instanceof SymbolProcedure)) {
			semanticErrorManager.semanticFatalError("El identificador " + ident.getLexema() + " no es una función o procedimiento.");
		}

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);

		Procedure procedure = new Procedure(funcion.getName(), funcion.getScope());

		intermediateCodeBuilder.addQuadruple("INICIA_FUNCION", procedure);

		intermediateCodeBuilder.addQuadruple("LLAMA_FUNCION", procedure);

		/// Falta codigo de devolución del resultado.
		
		Expresion expr = new Expresion();
		expr.setValor("9999");		// Este valor sirve únicamente de referencia, no devuelve valor real.
		expr.setTipo(scopeManager.searchType("ENTERO"));
		RESULT = expr; :};
parametros ::= expresion:exp {: System.out.println("READ> parametros = expresion"); 
		ArrayList<String> params = new ArrayList<String>();
		params.add(0, ((String)( (Expresion) exp).getValor()));
		 RESULT = params; :}
 | expresion:exp COLON parametros:paramsEntrada {: System.out.println("READ> parametros = expresion COLON parametros"); 
		ArrayList<String> params = (ArrayList<String>) paramsEntrada;
		params.add(0, ((String)( (Expresion) exp).getValor()));
 		 RESULT = params; :};

//  SENTENCIAS

bloque ::= OPEN_PARENTHESIS abrirAmbito seccionVariables listadoSentencias:sen cerrarAmbito CLOSE_PARENTHESIS {: System.out.println("READ> bloque = OPEN_PARENTHESIS seccionVariables listadoSentencias CLOSE_PARENTHESIS"); RESULT = sen; :}
 	|  OPEN_PARENTHESIS abrirAmbito listadoSentencias:sen cerrarAmbito CLOSE_PARENTHESIS {: System.out.println("READ> bloque = OPEN_PARENTHESIS listadoSentencias CLOSE_PARENTHESIS"); RESULT = sen; :};

listadoSentencias ::= listadoSentencias:listSent sentencia:sent {: System.out.println("READ> listadoSentencias = listadoSentencias sentencia"); 
		/// FALTA IMPLEMENTAR LAS SENTENCIAS
		
		Sentencia ls = (Sentencia) listSent;
		Sentencia s = (Sentencia) sent;
		List<QuadrupleIF> intermediateCode = ls.getIntermediateCode();
		intermediateCode.addAll(s.getIntermediateCode());
		s.setIntermediateCode(intermediateCode);

		System.out.println("     QUAD>" + s.getIntermediateCode());

		RESULT = s;
		:}
 | sentencia:sent {: System.out.println("READ> listadoSentencias = sentencia"); 
		Sentencia s = (Sentencia) sent;
		System.out.println("     QUAD>" + s.getIntermediateCode());
		RESULT = s; 
		:};

sentencia ::= sentenciaDevuelve:sen {: System.out.println("READ> sentencia = sentenciaDevuelve"); RESULT = sen; :}  // Debería devuelve tener alguna forma de terminar la ejecución?
	| sentenciaIncremento:sen {: System.out.println("READ> sentencia = sentenciaIncremento"); RESULT = sen; :}
	| sentenciaAsignacion:sen {: System.out.println("READ> sentencia = sentenciaAsignacion"); RESULT = sen; :}
	| sentenciaAsignacionSuma:sen {: System.out.println("READ> sentencia = sentenciaAsignacionSuma"); RESULT = sen; :}
	| sentenciaSi:sen {: System.out.println("READ> sentencia = sentenciaSi"); RESULT = sen; :}
	| sentenciaAlternativas:sen {: System.out.println("READ> sentencia = sentenciaAlternativas"); RESULT = null; :}
	| sentenciaMientras:sen {: System.out.println("READ> sentencia = sentenciaMientras"); RESULT = null; :}
	| sentenciaLlamadaFuncion:sen {: System.out.println("READ> sentencia = sentenciaLlamadaFuncion"); RESULT = null; :}
	| sentenciaSalida:sen {: System.out.println("READ> sentencia = sentenciaSalida"); RESULT = sen; :}
	| bloque:sen {: System.out.println("READ> sentencia = bloque"); RESULT = sen; :};

sentenciaDevuelve ::= DEVUELVE SEMI_COLON {: System.out.println("READ> sentenciaDevuelve = vacío"); 
		Sentencia sen = new Sentenciadevuelve();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());
		intermediateCodeBuilder.addQuadruple("DEVUELVE");
		sen.setIntermediateCode(intermediateCodeBuilder.create());
		RESULT = sen; :}
	| DEVUELVE expresion:exp SEMI_COLON {: 
		Expresion expr = (Expresion) exp;
		Sentencia sen = new Sentenciadevuelve(expr.getValor());
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());
		intermediateCodeBuilder.addQuadruple("DEVUELVE", expr.getTemporal());
		sen.setIntermediateCode(intermediateCodeBuilder.create());
		System.out.println("READ> sentenciaDevuelve + expresion = " + expr.getValor()); 
		RESULT = sen; :};

sentenciaIncremento ::= IDENTIFICADOR:iden AUTO_INCREMENTO SEMI_COLON {: System.out.println("READ> sentenciaIncremento"); 
		
		String nombre = (String) iden.getLexema();
		SymbolIF sym = (SymbolIF) scopeManager.searchSymbol(nombre);
		SymbolVariable vari = (SymbolVariable) sym;


		if (sym.getType() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("No se puede incrementar una variable de tipo " + sym.getType().getName() + ", únicamente enteros.");
		}
		if (!(sym instanceof SymbolVariable)) {
			semanticErrorManager.semanticFatalError("Sólamente se pueden incrementar variables, no constantes u otro tipo.");
		}

		String valor = vari.getValor();
		vari.setValor(Integer.toString((Integer.parseInt(valor) + 1)));


		// Código intermedio
		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		TemporalFactory temporalFactory = new TemporalFactory(scope);
		TemporalIF temporal = temporalFactory.create();

		// Lo que debería hacer:
		// obtener valor
		Variable variable = new Variable(((SymbolVariable)vari).getName(), sym.getScope());

		// En vez de esto...
		/*
			intermediateCodeBuilder.addQuadruple("MV", temporal, variable);

			// incrementar
			intermediateCodeBuilder.addQuadruple("INC", temporal, variable);

			// reasignar
			intermediateCodeBuilder.addQuadruple("MV", variable, temporal);
			
			
			sentencia.setTemporal(temporal);
		*/

		// Se puede hacer esto, INC varía directamente el valor en la memoria
		intermediateCodeBuilder.addQuadruple("INC", variable, variable);

		Sentencia sentencia = new Sentencia();
		sentencia.setIntermediateCode(intermediateCodeBuilder.create());


		System.out.println("SN++> " + vari.getName() + " = " + vari.getValor());
		
		RESULT = null;
		
		 :};

sentenciaAsignacion ::= ref:ref ASSIGN expresion:exp SEMI_COLON {: System.out.println("READ> sentenciaAsignacion"); 

		Sentenciaasignacion sentenciaAsignacion = new Sentenciaasignacion();

		Expresion expr = (Expresion) exp;


		ScopeIF scope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);



		// dividir en instancias de expresión o símbolo

		if (ref instanceof SymbolIF) {			// código del identificadores
			SymbolIF sym = (SymbolIF) ref;
			if (!(sym instanceof SymbolVariable)) {
				semanticErrorManager.semanticFatalError("No se puede asignar un valor a una variable de tipo " + sym.getType().getName());
			}

			if (sym.getType() != scopeManager.searchType("ENTERO")) {
				semanticErrorManager.semanticFatalError("No se puede incrementar una variable de tipo " + sym.getType().getName() + ", únicamente enteros.");
			}

			SymbolVariable vari = (SymbolVariable) sym;

			if (sym.getType() != expr.getTipo()) {
				semanticErrorManager.semanticFatalError("No se puede asignar un valor de tipo " + expr.getTipo().getName() + " a una variable de tipo " + sym.getType().getName());
			}
			
			Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
			intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruple("MV", variable, expr.getTemporal());

			vari.setValor(expr.getValor());
			System.out.println("ASIG> " + vari.getName() + " = " + expr.getValor());

		} else if (ref instanceof Expresion) {			// código del vector
			Expresion refexpr = (Expresion) ref;
			SymbolIF sym = (SymbolIF) scopeManager.searchSymbol(refexpr.getNombreVector());
			if(sym.getType() instanceof TypeArray) {
				SymbolVariable vari = (SymbolVariable) sym;
				int indice = refexpr.getIndice();
				if (vari.getType().getSize() < indice) {
					semanticErrorManager.semanticFatalError("La variable " + refexpr.getNombreVector() + " no tiene tantos elementos. Equivalente a un IndexOutOfBoundsException.");
				}

				String[] vector = vari.getValor().split(",");
				String valorAGuardar = expr.getValor();
				vector[indice] = valorAGuardar;
				String nuevoVector = String.join(",", vector);
				System.out.println(nuevoVector);

				vari.setValor(nuevoVector);

				Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
				intermediateCodeBuilder.addQuadruples(refexpr.getIntermediateCode());
				intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
				intermediateCodeBuilder.addQuadruple("STP", variable, expr.getTemporal(), refexpr.getIndice());		/// Puede estar mal construida

				System.out.println("ASIG> vector " + vari.getName() + "[" + indice + "] = " + valorAGuardar);
			} else {
				semanticErrorManager.semanticFatalError("Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto.");
			}

		} else { semanticErrorManager.semanticFatalError("Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto."); }

		sentenciaAsignacion.setIntermediateCode(intermediateCodeBuilder.create());
		System.out.println("     QUAD>" + expr.getIntermediateCode());  
		RESULT = sentenciaAsignacion; 
		:};
ref ::= IDENTIFICADOR:ident {: System.out.println("READ> ref"); 
		if (!(scopeManager.containsSymbol(ident.getLexema()))) {
			semanticErrorManager.semanticFatalError("No se encuentra la variable " + ident.getLexema());
		}
		SymbolIF symbol = scopeManager.searchSymbol(ident.getLexema());
		RESULT = symbol; :}
 | accesoVector:exp {: 
		RESULT = exp;	// Paso directamente la expresión
 		 :};

sentenciaAsignacionSuma ::= ref:ref ASSIGN_SUMA expresion:exp SEMI_COLON {: System.out.println("READ> sentenciaAsignacionSuma");
		Expresion expr = (Expresion) exp;
		Sentencia sen = new Sentencia();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());

		// dividir en instancias de expresión o símbolo

		if (ref instanceof SymbolIF) {			// código del identificadores
			SymbolIF sym = (SymbolIF) ref;
			if (!(sym instanceof SymbolVariable)) {
				semanticErrorManager.semanticFatalError("No se puede asignar un valor a una variable de tipo " + sym.getType().getName());
			}

			if (sym.getType() != scopeManager.searchType("ENTERO")) {
				semanticErrorManager.semanticFatalError("No se puede incrementar una variable de tipo " + sym.getType().getName() + ", únicamente enteros.");
			}

			SymbolVariable vari = (SymbolVariable) sym;

			if (sym.getType() != expr.getTipo()) {
				semanticErrorManager.semanticFatalError("No se puede asignar un valor de tipo " + expr.getTipo().getName() + " a una variable de tipo " + sym.getType().getName());
			}
			vari.setValor(expr.getValor());

			Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
			intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruple("ADD", variable, variable, expr.getTemporal());
			intermediateCodeBuilder.addQuadruple("MV", variable, expr.getTemporal());		// Modificar

			System.out.println("ASIG> " + vari.getName() + " = " + expr.getValor());

		} else if (ref instanceof Expresion) {			// código del vector
			Expresion refexpr = (Expresion) ref;
			SymbolIF sym = (SymbolIF) scopeManager.searchSymbol(refexpr.getNombreVector());
			if(sym.getType() instanceof TypeArray) {
				SymbolVariable vari = (SymbolVariable) sym;
				int indice = refexpr.getIndice();
				if (vari.getType().getSize() < indice) {
					semanticErrorManager.semanticFatalError("La variable " + refexpr.getNombreVector() + " no tiene tantos elementos. Equivalente a un IndexOutOfBoundsException.");
				}

				String[] vector = vari.getValor().split(",");
				String valorAGuardar = Integer.toString(Integer.parseInt(expr.getValor())+Integer.parseInt(refexpr.getValor()));
				vector[indice] = valorAGuardar;
				String nuevoVector = String.join(",", vector);
				System.out.println(nuevoVector);

				vari.setValor(nuevoVector);

				Variable variable = new Variable(((SymbolVariable)vari).getName(), vari.getScope());
				intermediateCodeBuilder.addQuadruples(refexpr.getIntermediateCode());
				intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());	
				intermediateCodeBuilder.addQuadruple("ADD", variable, variable, expr.getTemporal());
				intermediateCodeBuilder.addQuadruple("STP", variable, expr.getTemporal(), refexpr.getIndice());		/// Puede estar mal construida


				System.out.println("ASIG> vector " + variable.getName() + "[" + indice + "] = " + valorAGuardar);
			} else {
				semanticErrorManager.semanticFatalError("Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto.");
			}

		} else { semanticErrorManager.semanticFatalError("Ha ocurrido un error grave en la sentencia de asignación. No se ha detectado el tipo correcto."); }

		sen.setIntermediateCode(intermediateCodeBuilder.create());
		RESULT = sen; :};

// ATENTO! No hace falta poner aquí ninguna apertura o cierre de ámbito, ya lo hace sentencia con bloque.
sentenciaSi ::= SI OPEN_KEY expresion:exp CLOSE_KEY sentencia:sentsi SINO sentencia:sentsino {: System.out.println("READ> sentenciaSi + SINO"); 
		Expresion expr = (Expresion) exp;
		Sentencia sentenciasi = (Sentencia) sentsi;
		Sentencia sentenciasino = (Sentencia) sentsino;

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("No se puede comparar un valor de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}
		
		ScopeIF scope=scopeManager.getCurrentScope();
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelFinal=labelFactory.create();
		LabelIF labelElse=labelFactory.create();

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("BRF", expr.getTemporal(), labelElse);		// Ir al else si no coincide
		/// No terminado de declarar bien las sentencias de entremedias.
		intermediateCodeBuilder.addQuadruples(sentenciasi.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("BR", labelFinal); //me salgo del if
		intermediateCodeBuilder.addQuadruple("INL", labelElse);
		intermediateCodeBuilder.addQuadruples(sentenciasino.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("INL", labelFinal);

		Sentenciasi sentenciasSi =new Sentenciasi(expr, sentenciasi, sentenciasino);
		sentenciasSi.setIntermediateCode(intermediateCodeBuilder.create());
		System.out.println("     QUAD>" + sentenciasSi.getIntermediateCode());  

		RESULT = sentenciasSi; :}
	 | SI OPEN_KEY expresion:exp CLOSE_KEY sentencia:sentsi {: System.out.println("READ> sentenciaSi");
		Expresion expr = (Expresion) exp;
		Sentencia sentenciasi = (Sentencia) sentsi;

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("No se puede comparar un valor de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}

		ScopeIF scope=scopeManager.getCurrentScope();
		LabelFactory labelFactory = new LabelFactory();
		LabelIF labelFinal=labelFactory.create();
		LabelIF labelElse=labelFactory.create();

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruples(expr.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("BRF", expr.getTemporal(), labelFinal);	// Salir si no coincide
		/// No terminado de declarar bien las sentencias de entremedias.
		intermediateCodeBuilder.addQuadruples(sentenciasi.getIntermediateCode());
		//intermediateCodeBuilder.addQuadruple("BR", labelFinal); //me salgo del if
		//intermediateCodeBuilder.addQuadruple("INL", labelElse);
		//intermediateCodeBuilder.addQuadruples(sentenciasino.getIntermediateCode());
		intermediateCodeBuilder.addQuadruple("INL", labelFinal);

		Sentenciasi sentenciasSi =new Sentenciasi(expr, sentenciasi);
		sentenciasSi.setIntermediateCode(intermediateCodeBuilder.create());
		System.out.println("     QUAD>" + sentenciasSi.getIntermediateCode());  

		RESULT = sentenciasSi; :};
	
// 'Ergo', aquí tampoco hace falta, al usar bloque directamente.
sentenciaAlternativas ::= ALTENATIVAS OPEN_KEY expresion:exp CLOSE_KEY OPEN_PARENTHESIS casosAlternativa porDefecto CLOSE_PARENTHESIS {: System.out.println("READ> sentenciaAlternativas"); 
		Sentenciaalternativas sentAlternativas = new Sentenciaalternativas();
		Expresion expr = (Expresion) exp;

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("No se puede comparar un valor de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}

		RESULT = sentAlternativas; :};
casosAlternativa ::= casosAlternativa casoAlt {: System.out.println("READ> casosAlternativa = casoAlternativa"); RESULT = null; :}
 | casoAlt {: System.out.println("READ> casoAlternativa = casoAlt"); RESULT = null; :};

casoAlt ::= CASO NUMERO TWO_POINTS bloque CORTE SEMI_COLON {: System.out.println("READ> casoAlt"); RESULT = null; :};
porDefecto ::= PORDEFECTO TWO_POINTS bloque CORTE SEMI_COLON {: System.out.println("READ> porDefecto = PORDEFECTO"); RESULT = null; :}
 | epsilon {: System.out.println("READ> porDefecto = epsilon"); RESULT = null; :};

sentenciaMientras ::= MIENTRAS OPEN_KEY expresion:exp CLOSE_KEY sentencia {: System.out.println("READ> sentenciaMientras"); 
		Sentenciamientras sentMientras = new Sentenciamientras();
		Expresion expr = (Expresion) exp;

		if (expr.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("No se puede comparar un valor de tipo " + expr.getTipo().getName() + ", únicamente enteros.");
		}
		
		RESULT = sentMientras; :};

sentenciaLlamadaFuncion ::= llamadaFuncion SEMI_COLON {: System.out.println("READ> sentenciaLlamadaFuncion"); RESULT = null; :};

sentenciaSalida ::=ESCRIBE OPEN_KEY opcionesEscribe:expr CLOSE_KEY SEMI_COLON {:
		Sentencia sen = new Sentencia();
		String salida = (String) expr;
		
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());
		Value value = new Value(salida + '\0');
		intermediateCodeBuilder.addQuadruple("WRSTR", value);
		sen.setIntermediateCode(intermediateCodeBuilder.create());

		System.out.println("READ> sentenciaSalida = ESCRIBE");
		System.out.println("PRNT> " + salida); 
		RESULT = sen;
 :}
	| ESCRIBE_ENT OPEN_KEY opcionesEscribeEnt:expr CLOSE_KEY SEMI_COLON {: 
		Sentencia sen = new Sentencia();
		String salida = (String) expr;

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scopeManager.getCurrentScope());
		Value value = new Value(salida + '\0');
		intermediateCodeBuilder.addQuadruple("WRSTR", value);
		sen.setIntermediateCode(intermediateCodeBuilder.create());

		System.out.println("READ> sentenciaSalida = ESCRIBE_ENT"); 
		System.out.println("PRNT> " + salida); 
		RESULT = sen;
 :};
opcionesEscribe ::= epsilon {:
		System.out.println("READ> opcionesEscribe = epsilon");
		RESULT = null;
 :}
 | STRING:string {: 
 		System.out.println("READ> opcionesEscribe = STRING"); 
		RESULT = string.getLexema();
 :};
opcionesEscribeEnt ::= epsilon {:
		System.out.println("READ> opcionesEscribeEnt = epsilon");
		RESULT = null;
 :}
 | expresion:expr {:  // DUDA: se permite imprimir lógicos como uno o cero?
		Expresion expresion = (Expresion) expr;
		// Si es tipo lógico, escribir error semántico.
		if (expresion.getTipo() != scopeManager.searchType("ENTERO")) {
			semanticErrorManager.semanticFatalError("Únicamente se pueden imprimir valores enteros.");
		}

		String salida = expresion.getValor();
		System.out.println("READ> opcionesEscribeEnt = expresion = " + salida);
		RESULT = salida;
 :};
