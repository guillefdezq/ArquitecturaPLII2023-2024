			if (!(expra.getTipo().equals(exprb.getTipo()))) {
				semanticErrorManager.semanticFatalError("Error en la línea " + check.getLine() + ", caracter " + check.getColumn() + ". " + "La expresión de igualdad requiere que los operandos sean del mismo tipo");
			}

			ScopeIF scope = scopeManager.getCurrentScope();
			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
			TemporalFactory temporalFactory = new TemporalFactory(scope);
			TemporalIF temporal = temporalFactory.create();

			intermediateCodeBuilder.addQuadruples(expra.getIntermediateCode());	
			intermediateCodeBuilder.addQuadruples(exprb.getIntermediateCode());
			intermediateCodeBuilder.addQuadruple("LS", temporal, expra.getTemporal(), exprb.getTemporal());

			expr.setTemporal(temporal);
			expr.setIntermediateCode(intermediateCodeBuilder.create());

			expr.setTipo(scopeManager.searchType("ENTERO"));
			expr.setValor((Integer.parseInt(expra.getValor()) < Integer.parseInt(exprb.getValor()))?"1":"0");
			if (debugSout) System.out.println("EXP<> " + expra.getValor() + "<" + exprb.getValor() + "=" + expr.getValor());
			if (debugSout) System.out.println("     QUAD>" + expr.getIntermediateCode());  
			RESULT = expr; :}
 	|  expresion:a EQUAL:check expresion:b {: if (debugSout) System.out.println("READ> expresion = EQUAL "); 
			Expresion expr = new Expresion();
