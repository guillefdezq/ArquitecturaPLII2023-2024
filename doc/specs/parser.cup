// Declaracion de relaciones de precedencia
precedence left     AND_LOGICA;
precedence left		EQUAL;
precedence left		LOWER_THAN;
precedence left		PLUS;
precedence left		MULT;
precedence left		AUTO_INCREMENTO, NEGACION;
precedence right	OPEN_BRACKET, CLOSE_BRACKET;
precedence left 	OPEN_KEY, CLOSE_KEY;
precedence nonassoc SINO;
precedence nonassoc SI;
            

// Declaracion de reglas de produccion


start with program;

program ::= 
  {: 
        syntaxErrorManager.syntaxInfo ("Starting parsing..."); 

		// abrir ámbitos (resumido)
		scopeManager.openScope("global");
		ScopeIF scope = scopeManager.getCurrentScope();
		System.out.println("AMB: nuevo: " + scope.getName() + " (" + scope.getLevel() + ")");

		//Obtenemos del ámbito creado la Tabla del Tipos
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();



		//Introduccion del Tipo Simple Entero o Integer y Logico o Booleano, vacio y vector
		TypeSimple tsEntero = new TypeSimple(scope);
		tsEntero.setName("ENTERO");
		typeTable.addType("ENTERO",tsEntero);
		TypeSimple tsLogico = new TypeSimple(scope);
		tsLogico.setName("LOGICO");
		typeTable.addType("LOGICO",tsLogico);
		// Es muy posible que este no sea necesario
		TypeSimple tsVacio = new TypeSimple(scope);
		tsVacio.setName("VACIO");
		typeTable.addType("VACIO",tsVacio);

		TypeArray tsVector = new TypeArray(scope);
		tsVector.setName("VECTORexp");
		typeTable.addType("VECTORexp",tsVector);
		System.out.println("GLOBAL: creando tipos");

   :}
  axiom:ax
  {:   		

		// cerrar ámbito (resumido)
		ScopeIF scope = scopeManager.getCurrentScope();
		System.out.println("FIN: " + scope.getName());
		scopeManager.closeScope();

  		// No modificar esta estructura, aunque se pueden añadir más acciones semánticas
  		
  		//List intermediateCode = ax.getIntermediateCode ();
  		//finalCodeFactory.create (intermediateCode);

  		// En caso de no comentarse las dos sentencias anteriores se puede generar una excepcion
  		// en las llamadas a cupTest si el compilador no está completo. Esto es debido a que 
  		// aún no se tendrá implementada la generación de código intermedio ni final.
  		// Para la entrega final deberán descomentarse y usarse.
  		
  		syntaxErrorManager.syntaxInfo ("Parsing process ended.");
  		
   :};


epsilon ::= ;


axiom ::=  seccionConstantes seccionTipos  axiom1 ;

axiom1 ::= seccionVariables seccionFunciones {: RESULT = null; :}
 | seccionFunciones {: RESULT = null; :};

seccionConstantes ::= declaracionConstante seccionConstantes {: RESULT = null; :}
                      | epsilon {: RESULT = null; :};
                      
                      
declaracionConstante ::= CONSTANTE IDENTIFICADOR:id NUMERO:valor SEMI_COLON {: 
		//!!! A lo mejor esto está mal declarado
		// Copiado del vídeo de Pérez (mod)
		//recuperamos el ámbito donde nos encontramos y obtenemos la tabla de símbolos
		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable(); 
		String nombre = id.getLexema();
		String contenido = valor.getLexema();
		//comprobamos que la constante no este ya declarada en la tabla de símbolos
		if (sTable.containsSymbol(nombre)) {
			semanticErrorManager.semanticFatalError("Constante " + nombre + " ya declarada");
		} else {
			//introducimos en la tabla de símbolos la constante con su ámbito, nombre, tipo y su valor
			TypeIF tipo = scopeManager.searchType("ENTERO");
			SymbolConstant simboloConstante = new SymbolConstant(scope, nombre, tipo);
			simboloConstante.setValor(contenido);
			sTable.addSymbol(nombre, simboloConstante);

			// Mirando que tiene
		System.out.println("NEW: constante: " + nombre + "@" + scope.getName() + "=" + contenido);


		// Intentando buscar - TRY FETCH
		SymbolIF fetchSymbol = sTable.getSymbol(nombre);
		System.out.println(fetchSymbol.getType());

		} //fin if

		RESULT = null; 
:};

seccionTipos ::= declaracionTipo seccionTipos {: RESULT = null; :}		// recursividad para añadir más tipos
                      | epsilon {: RESULT = null; :};
                      
declaracionTipo ::= TIPO ENTERO IDENTIFICADOR:id OPEN_BRACKET tamTipo:tamtipo CLOSE_BRACKET SEMI_COLON {: // esto es para vectores (falta tamaño)
	//recuperamos el ámbito donde nos encontramos y obtenemos la tabla de símbolos
	ScopeIF scope = scopeManager.getCurrentScope();
	TypeTableIF typeTable = scope.getTypeTable ();
	SymbolTableIF sTable = scope.getSymbolTable(); 
	String nombre = id.getLexema();
	String tamano = tamtipo.toString();
	//comprobamos que la constante no este ya declarada en la tabla de símbolos
	if (typeTable.containsType(nombre)) {
		semanticErrorManager.semanticFatalError("Tipo " + nombre + " ya declarada");
	} else {
		TypeArray tsVector = new TypeArray(scope);
		tsVector.setName(nombre);
		// faltan métodos de tamaño y hacer con tam
		typeTable.addType(nombre,tsVector);
		typeTable.addType(nombre, tsVector);

		// Mirando que tiene
	System.out.println("NEW: vector: " + nombre + "@" + scope.getName() + "=" + "tamaño(" + tamano + ")"); //contenido);


	// Intentando buscar - TRY FETCH
	TypeIF tipo = typeTable.getType(nombre);
	System.out.println(tipo);

	} //fin if

	RESULT = null; 
:};

tamTipo ::= NUMERO:numero {: RESULT = numero.getLexema(); :} | IDENTIFICADOR:id {: 
	ScopeIF scope = scopeManager.getCurrentScope();
	TypeTableIF typeTable = scope.getTypeTable ();
	SymbolTableIF sTable = scope.getSymbolTable();
	String nombre = id.getLexema();
	if (!sTable.containsSymbol(nombre)) {
			semanticErrorManager.semanticFatalError("Variable " + nombre + " no localizada");
	}
	SymbolIF wsimbolo = sTable.getSymbol(nombre);  // No estoy inspirado, pero debería poder obtener el valor de la variable
	RESULT = null; 
:};  // En identificador, debería buscar este en la tabla de símbolos.

seccionVariables ::= seccionVariables declaracionVariable {: RESULT = null; :} | declaracionVariable {: RESULT = null; :};  // recursividad para declarar varias variables

declaracionVariable ::= ENTERO listadoIDs:ids SEMI_COLON {: 
	//!!! A lo mejor esto está mal declarado
	// Copiado del vídeo de Pérez (mod)
	//recuperamos el ámbito donde nos encontramos y obtenemos la tabla de símbolos
	ScopeIF scope = scopeManager.getCurrentScope();
	TypeTableIF typeTable = scope.getTypeTable ();
	SymbolTableIF sTable = scope.getSymbolTable();
	ArrayList<String> nombres = ((Listadoids) ids).getIdentificadores();
	String contenido = null;
	if (nombres.size() > 1 && nombres.get(nombres.size()-2).contains("=")) { contenido = nombres.get(nombres.size()-1);} 

	//comprobamos que la constante no este ya declarada en la tabla de símbolos

	for (String nombre : nombres) {
		if (nombre.contains("=")) { break;} 
		if (sTable.containsSymbol(nombre)) {
			semanticErrorManager.semanticFatalError("Variable " + nombre + " ya declarada");
		} else {
			//introducimos en la tabla de símbolos la constante con su ámbito, nombre, tipo y su valor
			TypeIF tipo = scopeManager.searchType("ENTERO");
			SymbolVariable simboloVariable = new SymbolVariable(scope, nombre, tipo);
			simboloVariable.setValor(contenido);
			sTable.addSymbol(nombre, simboloVariable);

			// Mirando que tiene
		System.out.println("NEW: entero: " + nombre + "@" + scope.getName() + "=" + contenido);

		// Intentando buscar - TRY FETCH
		SymbolIF fetchSymbol = sTable.getSymbol(nombre);
		System.out.println(fetchSymbol.getType());

		} //fin if

	} //fin for

	RESULT = ids; 
:}
                      | IDENTIFICADOR:id listadoIDs:ids SEMI_COLON {: 
	//!!! A lo mejor esto está mal declarado
	// Copiado del vídeo de Pérez (mod)
	//recuperamos el ámbito donde nos encontramos y obtenemos la tabla de símbolos
	ScopeIF scope = scopeManager.getCurrentScope();
	TypeTableIF typeTable = scope.getTypeTable ();
	SymbolTableIF sTable = scope.getSymbolTable();
	String identificador = id.getLexema(); 
	ArrayList<String> nombres = ((Listadoids) ids).getIdentificadores();
	String contenido = null;
	if (nombres.size() > 1 && nombres.get(nombres.size()-2).contains("=")) { contenido = nombres.get(nombres.size()-1);System.out.println("DETECTED VALUE = " + contenido);} 

	//comprobamos que la constante no este ya declarada en la tabla de símbolos

	// No sé si es posible hacer uso de asignación en variables que no son del tipo entero.

	for (String nombre : nombres) {
		if (nombre.contains("=")) { break;} 
		if (sTable.containsSymbol(nombre)) {
			semanticErrorManager.semanticFatalError("Variable " + nombre + " ya declarada");
		} else {
			//introducimos en la tabla de símbolos la constante con su ámbito, nombre, tipo y su valor
			if (!scopeManager.containsType(identificador)) { semanticErrorManager.semanticFatalError("Tipo \"" + nombre + "\" no existe"); }
			TypeIF tipo = scopeManager.searchType(identificador);
			SymbolVariable simboloVariable = new SymbolVariable(scope, nombre, tipo);
			simboloVariable.setValor(contenido);
			sTable.addSymbol(nombre, simboloVariable);

			// Mirando que tiene
		System.out.println("NEW: "+ identificador + ": " + nombre + "@" + scope.getName() + "=" + contenido);

		// Intentando buscar - TRY FETCH
		SymbolIF fetchSymbol = sTable.getSymbol(nombre);
		System.out.println(fetchSymbol.getType());

		} //fin if

	} //fin for

	RESULT = ids; 
:};
                      
listadoIDs ::= id:ident listadoIDs1:listadoIdents {: 
	Listadoids listado = new Listadoids();
	for (String element : (ArrayList<String>)ident) {  // ¿No sería más fácil usar sólo un tipo de adición?
		listado.addElement((String) element); 
	}
	listado.addList((Listadoids) listadoIdents);

	//ScopeIF ambito = scopeManager.getCurrentScope();
/* Código no revisado
	IntermediateCodeBuilder cb = new IntermediateCodeBuilder(ambito);
	cb.addQuadruples(s.getIntermediateCode());
	cb.addQuadruples(lista.getIntermediateCode());
	lista.setIntermediateCode(cb.create());
*/

	RESULT = listado; 
:};

listadoIDs1 ::= COLON listadoIDs:listadoIdents {: RESULT = listadoIdents; :}
                      | epsilon {: RESULT = new Listadoids(); :};

id ::= IDENTIFICADOR:ident id1:asign {:

	ArrayList<String> salida = new ArrayList<String>();
	salida.add(ident.getLexema());
	if (asign != null) {
		salida.add("=");
		salida.add((String)asign);
	}

// RESULT = ident.getLexema();
	RESULT = salida; 
:};

id1 ::= epsilon {: RESULT = null; :}
        | ASSIGN NUMERO:num {: RESULT = num.getLexema(); :};

seccionFunciones ::= funcion seccionFunciones {: RESULT = null; :}
                      | funcionPrincipal {: RESULT = null; :};
                      
funcion ::= VACIO IDENTIFICADOR:id nuevobloque OPEN_KEY seccionParametros CLOSE_KEY OPEN_PARENTHESIS seccionTipos funcion1
{: 
 :}
            | ENTERO IDENTIFICADOR:id nuevobloque  OPEN_KEY seccionParametros CLOSE_KEY OPEN_PARENTHESIS seccionTipos funcion1:salida
{: 
	// creo que la salida viene del último no terminal
	// RESULT = salida;
:};		// El RESULT debe devolver lo que se encuentre en la variable return de algunas de estas opciones...
                     
         
funcion1 ::= listadoSentencias:salida CLOSE_PARENTHESIS {: 
	ScopeIF scope = scopeManager.getCurrentScope();

	// cerrar ámbito (resumido)
	System.out.println("FIN: " + scope.getName());
	scopeManager.closeScope();
	// RESULT = salida; ?
	RESULT = null; 
:}
					| seccionVariables listadoSentencias:salida  CLOSE_PARENTHESIS {: 
	ScopeIF scope = scopeManager.getCurrentScope();

	// cerrar ámbito (resumido)
	System.out.println("FIN: " + scope.getName());
	scopeManager.closeScope();
	// RESULT = salida; ?
	RESULT = null; 
:};


seccionParametros ::= declaracionParametros {: RESULT = null; :} | epsilon {: RESULT = null; :};

declaracionParametros  ::= parametro {: RESULT = null; :} | parametro COLON declaracionParametros {: RESULT = null; :};

parametro ::= ENTERO IDENTIFICADOR {: 
	//Insertar tabla de tipos
	RESULT = null;
:} | IDENTIFICADOR IDENTIFICADOR {: 
	//Insertar tabla de tipos
	RESULT = null; 
:};

funcionPrincipal ::= VACIO principal:id OPEN_KEY CLOSE_KEY nuevobloque OPEN_PARENTHESIS seccionTipos listadoSentencias CLOSE_PARENTHESIS
{:
	ScopeIF scope = scopeManager.getCurrentScope();

	// cerrar ámbito (resumido)
	System.out.println("FIN: " + scope.getName());
	scopeManager.closeScope();

	//System.out.println ( "El nombre del nuevo ambito es: " + scope.getName());
	//System.out.println ("El nivel del ambito es: " + scope.getLevel());
	//System.out.println("AMB: " + scope.getName() + " (" + scope.getLevel() + ")");
	//SymbolTableIF tablaSimbolosPrincipal = scope.getSymbolTable();
	//System.out.println("Probando esto " + tablaSimbolosPrincipal);
	//TypeTableIF tablaTiposPrincipal = scope.getTypeTable();
	//System.out.println("Otra vez probando " + tablaTiposPrincipal);
	
	//SymbolIF fxprincipal = new SymbolProcedure(scope, "procedureprincipal", null);
	//fxprincipal.setName("FuncionPrincipal");
	//sTable.addSymbol(fxprincipal);

	RESULT = null;
:}
	|  VACIO principal:id OPEN_KEY CLOSE_KEY nuevobloque OPEN_PARENTHESIS seccionTipos seccionVariables listadoSentencias CLOSE_PARENTHESIS {: 
	ScopeIF scope = scopeManager.getCurrentScope();
	// cerrar ámbito (resumido)
	System.out.println("FIN: " + scope.getName());
	scopeManager.closeScope();
	RESULT = null; 
:};

nuevobloque ::= {:
	// abrir ámbitos (resumido)
	scopeManager.openScope("nuevoBloque"+ scopeManager.getCurrentScope().getLevel());
	ScopeIF scope = scopeManager.getCurrentScope();
	System.out.println("AMB: nuevo: " + scope.getName() + " (" + scope.getLevel() + ")");
:}; 

// EXPRESIONES

expresion ::= NUMERO:num {: RESULT = num; :} | IDENTIFICADOR:id {: RESULT = id; :}  // En este a lo mejor lo que tendría que hacer es buscar el valor almacenado en el identificador
	|  OPEN_KEY expresion:expr CLOSE_KEY  {: RESULT = expr; :}
 	|  expresion:a PLUS expresion:b {: RESULT = null; :}
 	|  expresion:a MULT expresion:b {: RESULT = null; :}
 	|  expresion:autoincre AUTO_INCREMENTO {: RESULT = null; :}
 	|  NEGACION expresion:negac {: RESULT = null; :}
 	|  expresion LOWER_THAN expresion {: RESULT = null; :}
 	|  expresion EQUAL expresion {: RESULT = null; :}
 	|  expresion AND_LOGICA expresion {: RESULT = null; :}
 	|  accesoVector {: RESULT = null; :}
 	|  llamadaFuncion {: RESULT = null; :};

accesoVector ::= IDENTIFICADOR OPEN_BRACKET expresion CLOSE_BRACKET {: RESULT = null; :};

llamadaFuncion ::= IDENTIFICADOR OPEN_KEY parametros CLOSE_KEY {: RESULT = null; :}
	| IDENTIFICADOR OPEN_KEY CLOSE_KEY {: RESULT = null; :};
parametros ::= expresion {: RESULT = null; :} | expresion COLON parametros {: RESULT = null; :};
// Hacer una lista como en la lista de identificadores pero con ¿expresiones?

//  SENTENCIAS

bloque ::= OPEN_PARENTHESIS nuevobloque seccionVariables listadoSentencias CLOSE_PARENTHESIS {: 
	// abrir ámbitos (resumido)
	//scopeManager.openScope("bloque");//id.getLexema());
	ScopeIF scope = scopeManager.getCurrentScope();
	//System.out.println("AMB: " + scope.getName() + " (" + scope.getLevel() + ")");

	// cerrar ámbito (resumido)
	System.out.println("FIN: " + scope.getName());
	scopeManager.closeScope();
	RESULT = null; 
:}
 	|  OPEN_PARENTHESIS listadoSentencias CLOSE_PARENTHESIS {: 
	// abrir ámbitos (resumido)
	//scopeManager.openScope("bloque");//id.getLexema());
	ScopeIF scope = scopeManager.getCurrentScope();
	//System.out.println("AMB: " + scope.getName() + " (" + scope.getLevel() + ")");

	// cerrar ámbito (resumido)
	System.out.println("FIN: " + scope.getName());
	scopeManager.closeScope();
	RESULT = null; 
:};

listadoSentencias ::= listadoSentencias sentencia {: RESULT = null; :} | sentencia {: RESULT = null; :};

sentencia ::= sentenciaDevuelve {: RESULT = null; :}
	| sentenciaIncremento {: RESULT = null; :}
	| sentenciaAsignacion {: RESULT = null; :}
	| sentenciaAsignacionSuma {: RESULT = null; :}
	| sentenciaSi {: RESULT = null; :}
	| sentenciaAlternativas {: RESULT = null; :}
	| sentenciaMientras {: RESULT = null; :}
	| sentenciaLlamadaFuncion {: RESULT = null; :}
	| sentenciaSalida {: RESULT = null; :}
	| bloque {: RESULT = null; :};

sentenciaDevuelve ::= DEVUELVE SEMI_COLON {: RESULT = null; :}	
	| DEVUELVE expresion:expr SEMI_COLON {: RESULT = expr; :};  // Entiendo que esto es lo que le debe devolver...?

sentenciaIncremento ::= IDENTIFICADOR AUTO_INCREMENTO SEMI_COLON {: RESULT = null; :};

sentenciaAsignacion ::= ref ASSIGN expresion SEMI_COLON {: RESULT = null; :};
ref ::= IDENTIFICADOR {: RESULT = null; :} | accesoVector {: RESULT = null; :};

sentenciaAsignacionSuma ::= ref ASSIGN_SUMA expresion SEMI_COLON {: RESULT = null; :};

sentenciaSi ::= SI OPEN_KEY expresion CLOSE_KEY sentencia SINO sentencia {: RESULT = null; :}
	 | SI OPEN_KEY expresion CLOSE_KEY sentencia {: RESULT = null; :};
	
sentenciaAlternativas ::= ALTENATIVAS OPEN_KEY expresion CLOSE_KEY OPEN_PARENTHESIS nuevobloque casosAlternativa porDefecto CLOSE_PARENTHESIS {: 
	// abrir ámbitos (resumido)
	//scopeManager.openScope("alternativas");//id.getLexema());
	ScopeIF scope = scopeManager.getCurrentScope();
	//System.out.println("AMB: " + scope.getName() + " (" + scope.getLevel() + ")");

	// cerrar ámbito (resumido)
	System.out.println("FIN: " + scope.getName());
	scopeManager.closeScope();
	RESULT = null; 
:};
casosAlternativa ::= casosAlternativa casoAlt {: RESULT = null; :} | casoAlt {: RESULT = null; :};

casoAlt ::= CASO NUMERO TWO_POINTS bloque CORTE SEMI_COLON {: RESULT = null; :};
porDefecto ::= PORDEFECTO TWO_POINTS bloque CORTE SEMI_COLON {: RESULT = null; :} | epsilon {: RESULT = null; :}; 

sentenciaMientras ::= MIENTRAS OPEN_KEY expresion CLOSE_KEY sentencia {: RESULT = null; :};

sentenciaLlamadaFuncion ::= llamadaFuncion SEMI_COLON {: RESULT = null; :};

sentenciaSalida ::=ESCRIBE OPEN_KEY opcionesEscribe:salida CLOSE_KEY SEMI_COLON 
{: System.out.println("CodInt: PRINT: " + salida); RESULT = null; :} // Entiendo que aquí tiene que ser más profesional y hacer referencia a la tabla de símbolos
	| ESCRIBE_ENT OPEN_KEY opcionesEscribeEnt CLOSE_KEY SEMI_COLON {: RESULT = null; :};
opcionesEscribe ::= epsilon {: RESULT = null; :} | STRING:string {: RESULT = string; :};
opcionesEscribeEnt ::= epsilon {: RESULT = null; :} | expresion {: RESULT = null; :};
