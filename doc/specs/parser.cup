// Declaracion de relaciones de precedencia
precedence left     AND_LOGICA;
precedence left		EQUAL;
precedence left		LOWER_THAN;
precedence left		PLUS;
precedence left		MULT;
precedence left		AUTO_INCREMENTO, NEGACION;
precedence right	OPEN_BRACKET, CLOSE_BRACKET;
precedence left 	OPEN_KEY, CLOSE_KEY;
precedence nonassoc SINO;
precedence nonassoc SI;
            

// Declaracion de reglas de produccion


start with program;

program ::= 
  {: 
        syntaxErrorManager.syntaxInfo ("Starting parsing..."); 

		scopeManager.openScope("global");
		ScopeIF scope = scopeManager.getCurrentScope();
		System.out.println("AMBT>comenzamos! " + scope.getName() + " (" + scope.getLevel() + ")");

		System.out.println("GLBL> creando tipos");
		//Obtenemos del ámbito creado la Tabla de Tipos y Símbolos
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();

		//Introduccion del Tipo Simple Entero o Integer y Logico o Booleano, vacio y vector
		TypeSimple tsEntero = new TypeSimple(scope);
			tsEntero.setName("ENTERO");
			typeTable.addType("ENTERO",tsEntero);

		// Es muy posible que este no sea necesario
		TypeSimple tsVacio = new TypeSimple(scope);
			tsVacio.setName("VACIO");
			typeTable.addType("VACIO",tsVacio);

		/*
		// Este no hace falta, sólo lo tengo como referencia para uso posterior.
		TypeArray tsVector = new TypeArray(scope);
			tsVector.setName("VECTORexp");
			typeTable.addType("VECTORexp",tsVector);
		*/

   :}
  axiom:ax
  {:   		
  		// No modificar esta estructura, aunque se pueden añadir más acciones semánticas

  		List intermediateCode = ax.getIntermediateCode ();
		finalCodeFactory.setEnvironment(CompilerContext.getExecutionEnvironment());		// instrucción introducida por vídeo Gamboa
  		finalCodeFactory.create (intermediateCode);

  		// En caso de no comentarse las dos sentencias anteriores se puede generar una excepcion
  		// en las llamadas a cupTest si el compilador no está completo. Esto es debido a que 
  		// aún no se tendrá implementada la generación de código intermedio ni final.
  		// Para la entrega final deberán descomentarse y usarse.
  		
		ScopeIF scope = scopeManager.getCurrentScope();
		System.out.println("AMBT>terminamos! " + scope.getName() + " (" + scope.getLevel() + ")");

		System.out.println("\n P A R S E R    F I N A L I Z A N D O . . .");
		System.out.println("Atención: si esta es la primera línea que está leyendo después de que el compilador haya terminado es muy probable que algo haya fallado en la compilación.");

		semanticErrorManager.semanticDebug("Tabla de Simbolos: " + scopeManager.getCurrentScope().getSymbolTable());
		semanticErrorManager.semanticDebug("Tabla de Tipos:    " + scopeManager.getCurrentScope().getTypeTable());
		semanticErrorManager.semanticDebug("Tabla de Temporales: " + scopeManager.getCurrentScope().getTemporalTable());
		scopeManager.closeScope();

		System.out.println("\n\n\n");
		semanticErrorManager.semanticDebug("           [[[ C O D I G O   I N T E R M E D I O ]]]");
		for (QuadrupleIF cuadrupla : ax.getIntermediateCode()) {
			semanticErrorManager.semanticDebug(cuadrupla.toString());
		}
		System.out.println("\n\n\n");

  		syntaxErrorManager.syntaxInfo ("Parsing process ended.");
  		
   :};


epsilon ::= ;

abrirAmbito ::= {:
		// abrir ámbito
		ScopeIF scope = scopeManager.getCurrentScope();
		scopeManager.openScope("ambito"+ (scope.getLevel()+1));
		System.out.println("AMBT>abrir " + "ambito"+ (scope.getLevel()+1) + " (" + (scope.getLevel()+1) + ")");
		// System.out.println(scopeManager.getAllScopes()); // Para debug
:}; 

cerrarAmbito ::= {:
		// cerrar ámbito
		ScopeIF scope = scopeManager.getCurrentScope();
		System.out.println("AMBT>cerrar " + scope.getName() + " (" + (scope.getLevel()) + ")");
		semanticErrorManager.semanticDebug("Tabla de Simbolos: " + scopeManager.getCurrentScope().getSymbolTable());
		semanticErrorManager.semanticDebug("Tabla de Tipos:    " + scopeManager.getCurrentScope().getTypeTable());
		semanticErrorManager.semanticDebug("Tabla de Temporales: " + scopeManager.getCurrentScope().getTemporalTable());
		scopeManager.closeScope();
:}; 

axiom ::=  seccionConstantes seccionTipos  axiom1:axi1 {: 
		System.out.println("READ> axiom = constantes y tipos"); 
		
		ScopeIF thisScope = scopeManager.getCurrentScope();
		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(thisScope);

		intermediateCodeBuilder.addQuadruple("AXIOM");		/// Puede ser que esto no sea necesario

		int direccionGlobal=10000;		//// Las variables globales deberían colocarse desde aquí

		for(int i=0;i<thisScope.getSymbolTable().getSymbols().size();i++) {
			SymbolIF symbol=thisScope.getSymbolTable().getSymbols().get(i);
			if(symbol instanceof SymbolVariable) {
				((SymbolVariable)symbol).setAddress(direccionGlobal);					/// No debería ser constante?		// Además las direcciones son machacadas por el bucle de a continuación.
				//Actualizamos el valor de direccionGlobal para el próximo símbolo 
				direccionGlobal = direccionGlobal + symbol.getType().getSize();
				System.out.println("variable: " + symbol.getType());
				System.out.println("tamano: " + symbol.getType().getSize());
			}
		}

		List<ScopeIF> scopes = scopeManager.getAllScopes();



		for (ScopeIF scope : scopes) {
			int direccionRA = 4;
			List<SymbolIF> symbols = scope.getSymbolTable().getSymbols();
			for (SymbolIF symbol : symbols) {
				if (symbol instanceof SymbolParameter) {
					if (((SymbolParameter)symbol).getAddress() != 0) continue;
					((SymbolParameter)symbol).setAddress(direccionRA);
					direccionRA = direccionRA + symbol.getType().getSize();
					System.out.println("Parametro: " + ((SymbolParameter)symbol).getName() + ". Dir: " + ((SymbolParameter)symbol).getAddress());
				}
			}

			if (scope.getLevel() != 0) {
				direccionRA ++;
			}

			for (SymbolIF symbol : symbols) {
				if (symbol instanceof SymbolVariable) {
					if (((SymbolVariable)symbol).getAddress() != 0) continue;
					((SymbolVariable)symbol).setAddress(direccionRA);
					direccionRA = direccionRA + symbol.getType().getSize();
				}
			}

			List<TemporalIF> temps = scope.getTemporalTable().getTemporals();
			for (TemporalIF temporal : temps) {
				if (temporal.getAddress() != 0) continue;
				((Temporal) temporal).setAddress(direccionRA);
				direccionRA = direccionRA + ((Temporal) temporal).getSize();
			}
		}

		/*	Deshabilitado: nunca se hace referencia a estas constantes por dirección, sino por su valor copiado directamente en el código final.
		for (int i = 0; i < thisScope.getSymbolTable().getSymbols().size(); i++) {
			SymbolIF symbol = thisScope.getSymbolTable().getSymbols().get(i);
			if (symbol instanceof SymbolConstant) {
				Variable variable = new Variable(symbol.getName(), symbol.getScope());
				intermediateCodeBuilder.addQuadruple("VARGLOBAL", variable, 0);
			}
		}
		*/

		// Axiom ax = new Axiom(); // No puedo declarar un abstracto, así que haré una subclase
		AxiomaCompilador ax = new AxiomaCompilador();

		/// Falta añadir tipos?

		Program ax1 = (Program) axi1;

		List<QuadrupleIF> intermediateCode = intermediateCodeBuilder.create();
		intermediateCode.addAll(ax1.getIntermediateCode());

		if (thisScope.getLevel() == 0) {		// Y esta comprobacion tan random?
			for (int i = 0; i < listaCadenas.size(); i++) {
				intermediateCodeBuilder.addQuadruple(listaCadenas.get(i));
			}
		}

		ax.setIntermediateCode(intermediateCode);

		/*
		System.out.print("IMPRIMIENDO CONTENIDOS DE AXIOMA: ");
		System.out.println(ax.getIntermediateCode());
		*/

		RESULT = (Axiom) ax;
		:} ;

axiom1 ::= seccionVariables:secVar seccionFunciones:secFun {: 
		System.out.println("READ> axiom1 = variables y funciones");

		ScopeIF scope = scopeManager.getCurrentScope();

		/// Se siente muy vacío... no debería contener código intermedio? Tal vez sea necesario para añadir las cuádruplas de las funciones y parámetros

		Program ax1 = new Program();
		Seccionfunciones sf = (Seccionfunciones) secFun;
		ax1.setIntermediateCode(sf.getIntermediateCode());

		RESULT = ax1; 
		:}
  | seccionFunciones:secFun {: 
  		System.out.println("READ> axiom1 = solo funciones");

		ScopeIF scope = scopeManager.getCurrentScope();

		Program ax1 = new Program();
		Seccionfunciones sf = (Seccionfunciones) secFun;
		ax1.setIntermediateCode(sf.getIntermediateCode());

		RESULT = ax1; 
		:};

seccionConstantes ::= declaracionConstante seccionConstantes {: System.out.println("READ> seccionConstantes + recursion"); RESULT = null; :}
                      | epsilon {: System.out.println("READ> seccionConstantes = ya está"); RESULT = null; :};
                      
                      
declaracionConstante ::= CONSTANTE IDENTIFICADOR:id NUMERO:num SEMI_COLON {:
		System.out.println("READ> declaracionConstante");
		ScopeIF scope = scopeManager.getCurrentScope();
		SymbolTableIF sTable = scope.getSymbolTable(); 
		TypeTableIF typeTable = scope.getTypeTable ();
		String nombre = id.getLexema();
		String valor = num.getLexema();
		System.out.println("CONS>existe? "+sTable.containsSymbol(nombre));
		if (sTable.containsSymbol(nombre)) {
			semanticErrorManager.semanticFatalError("Constante " + nombre + " ya declarada");
		} else {
			//introducimos en la tabla de símbolos la constante con su ámbito, nombre, tipo y su valor
			TypeIF tipo = scopeManager.searchType("ENTERO");
			SymbolConstant simboloConstante = new SymbolConstant(scope, nombre, tipo);
			simboloConstante.setValor(valor);
			sTable.addSymbol(nombre, simboloConstante);

			// Intentando buscar - TRY FETCH
			SymbolIF fetch = sTable.getSymbol(nombre);

			System.out.println("CONS>nuevo " + fetch.getName() + "@" + fetch.getScope().getName() + "=" + ((SymbolConstant)fetch).getValor());
			
			Declaracionconstante declCons = new Declaracionconstante(simboloConstante);
			RESULT = declCons;
		}

 :};

seccionTipos ::= declaracionTipo seccionTipos {: System.out.println("READ> seccionTipos + recursion"); RESULT = null; :}
                      | epsilon {: System.out.println("READ> seccionTipos = ya está"); RESULT = null; :};
                      
declaracionTipo ::= TIPO ENTERO IDENTIFICADOR:id OPEN_BRACKET tamTipo:tam CLOSE_BRACKET SEMI_COLON {: 
		System.out.println("READ> declaracionTipo"); 
		
		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable(); 
		String nombre = id.getLexema();
		int tamano = Integer.parseInt(tam.toString());
		
		if (typeTable.containsType(nombre)) {
			semanticErrorManager.semanticFatalError("Tipo " + nombre + " ya declarado.");
		} else {			
			TypeArray tsVector = new TypeArray (scope, nombre, tamano);	
			typeTable.addType(nombre,tsVector);

			// Mirando que tiene
			System.out.println("VCTR>NEW> " + nombre + "@" + scope.getName() + "=" + "tamaño(" + tamano + ")"); //contenido);

		} //fin if

		RESULT = null; 
:};

tamTipo ::= NUMERO:numero {: 
		System.out.println("READ> tamTipo = NUMERO = " + numero.getLexema()); 
		if (!(Integer.parseInt(numero.getLexema()) > 0)) { semanticErrorManager.semanticFatalError("Tamaño de vector debe ser positivo"); }
		RESULT = numero.getLexema(); :}
 | IDENTIFICADOR:id {: 
		String cadena = id.getLexema();
		SymbolIF symbol = (SymbolIF) scopeManager.searchSymbol(cadena);
		String numero = "";
		if (symbol instanceof SymbolVariable) {
			SymbolVariable variable = (SymbolVariable) symbol;
			numero = variable.getValor();
		} else if (symbol instanceof SymbolConstant) {
			SymbolConstant constant = (SymbolConstant) symbol;
			numero = constant.getValor();
		} else {
			semanticErrorManager.semanticFatalError("La variable " + cadena + " no es una variable o constante");
		}
		System.out.println("READ> tamTipo = IDENTIFICADOR = " + numero);
 		RESULT = numero; :};

seccionVariables ::= seccionVariables declaracionVariable {: System.out.println("READ> seccionVariables + recursion"); RESULT = null; :}
 | declaracionVariable {: System.out.println("READ> seccionVariables"); RESULT = null; :};

declaracionVariable ::= ENTERO listadoIDs:ids SEMI_COLON {:
		System.out.println("READ> declaracionVariable = ENTERO"); 

		Declaracionvariable declVar = new Declaracionvariable((TypeSimple) scopeManager.searchType("ENTERO"), (Listadoids) ids);

		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();

			IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);


		ArrayList<Id> identificadores = ((Listadoids) ids).getObjetos();

		for (Id id : identificadores) {
			String nombre = id.getNombre(); 
			if (sTable.containsSymbol(nombre)) {
				semanticErrorManager.semanticFatalError("Variable " + nombre + " ya declarada");
			} else {
				TypeIF tipo = scopeManager.searchType("ENTERO");
				SymbolVariable simboloVariable = new SymbolVariable(scope, nombre, tipo);
				if (id.getValor() != null) { 
					Value value = new Value(Integer.parseInt(id.getValor()));
					simboloVariable.setValor(id.getValor()); 
					Variable variable = new Variable(((SymbolVariable)simboloVariable).getName(), ((SymbolVariable)simboloVariable).getScope());
					intermediateCodeBuilder.addQuadruple("MV", variable, value);
				}
				sTable.addSymbol(nombre, simboloVariable);
				
				SymbolIF fetch = sTable.getSymbol(nombre);
				System.out.println("VARI>nuevo " + fetch.getType().getName() + " " + fetch.getName() + "@" + fetch.getScope().getName() + "=" + ((SymbolVariable)fetch).getValor());
			}
		}

			declVar.setIntermediateCode(intermediateCodeBuilder.create());
			System.out.println("     QUAD>" + declVar.getIntermediateCode());  
		RESULT = declVar;		//RESULT = ids; 
 :}
                      | IDENTIFICADOR:ident listadoIDs:ids SEMI_COLON {:
		System.out.println("READ> declaracionVariable = IDENTIFICADOR");

		Declaracionvariable declVar = new Declaracionvariable((TypeIF) scopeManager.searchType(ident.getLexema()), (Listadoids) ids);

		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();

		ArrayList<Id> identificadores = ((Listadoids) ids).getObjetos();

		for (Id id : identificadores) {
			String nombre = id.getNombre();
			if (sTable.containsSymbol(nombre)) {
				semanticErrorManager.semanticFatalError("Variable " + nombre + " ya declarada");
			} else {
				TypeIF tipo = scopeManager.searchType(ident.getLexema());
				SymbolVariable simboloVariable = new SymbolVariable(scope, nombre, tipo);
				if (id.getValor() != null) { semanticErrorManager.semanticFatalError("Declaraciones en vectores con valor no permitidas"); }
				int size = ((TypeArray)tipo).getSize();
				String comas = "";
				
				for (int i = 1; i < size; i++) comas += "0,";
				comas += "0";

				simboloVariable.setValor(comas);
				sTable.addSymbol(nombre, simboloVariable);
				
				SymbolIF fetch = sTable.getSymbol(nombre);
				System.out.println("VARI>nuevo " + fetch.getType().getName() + " " + fetch.getName() + "[" + simboloVariable.getType().getSize() + "]" + "@" + fetch.getScope().getName() + "=" + ((SymbolVariable)fetch).getValor());
			}
		}

		RESULT = declVar;		//RESULT = ids; 
 :};
                      
listadoIDs ::= id:ident listadoIDs1:listadoIdents {: 
		System.out.println("READ> listadoIDs");
		

				// Nuevo Sistema
		Listadoids listado = (Listadoids) listadoIdents;
		Id identificador = (Id) ident;
		listado.addObjeto(identificador);

		System.out.print("LIDS> ");

		// Print names from ArrayList in the same line
		for (Id id : listado.getObjetos()) {
			System.out.print(id.getNombre() + " ");
		}
		System.out.println();



		RESULT = listado; 
 :};

listadoIDs1 ::= COLON listadoIDs:listadoIdents {:
		System.out.println("READ> listadoIDs1 = más variables");
		RESULT = listadoIdents;
 :}
                      | epsilon {:
		System.out.println("READ> listadoIDs1 = ya está");
		RESULT = new Listadoids();
 :};

id ::= IDENTIFICADOR:ident id1:asign {:
		System.out.println("READ> id"); 

		// Nueva implementación
		Id identificador = new Id();
		identificador.setNombre(ident.getLexema());
		if (asign != null) {
			System.out.println("ID> Asignar valor " + asign);
			identificador.setValor((String) asign);
		} else { System.out.println("ID> No asignar valor"); identificador.setValor(null);}
		System.out.println("ID> Testing data = " + identificador.getValor());
		RESULT = identificador;
 :};

id1 ::= epsilon {:
		System.out.println("READ> id1 = epsilon");
		RESULT = null;
 :}
        | ASSIGN NUMERO:num {: 
		System.out.println("READ> id1 = ASSIGN NUMERO"); 
		RESULT = num.getLexema();
 :};

seccionFunciones ::= funcion:fun seccionFunciones:secFun {: 
		System.out.println("READ> seccionFunciones = funciones extra"); 
		Funcion f = (Funcion) fun;
		Seccionfunciones sf = (Seccionfunciones) secFun;
		List<QuadrupleIF> intermediateCode = f.getIntermediateCode(); // se busca "la primera funcion" antes de las demás
		intermediateCode.addAll(sf.getIntermediateCode()); // las demás funciones se añaden a continuación
		sf.setIntermediateCode(intermediateCode);
		RESULT = sf; 
	:}
                      | funcionPrincipal:funPrin {: 
		System.out.println("READ> seccionFunciones = funcion principal"); 
		Funcion fp = (Funcion) funPrin;
