		params.add(((Parametro) param).getSymbolVariableIdentificador());
 		 RESULT = params; :};

parametro ::= ENTERO:entero IDENTIFICADOR:id {: System.out.println("READ> parametro = entero"); 
				
		

		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();

		String nombre = id.getLexema(); 
		if (sTable.containsSymbol(nombre)) {
			semanticErrorManager.semanticFatalError("Variable " + nombre + " ya declarada");
		} else {
			TypeIF tipo = scopeManager.searchType("ENTERO");
			SymbolVariable simboloVariable = new SymbolVariable(scope, nombre, tipo);
			simboloVariable.setValor("0");
			sTable.addSymbol(nombre, simboloVariable);
			SymbolIF fetch = sTable.getSymbol(nombre);
			System.out.println("VARI>nuevo " + fetch.getType().getName() + " " + fetch.getName() + "@" + fetch.getScope().getName() + "=" + ((SymbolVariable)fetch).getValor());
			Parametro parametro = new Parametro(simboloVariable);
			System.out.println(parametro.getSymbolVariableIdentificador());
			RESULT = parametro; 
		}

		:}
 | IDENTIFICADOR:ident IDENTIFICADOR:id {: System.out.println("READ> parametro = identificador"); 
		


		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();

		String nombre = id.getLexema(); 
		if (sTable.containsSymbol(nombre)) {
			semanticErrorManager.semanticFatalError("Variable " + nombre + " ya declarada");
		} else {
			TypeIF tipo = scopeManager.searchType(ident.getLexema());
			SymbolVariable simboloVariable = new SymbolVariable(scope, nombre, tipo);
			sTable.addSymbol(nombre, simboloVariable);
			
			SymbolIF fetch = sTable.getSymbol(nombre);
			System.out.println("VARI>nuevo " + fetch.getType().getName() + " " + fetch.getName() + "@" + fetch.getScope().getName() + "=" + ((SymbolVariable)fetch).getValor());

			Parametro parametro = new Parametro(simboloVariable);
			RESULT = parametro; 
		}

		:};

funcionPrincipal ::= VACIO principal abrirAmbito OPEN_KEY CLOSE_KEY OPEN_PARENTHESIS seccionTipos listadoSentencias:listSent CLOSE_PARENTHESIS cerrarAmbito {: System.out.println("READ> funcionPrincipal"); 
		ScopeIF scope = scopeManager.getCurrentScope();
		TypeTableIF typeTable = scope.getTypeTable ();
		SymbolTableIF sTable = scope.getSymbolTable();

		String identificador = "principal";

		SymbolProcedure simboloProcedimiento = new SymbolProcedure(scopeManager.getCurrentScope(), identificador, (TypeIF) scopeManager.searchType("VACIO"));

		sTable.addSymbol(identificador, simboloProcedimiento);

		int direccion = 4;
		SymbolIF symbol;
		for (int i = 0; i < sTable.getSymbols().size(); i++) {
			symbol = sTable.getSymbols().get(i);
			if (symbol instanceof SymbolVariable) {
				((SymbolVariable) symbol).setAddress(direccion);
				direccion += symbol.getType().getSize();
			}			
		}

		List<ScopeIF> listScopeHijos = scopeManager.getAllScopes();



		for (ScopeIF tempScope: listScopeHijos) {
			for (int i = 0; i < tempScope.getSymbolTable().getSymbols().size(); i++) {
				symbol = tempScope.getSymbolTable().getSymbols().get(i);
				if (symbol instanceof SymbolVariable) {
					((SymbolVariable) symbol).setAddress(direccion);
					direccion += symbol.getType().getSize();
				}
			}
		}

		for (int i = 0 ; i < scope.getTemporalTable().getTemporals().size(); i++) {
			TemporalIF temporal = scope.getTemporalTable().getTemporals().get(i);
			if (temporal instanceof Temporal) {
				((Temporal) temporal).setAddress(direccion);
				//direccion += temporal.getType().getSize();
				direccion += ((Temporal) temporal).getSize();
			}
		}

		
		for (ScopeIF tempScope: listScopeHijos) {
			for (int i = 0; i < tempScope.getTemporalTable().getTemporals().size(); i++) {
				TemporalIF temporal = tempScope.getTemporalTable().getTemporals().get(i);
				if (temporal instanceof Temporal) {
					((Temporal) temporal).setAddress(direccion);
					direccion += ((Temporal) temporal).getSize();
				}
			}
		}
		

		IntermediateCodeBuilder intermediateCodeBuilder = new IntermediateCodeBuilder(scope);
		intermediateCodeBuilder.addQuadruple("PRINCIPAL");
		for (int i = 0; i < scope.getSymbolTable().getSymbols().size(); i++) {
			symbol = scope.getSymbolTable().getSymbols().get(i);
			if (symbol instanceof SymbolVariable) {
				Variable variable = new Variable(symbol.getName(), symbol.getScope());
				intermediateCodeBuilder.addQuadruple("VARLOCAL", variable, 0);
			}
		}

		for (ScopeIF tempScope: listScopeHijos) {
			for (int i = 0; i < tempScope.getSymbolTable().getSymbols().size(); i++) {
				symbol = tempScope.getSymbolTable().getSymbols().get(i);
				if (symbol instanceof SymbolVariable) {
					Variable variable = new Variable(symbol.getName(), symbol.getScope());
					intermediateCodeBuilder.addQuadruple("VARLOCAL", variable, 0);
				}
			}
		}

		Funcion fp = new Funcion();

		// Añadir listado de sentencias
		Sentencia lt = (Sentencia) listSent;

		intermediateCodeBuilder.addQuadruples(lt.getIntermediateCode());

		fp.setIntermediateCode(intermediateCodeBuilder.create());

		System.out.println("     QUAD>" + fp.getIntermediateCode());

		RESULT = fp; :}
